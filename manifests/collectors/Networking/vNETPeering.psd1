            # loop 4 is nested inside this one and never ran.
            EmitNullWhenEmpty = $true
            Preamble = ''
        }
        @{
            Variable = '4'
            Source = '$data.virtualNetworkPeerings'
            # AB#6845 -- DELIBERATELY NOT GUARDED. Unlike every other loop fixed under this bug,
