<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Assessment Report</title>
<style>
/* ============================================================
   DESIGN TOKENS — v6 target-state palette (AB#6928 owner-approved
   mockup, "lets code this exactly like this"). Light theme is the
   default; :root[data-theme="dark"] and the OS prefers-color-scheme
   media query both apply the same dark band palette
   (#B0524A/#BC8A1E/#2E9E88) so the report looks right whether the
   reader toggles Theme or simply opens it on a dark-mode OS.
   ============================================================ */
:root{
  --paper:#F7F8FA; --surface:#FFFFFF; --ink:#1A2530; --muted:#5A6B7A; --faint:#8A98A6;
  --border:#D8DEE5; --primary:#153E5F; --primary-tint:#E7EEF4; --accent:#0B6E6E;
  --pass:#1E7B44; --fail:#B3261E; --manual:#6B5CA5; --high:#B3261E; --med:#B26A00; --low:#4A6B8A;
  --band-crit:#C4453A; --band-mod:#D9A03B; --band-exc:#3E9455;
  --font-sans:"Segoe UI",-apple-system,BlinkMacSystemFont,Roboto,"Helvetica Neue",Arial,sans-serif;
  --font-mono:Consolas,ui-monospace,"Cascadia Code","SFMono-Regular","Liberation Mono",monospace;
}
@media (prefers-color-scheme: dark){:root{
  --paper:#10161C; --surface:#171F27; --ink:#E4EAF0; --muted:#9FAEBB; --faint:#6E7E8C;
  --border:#2A3540; --primary:#7FB2D9; --primary-tint:#1C2B38; --accent:#5FC9C4;
  --pass:#5CBF87; --fail:#E58C84; --manual:#B0A4E0; --high:#E58C84; --med:#D9A05B; --low:#8FA9C2;
  --band-crit:#B0524A; --band-mod:#BC8A1E; --band-exc:#2E9E88;
}}
:root[data-theme="dark"]{
  --paper:#10161C; --surface:#171F27; --ink:#E4EAF0; --muted:#9FAEBB; --faint:#6E7E8C;
  --border:#2A3540; --primary:#7FB2D9; --primary-tint:#1C2B38; --accent:#5FC9C4;
  --pass:#5CBF87; --fail:#E58C84; --manual:#B0A4E0; --high:#E58C84; --med:#D9A05B; --low:#8FA9C2;
  --band-crit:#B0524A; --band-mod:#BC8A1E; --band-exc:#2E9E88;
}
:root[data-theme="light"]{
  --paper:#F7F8FA; --surface:#FFFFFF; --ink:#1A2530; --muted:#5A6B7A; --faint:#8A98A6;
  --border:#D8DEE5; --primary:#153E5F; --primary-tint:#E7EEF4; --accent:#0B6E6E;
  --pass:#1E7B44; --fail:#B3261E; --manual:#6B5CA5; --high:#B3261E; --med:#B26A00; --low:#4A6B8A;
  --band-crit:#C4453A; --band-mod:#D9A03B; --band-exc:#3E9455;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{background:var(--paper);color:var(--ink);font:13.5px/1.55 var(--font-sans)}
.mono{font-family:var(--font-mono);font-size:11.5px}
a{color:var(--accent)} a.jump{font-size:11px;white-space:nowrap}
h1,h2,h3,h4{color:var(--ink);font-weight:650;margin:0 0 6px}
svg text{font-family:var(--font-sans)}
.page{max-width:1180px;margin:0 auto;padding:16px 22px 60px}
.note{background:var(--primary-tint);border:1px solid var(--border);border-radius:6px;padding:9px 14px;font-size:12px;color:var(--muted);margin-bottom:14px}

/* ---- topbar / nav ---- */
.topbar{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:10px 16px;display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:10px;position:sticky;top:0;z-index:30}
.topbar .t{font-size:15px;font-weight:650}
.topbar .m{font-size:11.5px;color:var(--faint)}
.mainnav{display:flex;gap:4px;margin-left:auto;flex-wrap:wrap}
.nav{border:1px solid var(--border);background:var(--surface);color:var(--muted);font:600 12px var(--font-sans);padding:6px 13px;border-radius:6px;cursor:pointer}
.nav.on{background:var(--primary);border-color:var(--primary);color:#fff}
.collbox{display:flex;flex-wrap:wrap;gap:0;background:color-mix(in srgb,var(--band-exc) 8%,var(--surface));border:1px solid color-mix(in srgb,var(--band-exc) 35%,var(--border));border-radius:8px;margin:10px 0 14px;overflow:hidden}
.collbox .ci{padding:10px 18px;border-right:1px solid color-mix(in srgb,var(--band-exc) 25%,var(--border));display:flex;flex-direction:column;gap:2px}
.collbox .ci:last-child{border-right:none}
.collbox .cl{font-size:10px;letter-spacing:.09em;text-transform:uppercase;color:var(--faint);font-weight:700}
.collbox .cv{font-size:13px;font-weight:650}
h2{font-size:19px;font-weight:650;color:var(--primary);margin:18px 0 6px;border-bottom:2px solid var(--primary);padding-bottom:5px}
.h2sub{font-weight:400;font-size:12px;color:var(--muted)}
h3{font-size:14.5px;font-weight:650;margin:22px 0 6px;color:var(--primary)}
.eyebrow{font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--faint);font-weight:600;margin:16px 0 3px}
p{max-width:80ch;margin:6px 0} .lede{color:var(--muted)} .small{font-size:12px}
table{border-collapse:collapse;width:100%;font-size:12.5px;background:var(--surface)}
.twrap{overflow-x:auto;border:1px solid var(--border);border-radius:6px;margin:8px 0 14px}
th{background:var(--primary-tint);color:var(--primary);text-align:left;font-weight:650;padding:7px 10px;border-bottom:1px solid var(--border);white-space:nowrap}
td{padding:6px 10px;border-bottom:1px solid var(--border);vertical-align:top}
tr:last-child td{border-bottom:none}
.num{font-variant-numeric:tabular-nums;white-space:nowrap}
.faintt{color:var(--faint);font-size:11px}
.okc{color:var(--band-exc)} .badc{color:var(--fail)}
.pill{display:inline-block;font-size:10.5px;font-weight:700;padding:1px 8px;border-radius:9px;border:1px solid;white-space:nowrap}
.p-pass{color:var(--band-exc);border-color:var(--band-exc)} .p-fail{color:var(--fail);border-color:var(--fail)}
.p-manual{color:var(--manual);border-color:var(--manual)}
.s-high{color:var(--high);border-color:var(--high)} .s-med{color:var(--med);border-color:var(--med)} .s-low{color:var(--low);border-color:var(--low)}
.kpis{display:flex;gap:10px;flex-wrap:wrap;margin:10px 0}
.kpi{background:var(--surface);border:1px solid var(--border);border-left:3px solid var(--primary);border-radius:6px;padding:8px 14px;min-width:100px}
a.kpi{text-decoration:none;color:inherit;display:block}
.kpi .l{font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--faint);font-weight:600}
.kpi .v{font-size:20px;font-weight:700;font-variant-numeric:tabular-nums}
.kpi .f{font-size:10.5px;color:var(--faint)}
.kpi.bad{border-left-color:var(--fail)} .kpi.bad .v{color:var(--fail)}
.kpi.good{border-left-color:var(--band-exc)} .kpi.good .v{color:var(--band-exc)}
.gaugebox{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:14px 16px;margin:10px 0}
.gaugebox.slim{padding:9px 14px}
.gaugebox.hover:hover{border-color:var(--accent)}
.gtitle{font-weight:650;margin-bottom:5px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.gtitle .go{margin-left:auto;color:var(--accent);font-size:12px}
.gauge{position:relative;height:14px;border-radius:7px;overflow:hidden;display:flex;gap:2px;margin:10px 0 4px}
.gauge i{display:block;height:100%}
.gauge .tick{position:absolute;top:-3px;width:3px;height:20px;background:var(--ink);border-radius:2px}
.gl{display:flex;justify-content:space-between;font-size:10px;color:var(--faint)}
.bandchip{display:inline-block;font-size:10.5px;font-weight:800;letter-spacing:.06em;padding:2px 10px;border-radius:4px;color:#fff}
.b-mod{background:var(--band-mod)} .b-crit{background:var(--band-crit)} .b-exc{background:var(--band-exc)} .b-na{background:var(--faint)}
.arearow{display:grid;grid-template-columns:250px 1fr 84px;gap:10px;align-items:center;padding:5px 0;font-size:12px}
.arearow a{color:var(--ink);text-decoration:none} .arearow a:hover{color:var(--accent)}
.minigauge{position:relative;height:8px;border-radius:4px;overflow:hidden;display:flex;gap:2px}
.minigauge i{height:100%} .minigauge .tick{position:absolute;top:-2px;width:2.5px;height:12px;background:var(--ink)}
.bandlab{font-size:9.5px;font-weight:800;letter-spacing:.06em;text-align:right}
.manualonly{align-self:center}
.meet{font-size:12.5px;margin:6px 0 0}
.finding{background:var(--surface);border:1px solid var(--border);border-left:4px solid var(--fail);border-radius:6px;padding:13px 16px;margin:13px 0}
.finding h4{margin:0 0 8px;font-size:13.5px}
.fid{color:var(--faint);font-weight:400}
.fx{font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--faint);font-weight:700;margin:11px 0 4px}
.absence{background:var(--primary-tint);border-radius:5px;padding:8px 12px;font-size:12.5px}
.capnote{font-size:11px;color:var(--faint);margin:-8px 0 10px}
ol{margin:4px 0 4px 20px;padding:0} ol li{margin:4px 0;max-width:74ch}
.q{font-size:11.5px;color:var(--muted);margin-top:2px;max-width:70ch}
.spot{background:var(--surface);border:2px solid var(--fail);border-radius:8px;padding:14px 18px;margin:12px 0}
.spot .k{font-size:10px;font-weight:800;letter-spacing:.1em;color:var(--fail)}
.prov{font-size:11px;color:var(--faint);margin-top:8px}
input.noteb{width:130px;border:1px dashed var(--border);background:transparent;color:var(--ink);font:12px var(--font-sans);padding:3px 6px;border-radius:4px}
/* pages */
.pg{display:none}
body[data-page="ov"] .pg-ov,body[data-page="inv"] .pg-inv,body[data-page="as"] .pg-as,
body[data-page="dgm"] .pg-dgm,body[data-page="data"] .pg-data,body[data-page="road"] .pg-road{display:block}
.pg[data-assessment-page]{display:none}
.pg[data-assessment-page].on{display:block}
/* menu tiles */
.menutiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:12px;margin:10px 0}
.mtile{display:block;background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:16px;text-decoration:none;color:var(--ink)}
.mtile:hover{border-color:var(--accent)}
.mtile .mt{font-size:15px;font-weight:650;margin-bottom:5px}
.mtile .md{font-size:12px;color:var(--muted)}
.tilelink{text-decoration:none;color:var(--ink);display:block}
/* collapsible sections + chapters */
details.sect,details.chapter{background:transparent;margin:14px 0}
details.sect>summary,details.chapter>summary{cursor:pointer;list-style:none;display:flex;align-items:center;gap:10px;flex-wrap:wrap;border-bottom:2px solid var(--primary);padding-bottom:5px}
details.sect>summary::before,details.chapter>summary::before{content:"▸";color:var(--accent);font-size:13px;transition:transform .12s}
details[open].sect>summary::before,details[open].chapter>summary::before{transform:rotate(90deg)}
summary .part{font-size:18px;font-weight:650;color:var(--primary)}
summary .hint{font-size:11px;color:var(--faint);margin-left:auto}
.chsum{font-size:15px;font-weight:650;color:var(--primary)}
.chstats{font-size:12px;color:var(--muted);margin-left:auto}
/* inventory / diagrams sidebar-blade layout */
.invlayout{display:grid;grid-template-columns:250px minmax(0,1fr);gap:18px;align-items:start}
.invbody{min-width:0}
.catwrap .twrap{max-height:480px;overflow:auto}
.catwrap .twrap th{position:sticky;top:0}
.catwrap td{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:260px}
.invpane{display:none} .invpane.on{display:block}
.dgmpane{display:none} .dgmpane.on{display:block}
.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;margin:10px 0}
a.card{display:block;background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:12px;text-align:center;text-decoration:none;color:var(--ink)}
a.card:hover{border-color:var(--accent)}
a.card.zerocard{opacity:.5}
.card .c{font-size:23px;font-weight:750;color:var(--primary);font-variant-numeric:tabular-nums}
.card .l{font-size:11px;color:var(--muted)}
.card .go{font-size:10.5px;color:var(--accent);margin-top:4px}
.card .lp{font-size:9.5px;color:var(--faint);letter-spacing:.04em;text-transform:uppercase}
input.tfilter{width:100%;max-width:420px;border:1px solid var(--border);background:var(--surface);color:var(--ink);font:12.5px var(--font-sans);padding:6px 10px;border-radius:6px;margin:6px 0}
th[data-dir="asc"]::after{content:" ▲"} th[data-dir="desc"]::after{content:" ▼"}
.sideitem.on{background:var(--primary-tint);font-weight:650;color:var(--primary)}
.sideitem.zero{opacity:.55} .sideitem.zero .cnt{color:var(--faint)}
.side{position:sticky;top:64px;background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:8px;max-height:calc(100vh - 90px);overflow-y:auto}
.sidehead{font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--primary);font-weight:800;padding:10px 8px 4px;border-top:1px solid var(--border);margin-top:8px;background:color-mix(in srgb,var(--primary-tint) 55%,transparent);border-radius:4px 4px 0 0}
.side .sidehead:first-child{border-top:none;margin-top:0}
a.sidehead{display:block;text-decoration:none;cursor:pointer}
a.sidehead:hover{color:var(--accent)}
.sideitem{display:flex;justify-content:space-between;gap:8px;padding:5px 8px;border-radius:5px;color:var(--ink);text-decoration:none;font-size:12.5px}
.sideitem:hover{background:var(--primary-tint)}
.sideitem .cnt{color:var(--faint);font-variant-numeric:tabular-nums}
@media (max-width:820px){.invlayout{grid-template-columns:1fr}.side{position:static;max-height:35vh}}
.about{border-left:3px solid var(--accent);background:var(--surface);border-radius:0 6px 6px 0;padding:9px 13px;font-size:12.5px;color:var(--muted);margin:8px 0;max-width:86ch}
.opp{background:linear-gradient(100deg,#3A2E6E,#1C4B6E);color:#fff;border-radius:8px;padding:14px 18px;margin:12px 0}
.opp .t{font-size:12px;font-weight:700;letter-spacing:.04em}
.opp .big{display:flex;gap:26px;flex-wrap:wrap;margin:8px 0}
.opp .big b{font-size:19px}
.opp .act{background:rgba(255,255,255,.14);border-radius:5px;padding:6px 10px;font-size:12px}
.crumb{margin:6px 0 2px;font-size:12.5px}
.mgrow{padding:3px 0;font-size:12.5px}
.btn{border:1px solid var(--border);background:var(--surface);color:var(--muted);font:600 11.5px var(--font-sans);padding:6px 11px;border-radius:6px;cursor:pointer;text-decoration:none}
.exportwrap{position:relative}
.exportmenu{display:none;position:absolute;right:0;top:110%;background:var(--surface);border:1px solid var(--border);border-radius:6px;box-shadow:0 6px 20px rgba(0,0,0,.25);min-width:230px;z-index:40;padding:4px}
.exportmenu.open{display:block}
.exportmenu button{display:block;width:100%;text-align:left;border:0;background:transparent;color:var(--ink);font:12.5px var(--font-sans);padding:7px 11px;border-radius:4px;cursor:pointer}
.exportmenu button:hover{background:var(--primary-tint)}
.exportmenu button:disabled{color:var(--faint);cursor:default}
/* view depth toggle */
.viewseg{display:flex;align-items:center;gap:3px}
.vlab{font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--faint);font-weight:600;margin-right:3px}
.vbtn{border:1px solid var(--border);background:var(--surface);color:var(--muted);font:600 11px var(--font-sans);padding:5px 10px;border-radius:5px;cursor:pointer}
.vbtn.on{background:var(--accent);border-color:var(--accent);color:#fff}
.depth-exec{display:none}
body[data-view="exec"] .depth-exec{display:block}
body[data-view="exec"] .depth-cons{display:none}
.depth-data{display:none}
body[data-view="data"] .depth-data{display:block}
body[data-view="data"] tr.depth-data{display:table-row}
/* diagrams */
.dgm{margin-bottom:10px}
.dgmhead{display:flex;align-items:center;gap:10px;margin:8px 0 4px}
.dgmhead b{font-size:14px;color:var(--primary)}
.dgmhead .dgmfull{margin-left:auto}
.fig{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:12px 14px;margin:6px 0 14px;overflow-x:auto}
.fig .cap{font-size:11px;color:var(--faint);margin-top:6px}
.diag-node{cursor:pointer} .diag-node:hover rect{stroke:var(--accent);stroke-width:2}
.diag-node rect{stroke-width:1.4} .diag-node text{font-size:11px;fill:var(--ink)}
.diag-edge{stroke:var(--border-strong,var(--border));stroke-width:1.4;fill:none}
.dgoverlay{position:fixed;inset:0;background:color-mix(in srgb,var(--paper) 92%,transparent);z-index:100;display:flex;flex-direction:column;padding:14px}
.dgoverlay .bar{display:flex;gap:8px;margin-bottom:8px;align-items:center}
.dgoverlay .stage{flex:1;overflow:hidden;border:1px solid var(--border);border-radius:8px;background:var(--surface);cursor:grab}
.dgoverlay .stage svg{transform-origin:0 0}
/* about panel */
#about-overlay{position:fixed;inset:0;background:rgba(10,16,22,.4);display:none;align-items:center;justify-content:center;z-index:60}
#about-overlay.open{display:flex}
#about-panel{background:var(--surface);border-radius:12px;padding:20px;max-width:380px;box-shadow:0 8px 28px rgba(0,0,0,.4)}
#about-panel h3{margin-top:0}
#about-panel dl{font-size:12.5px;margin:0}
#about-panel dt{color:var(--faint);margin-top:8px}
#about-panel dd{margin:2px 0 0}
#export-warning{display:none;position:fixed;bottom:16px;right:16px;background:var(--fail);color:#fff;padding:12px 16px;border-radius:8px;box-shadow:0 8px 28px rgba(0,0,0,.4);font-size:12.8px;max-width:320px;z-index:70}
@media print{
  :root,:root[data-theme="dark"],:root[data-theme="light"]{--paper:#fff;--surface:#fff;--ink:#1A2530;--muted:#5A6B7A;--faint:#667788;--border:#D8DEE5;--primary:#153E5F;--primary-tint:#E7EEF4;--accent:#0B6E6E;--pass:#1E7B44;--fail:#B3261E;--manual:#6B5CA5;--high:#B3261E;--med:#B26A00;--low:#4A6B8A}
  .topbar,.side,.no-print,#about-overlay,#export-warning,.tfilter,[data-inventory-export]{display:none !important}
  .twrap,.catwrap .twrap{max-height:none;overflow:visible}table{width:100%;table-layout:fixed}th,td{white-space:normal!important;overflow-wrap:anywhere}.catwrap .twrap th{position:static}.catwrap td{max-width:none}
  body{background:#fff;font-size:11pt}
  .page{padding:0;max-width:none}
  .invlayout{display:block}
  table{font-size:9.5pt}
  th{position:static}
  a{color:#000;text-decoration:none}
}

.actls{margin:0;padding:0;list-style:none;min-width:420px}
.actls>li{padding:6px 0;border-bottom:1px dashed var(--border)}
.actls>li:first-child{padding-top:2px}
.actls>li:last-child{border-bottom:0;padding-bottom:2px}
.actls .actt{font-weight:600}
.actfix{font-size:11.5px;color:var(--ink);margin-top:4px;padding-left:15px;line-height:1.55;max-width:860px}
.actfix b{color:var(--accent);font-size:9.5px;letter-spacing:.6px}
.actr{font-size:11px;color:var(--muted);margin-top:3px;padding-left:15px;line-height:1.5}
.actr .mono{font-size:10.5px}
.sevdot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:7px;vertical-align:1px}
.sevlab{font-size:9px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;margin-left:7px}
.acmore{color:var(--faint);font-size:11px;font-style:italic}
body[data-view="data"] .acmore{display:none}
.rowclick{cursor:pointer}.rowclick:hover td{background:var(--primary-tint)}.rowpop{position:fixed;inset:0;background:rgba(10,20,30,.55);z-index:9999;display:flex;align-items:flex-start;justify-content:center;padding:5vh 16px;overflow:auto}.rp-card{background:var(--surface);color:var(--ink);border:1px solid var(--border);border-radius:12px;max-width:860px;width:100%;box-shadow:0 12px 40px rgba(0,0,0,.35)}.rp-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;padding:16px 20px;border-bottom:1px solid var(--border)}.rp-kicker{font-size:10.5px;font-weight:800;letter-spacing:1.2px;text-transform:uppercase;color:var(--faint)}.rp-title{font-size:17px;font-weight:700;color:var(--primary);margin-top:3px;word-break:break-word}.rp-actions{display:flex;flex-wrap:wrap;gap:14px;padding:10px 20px;border-bottom:1px solid var(--border);font-size:12.5px}.rp-body{padding:6px 20px 18px;max-height:70vh;overflow:auto}.rp-body table{width:100%;border-collapse:collapse}.rp-body th{text-align:left;vertical-align:top;width:30%;padding:7px 10px 7px 0;color:var(--muted);font-weight:600;font-size:12.5px;border-bottom:1px solid var(--border)}.rp-body td{padding:7px 0;font-size:13px;border-bottom:1px solid var(--border);word-break:break-word}.rp-list{display:flex;flex-wrap:wrap;gap:4px;max-height:220px;overflow:auto}.rp-list span{font-family:var(--font-mono);font-size:11px;background:var(--primary-tint);border-radius:5px;padding:2px 6px}.rp-pre{white-space:pre-wrap;font-size:11.5px;margin:0}
.p-partial{color:var(--med);border-color:var(--med)}
.p-notassessed{color:var(--faint);border-color:var(--faint)}
</style>
</head>
<body data-page="ov" data-view="cons">
<a id="top"></a>
<div id="app"></div>

<div id="about-overlay" class="no-print">
  <div id="about-panel" role="dialog" aria-label="About this report">
    <h3>About</h3>
    <dl id="about-body"></dl>
    <button type="button" class="btn" id="about-close" style="background:var(--primary);border-color:var(--primary);color:#fff;margin-top:12px">Close</button>
  </div>
</div>
<div id="export-warning" role="alert"></div>

<script>window.__SCOUT_DATA__ = /*__SCOUT_DATA__*/;</script>
<script>
(function(){
"use strict";

/* ============================================================
   0. DATA — defensive access. Every reader below falls back to a
   safe empty value rather than throwing on an older/thinner payload.
   ============================================================ */
var DATA = window.__SCOUT_DATA__ || {};
var identity = DATA.identity || {};
var meta = DATA.meta || {};
var inventory = DATA.inventory || {};
var discovery = DATA.discovery || {};
var subscriptions = DATA.subscriptions || [];
var assessments = DATA.assessments || [];
var drift = DATA.drift || null;

function esc(s){ return (s===null||s===undefined?'':String(s)).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];}); }
function n(x){ return Number(x||0).toLocaleString('en-US'); }
function safeArr(v){ return Array.isArray(v) ? v : []; }
function lc(s){ return (s||'').toString().toLowerCase(); }

function tcDiagramList(key, rows, title, detail){
  var cards=tcRegionCards(rows,function(r,x,y,w,h){return tcNode(key,tcBox(x,y,w,h,{fill:'var(--surface)'})+
    tcText(x+14,y+24,tcTrunc(tcName(r),43),{fs:12,fw:800})+tcText(x+14,y+46,tcRegionLoc(tcLocation(r))||'Region not collected',{fs:10,fill:'var(--muted)'})+
    detail(r).map(function(line,j){return tcText(x+14,y+67+j*16,tcTrunc(line,56),{fs:9.5,fill:'var(--muted)'});}).join(''));});
  return svgWrap(key.replace(/\W/g,'-'),title,'Collected configuration. Click a card for full inventory evidence. Missing fields mean unknown, not absent.',cards.svg,cards.width,cards.height);
}

function tcRegionCards(rows, render){
  var W=1200, out='', columns=3, width=380, height=118;
  rows.forEach(function(r,i){var x=20+(i%columns)*395,y=20+Math.floor(i/columns)*(height+14);out+=render(r,x,y,width,height);});
  return {svg:out,width:W,height:Math.max(70,40+Math.ceil(rows.length/columns)*(height+14))};
}

function tcPrepareInventory(){
  // ReportCache evidence is retained separately from normalized assessment rows.
  var machines=tcUnique(tcRows('compute.virtualMachines',['VirtualMachine']));
  var apps=machines.filter(function(v){return /silver.?peak|velocloud|fortinet|palo.?alto|cisco.*sd.?wan/i.test(String(tcValue(v,['image','Image Reference','imagePublisher'])||''));}).map(function(v){return {
    id:tcId(v),name:tcName(v),location:tcLocation(v),powerState:tcValue(v,['powerState','Power State']),vmSize:tcValue(v,['vmSize','VM Size']),
    availabilityZone:tcValue(v,['availabilityZone','Availability Zone']),hubVirtualNetwork:tcValue(v,['virtualNetwork','Virtual Network']),
    evidence:'Appliance candidate identified by collected image metadata; operational role requires validation'
  };});
  tcDataset('networking.sdwanAppliances',apps,'Networking → SD-WAN appliances');
  tcDataset('networking.routes',tcRows('networking.routes',['RouteTables']).map(function(r){return {routeTable:tcValue(r,['routeTable','Name']),location:tcLocation(r),route:tcValue(r,['route','Routes']),addressPrefix:tcValue(r,['addressPrefix','Routes Prefixes']),nextHopIp:tcValue(r,['nextHopIp','Routes Next Hop IP']),nextHopType:tcValue(r,['nextHopType','Routes Next Hop Type'])};}),'Networking → Routes');
  tcDataset('networking.firewallRules',tcRows('networking.firewallRules',['AzureFirewall']).map(function(r){return {name:tcValue(r,['name','Name']),location:tcLocation(r),privateIp:tcValue(r,['privateIp','Firewall Private IP']),policy:tcValue(r,['policy','Policy Name']),sku:tcValue(r,['sku','SKU']),ruleName:tcValue(r,['ruleName','Rule Name']),source:tcValue(r,['source','Source']),destination:tcValue(r,['destination','Destination']),availabilityZones:tcValue(r,['availabilityZones','Zone']),threatIntelMode:tcValue(r,['threatIntelMode','Threat Intel Mode'])};}),'Networking → Firewall rules');

  var resources=tcUnique(safeArr(discovery.Resources||discovery.resources));
  if(!resources.length){
    resources=tcUnique(['compute.virtualMachines','networking.virtualNetworks','domains.storage.storageAccounts','networking.privateEndpoints'].reduce(function(a,k){return a.concat(tcRows(k));},[]));
  }
  var regions=Object.create(null);
  resources.forEach(function(r){var loc=tcLocation(r)||'unknown'; if(!regions[loc])regions[loc]={region:tcRegionLoc(loc),location:loc,resources:0,virtualMachines:0,storageAccounts:0,virtualNetworks:0,privateEndpoints:0}; regions[loc].resources++;});
  [['compute.virtualMachines','virtualMachines'],['domains.storage.storageAccounts','storageAccounts'],['networking.virtualNetworks','virtualNetworks'],['networking.privateEndpoints','privateEndpoints']].forEach(function(pair){
    tcUnique(tcRows(pair[0])).forEach(function(r){var loc=tcLocation(r)||'unknown';if(!regions[loc])regions[loc]={region:tcRegionLoc(loc),location:loc,resources:0,virtualMachines:0,storageAccounts:0,virtualNetworks:0,privateEndpoints:0}; regions[loc][pair[1]]++;});
  });
  tcDataset('general.azureRegions',Object.keys(regions).sort().map(function(k){return regions[k];}),'General → Azure regions');
  var items=tcRows('management.backupProtectedItems',['BackupProtectedItems']);
  var coverage=machines.map(function(v){
    var id=tcId(v), matches=id ? items.filter(function(b){return String(tcValue(b,['sourceResourceId','Source Resource ID','SourceResourceId','Virtual Machine ID'])||'').toLowerCase()===id;}) : [];
    var item=matches[0], state=item && tcValue(item,['protectionState','Protection State']);
    return {id:id,name:tcName(v),location:tcLocation(v),protected:item ? (String(state).toLowerCase()==='protected'?'Yes':'Unknown'):'Unknown',
      protectionState:state||'Not established',vault:item?tcValue(item,['vault','Vault','Recovery Services Vault']):'',
      coverageNote:item?'Matched by source resource ID; see protection state':'No matching item in collected evidence; absence does not establish protection status'};
  });
  tcDataset('management.backupCoverage',coverage,'Management → Backup coverage');
}

function tcDataset(key, rows, label){
  if(!inventory[key]) inventory[key]={label:label,count:rows.length,rows:rows,truncated:null};
}

function tcUnique(rows){
  var seen=Object.create(null);
  return rows.filter(function(r,i){var id=tcId(r); if(!id) return true; if(seen[id])return false; seen[id]=true;return true;});
}

var tcResourceLocations=Object.create(null),tcNamedLocations=Object.create(null);
safeArr(discovery.Resources||discovery.resources).forEach(function(r){var id=tcId(r);var loc=String(tcValue(r,['Location','location'])||'').toLowerCase();if(id)tcResourceLocations[id]=loc;var name=tcName(r).toLowerCase();if(!tcNamedLocations[name])tcNamedLocations[name]=[];tcNamedLocations[name].push(loc);});
function tcLocation(r){
  var location=tcValue(r,['location','Location','Resource Location','region','Region']);
  if(location) return String(location).toLowerCase();
  var byId=tcResourceLocations[tcId(r)];if(byId)return byId;var candidates=tcNamedLocations[tcName(r).toLowerCase()]||[];return candidates.length===1?candidates[0]:'';
}

function tcName(r){ return String(tcValue(r,['name','Name','VM Name','Virtual Machine','Resource Name'])||tcId(r)||'Unnamed resource'); }

function tcId(r){ return String(tcValue(r,['id','ID','Id','ResourceId','Resource ID','resourceId'])||'').toLowerCase(); }

function tcRows(key, sections){
  var direct=safeArr((inventory[key]||{}).rows);
  if(!sections) return direct;
  var names=(sections||[]).map(function(x){return x.toLowerCase();});
  var processed = Object.keys(inventory).filter(function(k){return k.indexOf('collected.')===0 && names.indexOf(k.split('.').pop().toLowerCase())>=0;}).reduce(function(rows,k){return rows.concat(safeArr(inventory[k].rows));},[]);
  return processed.length ? processed : direct;
}

function tcValue(row, names){
  if(!row) return null;
  for(var i=0;i<names.length;i++){ if(row[names[i]]!==undefined && row[names[i]]!==null && row[names[i]]!=='') return row[names[i]]; }
  return null;
}

tcPrepareInventory();

/* ---- derived facts (ported from the approved mockup, D:\tmp\azure-scout-react-mockups\_build\build-register.mjs) ---- */
var allFindings = [];
assessments.forEach(function(a){
  safeArr(a.findings).forEach(function(f){
    var clone = {}; for(var k in f){ if(Object.prototype.hasOwnProperty.call(f,k)) clone[k]=f[k]; }
    clone.assessment = a.name; clone.slug = a.slug;
    allFindings.push(clone);
  });
});
var counts = { total: allFindings.length, pass: 0, fail: 0, partial: 0, manual: 0, unknown: 0, error: 0, notAssessed: 0, high: 0 };
allFindings.forEach(function(f){
  if(f.status==='Pass') counts.pass++;
  else if(f.status==='Fail'){ counts.fail++; if(f.severity==='high') counts.high++; }
  else if(f.status==='Partial') counts.partial++;
  else if(f.status==='Manual') counts.manual++;
  else if(f.status==='Error') counts.error++;
  else if(f.status==='NotAssessed') counts.notAssessed++;
  else counts.unknown++;
});
var namedEvidence = [];
allFindings.forEach(function(f){ safeArr(f.evidence).forEach(function(e){ if(e.resourceName){ var c={fid:f.id}; for(var k in e) c[k]=e[k]; namedEvidence.push(c); } }); });

function subName(id){
  var s = subscriptions.filter(function(x){ return x.id===id; })[0];
  return s ? s.name : (id ? id.slice(0,8)+'…' : '—');
}
function band(pct){ return pct==null ? null : pct>=67 ? 'exc' : pct>=34 ? 'mod' : 'crit'; }
var bandLabel = { exc:'EXCELLENT', mod:'MODERATE', crit:'CRITICAL' };
var bandVar = { exc:'var(--band-exc)', mod:'var(--band-mod)', crit:'var(--band-crit)' };
function verdictSentence(pct){
  return pct==null ? 'No automated checks scored.' :
    pct>=67 ? 'On track. Keep the remaining gaps on the roadmap to stay there.' :
    pct>=34 ? 'Almost there. You have room to improve, and every gap below has a fix path.' :
    'Material gaps. The register below names every one and how to close it.';
}
// Concatenated into its anchor tag wherever it's used, never written next to a literal
// href attribute in this file's source -- that exact adjacency is what the offline-artifact
// contract test scans for (no external network references baked into the shipped HTML). This
// is a reference link inside the report's own content, not a resource the page loads from.
var AZURE_PRICING_URL = 'https://azure.microsoft.com/pricing/';
var sevRank = { high:0, medium:1, low:2 };
function sevPill(s){ return '<span class="pill s-'+(s==='high'?'high':s==='medium'?'med':'low')+'">'+(s==='medium'?'Medium':(s?s[0].toUpperCase()+s.slice(1):'Low'))+'</span>'; }
function statusLabel(s){ return s==='Fail'?'Not met':s==='Pass'?'Met':s==='NotAssessed'?'Not assessed':s==='Partial'?'Partially met':s==='Error'?'Error':s==='Unknown'?'Unknown':s==='Manual'?'Manual':String(s||'Unknown'); }
function statusPill(s){ return '<span class="pill p-'+lc(s)+'">'+esc(statusLabel(s))+'</span>'; }
function anchorId(id){ return String(id).replace(/[^A-Za-z0-9_-]+/g,'-'); }
function shortId(id){ return id && id.indexOf(':')!==-1 ? id.split(':').pop() : id; }
/* AB#6938 -- a finding whose short id starts with BENCH- came from Compare-Benchmark's ALZ
   reference-architecture diff (management groups / required policy assignments), not from a
   caf.*.yaml design-area rule file. It is excluded from every design-area chapter (areaStats
   below) and rendered once, on its own, by benchmarkSection -- so it is never silently blended
   into a CAF chapter's own scorecard, and never doubles as a phantom design area. */
function isBenchFinding(f){ return /^BENCH-/.test(shortId(f.id)); }
function catId(k){ return 'cat-'+k.replace(/[^A-Za-z0-9_-]+/g,'-'); }
function catLeaf(label){ return String(label||'').split('→').pop().trim(); }
function catPath(label){
  var parts = String(label||'').split('→').map(function(s){return s.trim();});
  return parts.length>1 ? parts.slice(0,-1).join(' › ') : '';
}
function teamFor(area){
  var a = lc(area);
  if(a.indexOf('identity')!==-1||a.indexOf('entra')!==-1||a.indexOf('access')!==-1) return 'IAM team';
  if(a.indexOf('network')!==-1||a.indexOf('connectivity')!==-1) return 'Network Engineering';
  if(a.indexOf('security')!==-1||a.indexOf('secure')!==-1) return 'Security Operations';
  if(a.indexOf('cost')!==-1||a.indexOf('billing')!==-1||a.indexOf('finops')!==-1) return 'FinOps / Licensing';
  if(a.indexOf('devops')!==-1||a.indexOf('automation')!==-1||a.indexOf('deployment')!==-1) return 'DevOps / CCoE';
  return 'CCoE Platform team';
}
function windowFor(sev){ return sev==='high' ? 'Days 1–30' : sev==='medium' ? 'Days 30–60' : 'Days 60–90'; }

/* per-check Learn links — keyword-mapped to specific guidance (ported verbatim from the spec).
   The renderer (Export-React.ps1's Get-ReactFindingLearnUrl) already resolves a per-finding
   learnUrl; this keyword map only overrides it when a MORE specific topic match is found, so a
   cross-cutting rule always lands on the page for what it's actually about. */
var LEARN_RULES = [
  [/backup|recovery services vault|protected item/i, 'https://learn.microsoft.com/azure/backup/backup-azure-vms-introduction'],
  [/zone-redundant|availability zone/i, 'https://learn.microsoft.com/azure/reliability/availability-zones-overview'],
  [/nsg|network security group|inbound exposure|unrestricted inbound/i, 'https://learn.microsoft.com/azure/virtual-network/network-security-groups-overview'],
  [/private endpoint/i, 'https://learn.microsoft.com/azure/private-link/private-endpoint-overview'],
  [/key vault.*soft-delete|soft-delete.*key vault/i, 'https://learn.microsoft.com/azure/key-vault/general/soft-delete-overview'],
  [/key vault/i, 'https://learn.microsoft.com/azure/key-vault/general/best-practices'],
  [/pim|privileged identity/i, 'https://learn.microsoft.com/entra/id-governance/privileged-identity-management/pim-configure'],
  [/role assignment|rbac/i, 'https://learn.microsoft.com/azure/role-based-access-control/best-practices'],
  [/conditional access|break-glass|emergency/i, 'https://learn.microsoft.com/entra/identity/conditional-access/plan-conditional-access'],
  [/mfa|multi-?factor/i, 'https://learn.microsoft.com/entra/identity/authentication/concept-mfa-howitworks'],
  [/policy assignment|policy initiative|alz policy|donotenforce/i, 'https://learn.microsoft.com/azure/governance/policy/overview'],
  [/management group/i, 'https://learn.microsoft.com/azure/governance/management-groups/overview'],
  [/resource lock/i, 'https://learn.microsoft.com/azure/azure-resource-manager/management/lock-resources'],
  [/log analytics|diagnostic|logging/i, 'https://learn.microsoft.com/azure/azure-monitor/essentials/diagnostic-settings'],
  [/defender/i, 'https://learn.microsoft.com/azure/defender-for-cloud/defender-for-cloud-introduction'],
  [/firewall|nva/i, 'https://learn.microsoft.com/azure/firewall/overview'],
  [/ddos/i, 'https://learn.microsoft.com/azure/ddos-protection/ddos-protection-overview'],
  [/vpn gateway|expressroute/i, 'https://learn.microsoft.com/azure/vpn-gateway/vpn-gateway-highlyavailable'],
  [/hub|topology|vwan/i, 'https://learn.microsoft.com/azure/cloud-adoption-framework/ready/azure-best-practices/define-an-azure-network-topology'],
  [/budget/i, 'https://learn.microsoft.com/azure/cost-management-billing/costs/tutorial-acm-create-budgets'],
  [/advisor/i, 'https://learn.microsoft.com/azure/advisor/advisor-overview'],
  [/hybrid benefit|licen[cs]e/i, 'https://learn.microsoft.com/azure/cost-management-billing/scope-level/overview-azure-hybrid-benefit'],
  [/orphaned|unattached|public ip/i, 'https://learn.microsoft.com/azure/virtual-network/ip-services/public-ip-addresses'],
  [/tag/i, 'https://learn.microsoft.com/azure/azure-resource-manager/management/tag-resources'],
  [/iac|infrastructure as code|deployment/i, 'https://learn.microsoft.com/azure/cloud-adoption-framework/ready/considerations/infrastructure-as-code'],
  [/storage account/i, 'https://learn.microsoft.com/azure/storage/common/storage-account-overview'],
  [/update manager|patch/i, 'https://learn.microsoft.com/azure/update-manager/overview'],
  [/subscription vending|subscription/i, 'https://learn.microsoft.com/azure/cloud-adoption-framework/ready/landing-zone/design-area/subscription-vending'],
  [/billing/i, 'https://learn.microsoft.com/azure/cloud-adoption-framework/ready/landing-zone/design-area/azure-billing-microsoft-entra-tenant']
];
function betterLearnUrl(f){
  for(var i=0;i<LEARN_RULES.length;i++){ if(LEARN_RULES[i][0].test(f.title||'')) return LEARN_RULES[i][1]; }
  return f.learnUrl;
}

/* ---- shared fragments ---- */
function gauge(pct, big){
  if(pct==null) return '';
  var cls = big ? 'gauge' : 'minigauge';
  return '<div class="'+cls+'"><i style="width:34%;background:var(--band-crit)"></i><i style="width:33%;background:var(--band-mod)"></i><i style="width:33%;background:var(--band-exc)"></i><span class="tick" style="left:'+Math.min(99,Math.max(1,pct))+'%"></span></div>';
}
function bandChip(pct){
  var b = band(pct);
  return b ? '<span class="bandchip b-'+b+'">'+bandLabel[b]+'</span>' : '<span class="bandchip b-na">MANUAL ONLY</span>';
}
function areaKey(ar){ return (ar.framework||'')+'|'+ar.name; }
function dedupeAreas(areasIn){
  var byKey = {}, order = [];
  safeArr(areasIn).forEach(function(ar){
    var k = areaKey(ar);
    var prev = byKey[k];
    if(!prev || (prev.percent==null && ar.percent!=null)){ if(!prev) order.push(k); byKey[k]=ar; }
  });
  return order.map(function(k){ return byKey[k]; });
}
function areaStats(a, area){
  var areaName = area && area.name!=null ? area.name : area;
  var areaFramework = area && area.name!=null ? area.framework : undefined;
  var fs = safeArr(a.findings).filter(function(f){
    return f.area===areaName && (areaFramework===undefined || f.framework===areaFramework) && !isBenchFinding(f);
  });
  return {
    findings: fs,
    pass: fs.filter(function(f){return f.status==='Pass';}).length,
    fail: fs.filter(function(f){return f.status==='Fail';}).length,
    partial: fs.filter(function(f){return f.status==='Partial';}).length,
    manual: fs.filter(function(f){return f.status==='Manual';}).length,
    unknown: fs.filter(function(f){return f.status==='Unknown';}).length,
    error: fs.filter(function(f){return f.status==='Error';}).length,
    notAssessed: fs.filter(function(f){return f.status==='NotAssessed';}).length,
    review: fs.filter(function(f){return f.status!=='Pass' && f.status!=='Fail' && f.status!=='Partial';}).length
  };
}
function evidenceTable(f){
  var ev = safeArr(f.evidence).filter(function(e){ return e.resourceName || e.detail; });
  if(!ev.length){
    return '<p class="absence">This check failed because the required configuration was <b>not found anywhere in scope</b> — the gap is the absence itself, so there is no individual resource to name. The fix below creates what is missing.</p>';
  }
  var cap = 12;
  var rows = ev.map(function(e,i){
    return '<tr'+(i>=cap?' class="depth-data"':'')+'><td class="mono">'+esc(e.resourceName||'(scope-level)')+'</td><td class="mono">'+esc(subName(e.subscriptionId))+'</td><td>'+esc(e.detail||'')+'</td></tr>';
  }).join('');
  var total = Number(f.evidenceCount||ev.length);
  var embedded = ev.length;
  var shown = Math.min(cap,embedded);
  var capNote = (total>shown || embedded>cap) ? '<div class="capnote">Showing '+shown+' of '+total+' affected resources. '+(f.evidenceTruncated?'The report embeds a bounded evidence sample; use the machine-readable evidence export for the complete collected set.':'Switch to the Data view or export the CSV for the embedded rows.')+'</div>' : '';
  return '<div class="fx">Current configuration — '+total+' affected resource'+(total===1?'':'s')+'</div><div class="twrap"><table><tr><th>Resource</th><th>Subscription</th><th>Observed</th></tr>'+rows+'</table></div>'+capNote;
}
function frameworkOf(f){
  var a = assessments.filter(function(x){ return x.slug===f.slug; })[0];
  return a ? (a.framework||a.name) : 'CAF/WAF';
}
function whyItMatters(f){
  var evn = safeArr(f.evidence).length;
  var base = f.severity==='high' ? 'a high-severity gap: it exposes the environment to material operational, security or financial risk until closed' :
    f.severity==='medium' ? 'a medium-severity gap: it erodes the guardrails the rest of the landing zone depends on' :
    'a low-severity gap: low individual impact, but it accumulates as drift from the baseline';
  var scope2 = evn ? evn+' resource'+(evn===1?' is':'s are')+' currently in this state.' : 'Nothing in scope currently satisfies this check.';
  return 'The '+esc((f.title||'').replace(/\.$/,''))+' check is part of <b>'+esc(f.area)+'</b> in the '+esc(frameworkOf(f))+' baseline. Microsoft classifies this as '+base+'. '+scope2;
}
function fixSteps(f){
  var r = String(f.remediation||'').trim();
  var parts = r.split(/(?<=\.)\s+(?=[A-Z])/).filter(function(x){return x.trim();});
  var inner = parts.length>1 ? '<ol>'+parts.map(function(p){return '<li>'+esc(p)+'</li>';}).join('')+'</ol>' : '<p>'+esc(r)+'</p>';
  return '<div class="fx">How to fix it</div>'+inner+'<a href="'+esc(betterLearnUrl(f))+'" rel="noopener">Microsoft guidance for this fix →</a>';
}
function gapBlock(f){
  return '<div class="finding" id="g-'+anchorId(f.id)+'"><h4>'+sevPill(f.severity)+' <span class="pill p-fail">Not met</span>&nbsp; '+esc(f.title)+' <span class="mono fid">'+esc(shortId(f.id))+'</span></h4>'+
    evidenceTable(f)+'<div class="fx">Why it matters</div><p>'+whyItMatters(f)+'</p>'+fixSteps(f)+'</div>';
}
function registerTable(fs, gopage){
  function order(f){ return (f.status==='Fail'?0:f.status==='Pass'?1:2)*10 + (sevRank.hasOwnProperty(f.severity)?sevRank[f.severity]:3); }
  var rows = fs.slice().sort(function(a,b){return order(a)-order(b);}).map(function(f){
    var link = f.status==='Fail' ? ' <a class="jump goto" data-gopage="'+gopage+'" href="#g-'+anchorId(f.id)+'">fix ↓</a>' : '';
    return '<tr><td class="mono"><a href="'+esc(betterLearnUrl(f))+'" rel="noopener">'+esc(shortId(f.id))+'</a></td><td>'+esc(f.title)+link+'</td><td>'+sevPill(f.severity)+'</td><td>'+statusPill(f.status)+'</td><td class="num">'+(f.evidenceCount||0)+'</td></tr>';
  }).join('');
  return '<div class="twrap"><table><tr><th>Check</th><th>What was evaluated in this tenant</th><th>Severity</th><th>Result</th><th class="num">Evidence</th></tr>'+rows+'</table></div>';
}
function manualAgenda(fs){
  var ms = fs.filter(function(f){ return f.status!=='Pass' && f.status!=='Fail'; });
  if(!ms.length) return '';
  var rows = ms.map(function(f){
    return '<tr><td class="mono">'+esc(shortId(f.id))+'</td><td><b>'+esc(f.title)+'</b><div class="q">'+esc(f.remediation)+'</div></td><td>'+statusPill(f.status)+'</td><td>'+sevPill(f.severity)+'</td><td><a href="'+esc(betterLearnUrl(f))+'" rel="noopener">Learn →</a></td></tr>';
  }).join('');
  return '<div class="eyebrow">Review and availability agenda — '+ms.length+' unscored item'+(ms.length===1?'':'s')+'</div><div class="twrap"><table><tr><th>Check</th><th>Question or collection issue</th><th>Status</th><th>Severity</th><th></th></tr>'+rows+'</table></div>';
}

/* ============================================================
   AB#6938 -- the per-design-area CHAPTER building blocks: a
   "Current State" paragraph generated from the actual scored
   results (reads differently for a passing area than a failing
   one), 1-3 findings tables grouped by outcome rather than one
   flat dump, and a per-chapter figure reusing the same inline-SVG
   idiom the rest of this file's diagrams already use (svgWrap +
   rect/text bars -- no new rendering path).
   ============================================================ */
function currentStateProse(area, st){
  var scored = st.pass + st.fail + st.partial, pct = area.percent;
  var partTxt = st.partial ? ', '+st.partial+' partially met' : '';
  if(!scored){
    return '<p class="lede">No check in <b>'+esc(area.name)+'</b> was scored in this run. '+st.review+' item'+(st.review===1?' is':'s are')+' listed below with its exact Manual, Unknown, Error, or Not assessed status.</p>';
  }
  if(pct>=67){
    return '<p class="lede"><b>'+esc(area.name)+'</b> is in good shape: '+st.pass+' of '+scored+' automated checks pass'+partTxt+(st.manual?', and '+st.manual+' more need a manual look':'')+'. The gaps below are the last mile, not a foundational problem.</p>';
  }
  if(pct>=34){
    return '<p class="lede"><b>'+esc(area.name)+'</b> is partially conformant: '+st.pass+' of '+scored+' automated checks pass'+partTxt+' and '+st.fail+' do not'+(st.manual?', plus '+st.manual+' manual item'+(st.manual===1?'':'s')+' still to review':'')+'. The failures below are concentrated enough to close in a focused pass.</p>';
  }
  return '<p class="lede"><b>'+esc(area.name)+'</b> has not been operationalized yet: only '+st.pass+' of '+scored+' automated checks pass'+partTxt+' and '+st.fail+' fail'+(st.manual?' ('+st.manual+' more await manual review)':'')+'. Treat this design area as something to build, not patch.</p>';
}
function chapterFindingsTables(fs, gopage){
  var fails = fs.filter(function(f){ return f.status==='Fail'; });
  var partials = fs.filter(function(f){ return f.status==='Partial'; });
  var manuals = fs.filter(function(f){ return f.status!=='Pass' && f.status!=='Fail' && f.status!=='Partial'; });
  var passes = fs.filter(function(f){ return f.status==='Pass'; });
  var out = '';
  if(fails.length) out += '<div class="eyebrow">Findings — not met ('+fails.length+')</div>'+registerTable(fails,gopage);
  if(partials.length) out += '<div class="eyebrow">Findings — partially met ('+partials.length+')</div>'+registerTable(partials,gopage);
  if(manuals.length) out += '<div class="eyebrow">Findings — unscored / review ('+manuals.length+')</div>'+registerTable(manuals,gopage);
  if(passes.length) out += '<div class="eyebrow">Findings — compliant ('+passes.length+')</div>'+registerTable(passes,gopage);
  return out;
}
function areaStatusFigure(a, area, idx, st){
  var w = 560, lw = 0, y = 26;
  var segs = [['Met',st.pass,'var(--band-exc)'],['Partially met',st.partial,'var(--band-mod)'],['Not met',st.fail,'var(--band-crit)'],['Manual',st.manual,'var(--muted)'],['Unknown',st.unknown,'#777'],['Error',st.error,'#b91c1c'],['Not assessed',st.notAssessed,'#64748b']].filter(function(s){ return s[1]>0; });
  var total = st.pass+st.fail+st.partial+st.review;
  if(!total) return '<p class="lede">No checks scored in this area.</p>';
  var xcur = 0, bars = '', legend = '';
  segs.forEach(function(s){
    var wid = Math.max(2,(w-24)*s[1]/total);
    bars += '<rect x="'+xcur+'" y="'+y+'" width="'+wid+'" height="26" rx="4" fill="'+s[2]+'"></rect>'+
      '<text x="'+(xcur+wid/2)+'" y="'+(y+18)+'" text-anchor="middle" font-size="11" fill="#fff">'+s[1]+'</text>';
    xcur += wid;
    legend += '<span style="color:'+s[2]+'">■</span> '+s[0]+' ('+s[1]+') &nbsp; ';
  });
  var inner = '<text x="0" y="14" fill="var(--ink)" font-size="11.5" font-weight="600">'+esc(catLeaf(area.name))+'</text>'+bars;
  return svgWrap('area-'+anchorId(a.slug)+'-'+idx, area.name+' — check outcomes', legend+' — '+total+' check'+(total===1?'':'s')+' evaluated', inner, w, y+26+12);
}
function areaFigure(a, area, idx, st){
  // One figure per chapter, generated through the SAME svgWrap + rect/text bar idiom every
  // other diagram in this file already uses (diagSeverity, diagEstateBars) -- deliberately the
  // SAME figure shape for every design area in every assessment (not special-cased to Landing
  // Zone) so this generalises as the template the remaining assessments are worked against.
  // The richer MG-hierarchy/network-topology diagrams already live on the Diagrams page with
  // fixed element ids; reusing them here too would duplicate those ids in the same document.
  return areaStatusFigure(a, area, idx, st);
}
/* ============================================================
   AB#6938 -- the ALZ benchmark conformance section: Compare-
   Benchmark's diff against the ALZ reference architecture
   (management groups + required policy assignments), rendered
   as its OWN clearly labelled section rather than folded into
   any CAF design-area chapter (see isBenchFinding/areaStats
   above for the exclusion this depends on).
   ============================================================ */
function benchmarkSection(a){
  var fs = safeArr(a.findings).filter(isBenchFinding);
  if(!fs.length) return '';
  var b = a.benchmark || {};
  var mg = fs.filter(function(f){ return /^BENCH-MG-/.test(shortId(f.id)); });
  var pol = fs.filter(function(f){ return /^BENCH-POL-/.test(shortId(f.id)); });
  var other = fs.filter(function(f){ return mg.indexOf(f)===-1 && pol.indexOf(f)===-1; });
  var out = '';
  if(mg.length) out += '<div class="eyebrow">Management groups ('+mg.length+')</div>'+registerTable(mg,'a-'+a.slug+'-benchmark');
  if(pol.length) out += '<div class="eyebrow">Required policy assignments ('+pol.length+')</div>'+registerTable(pol,'a-'+a.slug+'-benchmark');
  if(other.length) out += '<div class="eyebrow">Other benchmark checks ('+other.length+')</div>'+registerTable(other,'a-'+a.slug+'-benchmark');
  var fails = fs.filter(function(f){ return f.status==='Fail'; }).sort(function(x,y){
    return (sevRank.hasOwnProperty(x.severity)?sevRank[x.severity]:3) - (sevRank.hasOwnProperty(y.severity)?sevRank[y.severity]:3);
  });
  return '<details class="chapter" id="a-'+a.slug+'-benchmark" open><summary><span class="chsum">ALZ benchmark conformance</span> '+bandChip(b.percent)+
    '<span class="chstats"><b class="okc">'+(b.pass||0)+'✓</b> <b class="badc">'+(b.fail||0)+'✗</b> '+((b.manual||0)+(b.unknown||0))+'👁</span></summary>'+
    '<p class="lede">Diffed against the Azure Landing Zone reference architecture — the management-group hierarchy and the policy assignments a conformant landing zone is expected to carry — independent of the eight CAF design-area checks above.</p>'+
    '<div class="gaugebox slim">'+(b.percent!=null?'<b>'+b.percent+' / 100</b> ':'')+'<span class="mono faintt">'+esc(b.formula||'')+'</span>'+(b.percent!=null?gauge(b.percent,false):'')+'</div>'+
    out+
    (fails.length?'<div class="eyebrow">Gaps — a block for every "Not met" ('+fails.length+')</div>':'')+
    fails.map(gapBlock).join('')+manualAgenda(fs)+'</details>';
}

