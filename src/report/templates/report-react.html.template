  var areas = dedupeAreas(a.areas).map(function(ar){ return { ar:ar, st:areaStats(a,ar) }; }).filter(function(x){ return x.st.fail>0; })
    .sort(function(x,y){ return y.st.fail-x.st.fail; }).slice(0,20);
  if(!areas.length) return '<p class="lede">No gaps in '+esc(a.name)+'.</p>';
  var max = Math.max.apply(null, areas.map(function(x){return x.st.fail;})), rowH = 30, w = 900, lw = 330;
  var out = '';
  areas.forEach(function(x,i){
    var ar = x.ar, st = x.st;
