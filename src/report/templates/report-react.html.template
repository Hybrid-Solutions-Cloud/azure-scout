    apps.forEach(function(a,j){var x=30+(j%4)*290,ay=y+105+Math.floor(j/4)*110,known=!!a.powerState,running=/running/i.test(a.powerState||''),color=known?(running?'var(--band-exc)':'var(--band-crit)'):'var(--faint)';
