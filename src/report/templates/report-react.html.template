      '<text x="146" y="'+(y+22)+'" fill="var(--ink)" font-weight="700" font-size="11.5">'+esc(nsg)+'</text>'+
      '<text x="146" y="'+(y+38)+'" fill="var(--faint)" font-size="10">'+esc(rs[0].resourceGroup)+'</text>';

    rs.slice(0,6).forEach(function(r, i){
      var x = 150 + i*115;
      out += '<rect x="'+x+'" y="'+(y+44)+'" width="106" height="14" rx="3" fill="color-mix(in srgb,var(--band-crit) 16%,transparent)"/>'+
        '<text x="'+(x+6)+'" y="'+(y+55)+'" fill="var(--band-crit)" font-size="9.5" font-weight="600">:'+esc(r.port)+' '+esc(String(r.rule||'').slice(0,14))+'</text>';
    });

    out += '</g>';
    y += 76;
  });

  return svgWrap('exposure', 'Internet exposure — inbound paths from outside',
    rules.length+' NSG rules across '+order.length+' network security groups permit inbound traffic from the internet, with the ports each one opens. Every one should be intentional; this is the estate\'s front door.',
    out, w, y+16);
