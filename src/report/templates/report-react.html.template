      '<text x="638" y="'+(midY-12)+'" text-anchor="middle" fill="var(--ink)" font-weight="700" font-size="11.5">'+esc(g.name)+'</text>'+
      '<text x="638" y="'+(midY+5)+'" text-anchor="middle" fill="var(--muted)" font-size="10.5">'+esc(g.sku)+'</text>'+
      '<text x="638" y="'+(midY+22)+'" text-anchor="middle" fill="var(--faint)" font-size="10">'+esc(g.resourceGroup)+'</text></g>';
  }

  var h = Math.max(oy+40, midY+70);
