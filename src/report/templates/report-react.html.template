function tcDisp(nm){ return String(nm||'').replace(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}-?/i,''); }
function tcRegion(nm){ return ''; }

function tcRegionLoc(loc){
  var s = String(loc||'').toLowerCase();
  if(s==='eastus') return 'East US'; if(s==='westus') return 'West US';
  if(s==='westeurope') return 'West Europe'; if(s==='northeurope') return 'North Europe';
  return loc||'';
}
function tcTrunc(s, max){ s = String(s||''); return s.length>max ? s.slice(0, max-1)+'…' : s; }
function tcChipW(txt, fs){ return Math.round(String(txt).length*fs*0.66)+18; }

