/* ---- v1.3: click any inventory row for a formatted detail pop-up ---- */
var ROWREG = {};
function tcHuman(k){
  var map = {id:'Resource ID', ResourceId:'Resource ID', subscriptionId:'Subscription', resourceGroup:'Resource group', learnMore:'Microsoft guidance', openInPortal:'Open in Azure portal', impactedResources:'Impacted resources', subscriptionNames:'Subscriptions', ShortDescriptionProblem:'Recommendation', ShortDescriptionSolution:'Solution', ImpactedField:'Resource type', ImpactedValue:'Impacted resource'};
  if(map[k]) return map[k];
  var s = String(k).replace(/([a-z0-9])([A-Z])/g,'$1 $2').replace(/[_]+/g,' ');
  return s.charAt(0).toUpperCase()+s.slice(1);
}
function tcRowTitle(r){
  var keys = ['recommendation','ShortDescriptionProblem','name','Name','VM Name','tag','region','Alert Rule Name','Display Name','Subscription Name','displayName','routeTable','Session Host','Workspace Name','key'];
  for(var i=0;i<keys.length;i++){ if(r[keys[i]]) return String(r[keys[i]]); }
  for(var k in r){ if(typeof r[k]==='string' && r[k] && r[k].length<80) return r[k]; }
  return 'Item details';
}
function tcPortalLink(id){ return 'https://portal.azure.com/#@'+(meta.tenantId||'')+'/resource'+id; }
function tcFmtVal(k, v){
  if(v===null || v===undefined || v==='') return '<span class="faintt">—</span>';
  if(typeof v==='object') return '<pre class="rp-pre">'+esc(JSON.stringify(v,null,2))+'</pre>';
  var s = String(v);
  if(/^https?:\/\//.test(s)) return '<a href="'+esc(s)+'" target="_blank" rel="noopener">'+esc(s.replace(/^https?:\/\//,'').slice(0,90))+' ↗</a>';
  if(/^\/subscriptions\/[^/]+(\/|$)/i.test(s)) return '<span class="mono">'+esc(s)+'</span><br><a href="'+esc('https://portal.azure.com/#resource'+s)+'" target="_blank" rel="noopener">Open in Azure portal ↗</a>';
  if(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(s) && subscriptions.some(function(x){ return x.id===s; })) return esc(subName(s))+' <span class="mono faintt">(subscription '+esc(s)+')</span>';
  if(s.length>160 && s.indexOf(', ')>=0){
    var parts = s.split(/,\s|;\s/);
    return '<div class="rp-list">'+parts.map(function(p){ return '<span>'+esc(p)+'</span>'; }).join('')+'</div><div class="faintt small">'+parts.length+' entries</div>';
  }
  if(s.indexOf('; ')>=0 && s.length>60) return s.split('; ').map(esc).join('<br>');
  return esc(s);
}
function showRowPopup(k, i){
  var rows = ROWREG[k] || [], r = rows[i];
  if(!r) return;
  var v = inventory[k] || {};
  var extra = '';
  if(k==='advisor'){
    var cat = String(r.Category||'');
    var slug = {HighAvailability:'reliability',OperationalExcellence:'operational-excellence',Cost:'cost',Performance:'performance',Security:'security'}[cat] || 'reliability';
    extra = '<div class="rp-actions"><a href="#" class="rp-go" data-pane="'+catId('general.advisorRecommendations')+'">See this recommendation across every resource →</a>'+
      '<a href="'+esc('https://learn.microsoft.com/azure/advisor/advisor-reference-'+slug+'-recommendations')+'" target="_blank" rel="noopener">Microsoft guidance ↗</a>'+
      '<a href="'+esc('https://portal.azure.com/#view/Microsoft_Azure_Expert/AdvisorMenuBlade/~/overview')+'" target="_blank" rel="noopener">Open Azure Advisor ↗</a></div>';
  }
  var body = Object.keys(r).filter(function(key){ return !/^(Resource U|ResourceId)$/.test(key); }).map(function(key){
    return '<tr><th>'+esc(tcHuman(key))+'</th><td>'+tcFmtVal(key, r[key])+'</td></tr>';
  }).join('');
  var previousFocus=document.activeElement;
  var ov = document.createElement('div');
  ov.className = 'rowpop no-print';
  ov.innerHTML = '<div class="rp-card" role="dialog" aria-modal="true" aria-label="Inventory item details" tabindex="-1"><div class="rp-head"><div><div class="rp-kicker">'+esc(catLeaf(v.label||k))+'</div><div class="rp-title">'+esc(tcRowTitle(r))+'</div></div><button class="btn rp-close" title="Close (Esc)">✕</button></div>'+
    extra+'<div class="rp-body"><table>'+body+'</table></div></div>';
  document.body.appendChild(ov);
  function close(){ ov.remove(); window.removeEventListener('keydown', onKey); if(previousFocus && previousFocus.focus) previousFocus.focus(); }
  function onKey(e){ if(e.key==='Escape') close(); if(e.key==='Tab'){ var f=Array.from(ov.querySelectorAll('button,a[href],[tabindex="0"]')); var first=f[0],last=f[f.length-1]; if(e.shiftKey && document.activeElement===first){e.preventDefault();last.focus();}else if(!e.shiftKey && document.activeElement===last){e.preventDefault();first.focus();} } }
  window.addEventListener('keydown', onKey);
  ov.querySelector('.rp-close').focus();
  ov.addEventListener('click', function(e){
    if(e.target===ov || e.target.closest('.rp-close')){ close(); return; }
    var go = e.target.closest('.rp-go');
    if(go){ e.preventDefault(); close(); setPage('inv'); invSelect(go.getAttribute('data-pane')); }
  });
}

function categoryBlocksFor(k, v){
  var skipCols = { id:1, subscriptionId:1 };
  var rows = safeArr(v.rows);
  ROWREG[k] = rows;
  var sample = rows.slice(0,50);
  var cols = [];
  if(rows.length){
    var candidateCols = []; rows.forEach(function(r){Object.keys(r).forEach(function(c){if(!skipCols[c] && candidateCols.indexOf(c)<0)candidateCols.push(c);});});
    var scored = candidateCols.map(function(c){
      var d = sample.filter(function(r){ return r[c]!==null && r[c]!==undefined && String(r[c])!==''; }).length;
      return [c,d];
    }).filter(function(p){ return p[1] > sample.length*0.2; });
    function columnPriority(c){var k=c.toLowerCase().replace(/[^a-z]/g,'');return /^(name|displayname|vmname|resourcename|recommendation)$/.test(k)?3:/^(resourcegroup|subscription|subscriptionname|location|region)$/.test(k)?2:/^(status|powerstate)$/.test(k)?1:0;}
    scored.sort(function(a,b){ return columnPriority(b[0])-columnPriority(a[0]) || b[1]-a[1]; });
    cols = scored.slice(0,7).map(function(p){ return p[0]; });
  }
  var cap = 50;
  if(!rows.length){
    return v.count ? '<p class="lede small">Count only — no per-item rows collected for this category.</p>'
      : '<p class="lede small">No rows were retained for this dataset. Review collection health and selected scope before concluding that no resources exist.</p>';
  }
  var trs = rows.map(function(r,i){
    var cells = cols.map(function(c){
      var val = r[c];
      if(val && typeof val==='object') val = JSON.stringify(val);
      val = String(val===null||val===undefined?'':val);
      var full = val.length>80 ? ' title="'+esc(val.slice(0,500))+'"' : '';
      if(val.length>80) val = val.slice(0,77)+'…';
      return '<td class="mono"'+full+'>'+esc(val)+'</td>';
    }).join('');
    return '<tr tabindex="0" aria-label="Open item details" class="rowclick'+(i>=cap?' depth-data':'')+'" data-rk="'+esc(k)+'" data-ri="'+i+'" title="Click for full details">'+cells+'<td class="mono">'+esc(subName(r.subscriptionId))+'</td></tr>';
  }).join('');
  var capNote = rows.length>cap ? '<div class="capnote">Showing '+cap+' of '+n(v.count)+' by default — switch to the Data view for every row, or use the CSV export.</div>'
    : (v.count>rows.length ? '<div class="capnote">'+n(v.count)+' total; '+rows.length+' sampled rows collected.</div>' : '');
  var headCells = cols.map(function(c){ return '<th>'+esc(c)+' ⇅</th>'; }).join('')+'<th>subscription ⇅</th>';
  var table = '<div class="catwrap"><input class="tfilter" placeholder="Filter '+esc(catLeaf(v.label||k)).toLowerCase()+'… (any column)"><div class="twrap"><table><tr>'+headCells+'</tr>'+trs+'</table></div>'+capNote+'</div>';
  var unitNote = '<p class="lede small">'+n(v.count)+' '+esc(v.countUnit||'rows')+(v.resourceCount!=null?' · '+n(v.resourceCount)+' distinct resource identities':'')+'. Rows may describe child objects; dataset totals are not an estate resource count.</p>';
  var execNote = '<p class="lede small depth-exec">'+n(v.count)+' item'+(v.count===1?'':'s')+' collected. Switch to <b>Consultant</b> to browse a sample of '+Math.min(cap,rows.length)+', or <b>Data</b> for every row.</p>';
  return unitNote+execNote+'<div class="depth-cons"><button type="button" class="btn" data-inventory-export="'+esc(k)+'">Export all rows as CSV</button>'+table+'</div>';
}
function categoryPane(k, v){
  var block = categoryBlocksFor(k, v);
  var path = catPath(v.label);
  return '<h2>'+esc(catLeaf(v.label||k))+' <span class="h2sub">'+(path?esc(path)+' · ':'')+'<span class="mono">'+esc(k)+'</span> · '+n(v.count)+' items</span></h2>'+block;
}

