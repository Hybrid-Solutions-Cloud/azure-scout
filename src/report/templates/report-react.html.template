  var w = 860;
  var out = '<text x="20" y="26" fill="var(--band-crit)" font-weight="800" font-size="11">INTERNET</text>'+
    '<path d="M 20 34 V '+(30+order.length*76)+'" stroke="var(--band-crit)" stroke-width="2.5" stroke-dasharray="5 4" fill="none"/>';

  var y = 20;
