/* ---- AB#7050-7058 four additional network diagrams (VNet connectivity,
   hybrid site-to-site, private link & DNS, internet exposure). Ported from
   src/report/renderers/react/diagram-*.mjs -- esc/catId/svgWrap/safeArr are
   already defined above in this same script, so the modules' own duplicate
   copies of those helpers are dropped here; everything else is a direct
   port reading straight off the global `inventory` bag. ---- */
function diagVnetTopology(){
  var vnets = safeArr((inventory['networking.virtualNetworks']||{}).rows);
  var peers = safeArr((inventory['networking.vnetPeerings']||{}).rows);
  var subnets = safeArr((inventory['networking.subnets']||{}).rows);
  var fws = safeArr((inventory['networking.azureFirewalls']||{}).rows);
  var gws = safeArr((inventory['networking.vpnGateways']||{}).rows);
  var ercs = safeArr((inventory['networking.expressRouteCircuits']||{}).rows);
  if(!vnets.length) return '';
  var byDisp = {}; vnets.forEach(function(v){ byDisp[tcDisp(v.name)] = v; });
  var subCount = function(d){ var v = byDisp[d]; if(!v) return 0; return subnets.filter(function(s){ return s.vnet===v.name || s.vnet===d; }).length; };

  /* dedupe reciprocal peerings into pairs */
  var pairKey = {}, pairs = [];
  peers.forEach(function(p){
    var a = tcDisp(p.vnet), b = tcDisp(p.remoteVnetName);
    var k = a<b ? a+'|'+b : b+'|'+a;
    if(!pairKey[k]){ pairKey[k] = { a:a, b:b, state:p.peeringState||'', gwt:!!(p.allowGatewayTransit||p.useRemoteGateways) }; pairs.push(pairKey[k]); }
    else if(p.allowGatewayTransit||p.useRemoteGateways){ pairKey[k].gwt = true; }
  });
  var deg = {}; pairs.forEach(function(p){ deg[p.a]=(deg[p.a]||0)+1; deg[p.b]=(deg[p.b]||0)+1; });
  var hubs = Object.keys(deg).filter(function(k){ return deg[k]>=2; })
    .sort(function(x,y){ return deg[y]-deg[x]; }).slice(0,2)
    .sort(function(x,y){ return String(tcRegion(x)||'z').localeCompare(String(tcRegion(y)||'z')); });
  var isHub = {}; hubs.forEach(function(h){ isHub[h]=1; });
  var spokesOf = {}; hubs.forEach(function(h){ spokesOf[h]=[]; });
  var crossPairs = [], islandPairs = [];
  pairs.forEach(function(p){
    if(isHub[p.a] && isHub[p.b]) crossPairs.push(p);
    else if(isHub[p.a]) spokesOf[p.a].push(p);
    else if(isHub[p.b]) spokesOf[p.b].push({ a:p.b, b:p.a, state:p.state, gwt:p.gwt });
    else islandPairs.push(p);
  });
  var unpeered = vnets.map(function(v){ return tcDisp(v.name); }).filter(function(d){ return !deg[d]; });

  var W = 1200, out = '';
  /* legend */
  var lg = 14;
  out += '<rect x="'+lg+'" y="12" width="14" height="14" rx="3" fill="var(--primary-tint)" stroke="var(--primary)" stroke-width="1.6"/><text x="'+(lg+20)+'" y="23" fill="var(--muted)" font-size="9.5">Hub VNet</text>';
  out += '<rect x="'+(lg+92)+'" y="12" width="14" height="14" rx="3" fill="var(--surface)" stroke="var(--primary)"/><text x="'+(lg+112)+'" y="23" fill="var(--muted)" font-size="9.5">Spoke VNet</text>';
  out += '<line x1="'+(lg+196)+'" y1="19" x2="'+(lg+228)+'" y2="19" stroke="var(--primary)" stroke-width="2"/><text x="'+(lg+234)+'" y="23" fill="var(--muted)" font-size="9.5">VNet peering (Connected)</text>';
  out += '<rect x="'+(lg+390)+'" y="12" width="14" height="14" rx="3" fill="var(--surface)" stroke="var(--band-mod)" stroke-width="1.6"/><text x="'+(lg+410)+'" y="23" fill="var(--muted)" font-size="9.5">Configuration issue</text>';
  out += '<rect x="'+(lg+530)+'" y="12" width="14" height="14" rx="3" fill="var(--surface)" stroke="var(--faint)" stroke-dasharray="3 3"/><text x="'+(lg+550)+'" y="23" fill="var(--muted)" font-size="9.5">Not peered — no collected hub peering</text>';

  var hubW = 340, hubH = 96, hubY = 74, centers = hubs.length===2 ? [320, 880] : [W/2];
  var spokeW = 300, spokeH = 58, spokeGap = 16, spokeY0 = hubY + hubH + 58;
  var bottoms = [];

  hubs.forEach(function(h, i){
    var cx = centers[i], v = byDisp[h] || {};
    var reg = tcLocation(v) || '';
    var fw = fws.filter(function(f){ return reg && tcLocation(f)===reg; })[0];
    out += '<text x="'+cx+'" y="'+(hubY-14)+'" text-anchor="middle" fill="var(--faint)" font-size="11" font-weight="800" letter-spacing="2">'+esc(reg.toUpperCase()||'REGION')+'</text>';
    out += '<g class="diag-node" data-gopane="'+catId('networking.virtualNetworks')+'"><title>'+esc(h)+'</title>'+
      '<rect x="'+(cx-hubW/2)+'" y="'+hubY+'" width="'+hubW+'" height="'+hubH+'" rx="10" fill="var(--primary-tint)" stroke="var(--primary)" stroke-width="2.4"/>'+
      '<text x="'+cx+'" y="'+(hubY+20)+'" text-anchor="middle" fill="var(--primary)" font-weight="800" font-size="9.5" letter-spacing="1.5">HUB</text>'+
      '<text x="'+cx+'" y="'+(hubY+38)+'" text-anchor="middle" fill="var(--ink)" font-weight="700" font-size="12.5">'+esc(h)+'</text>'+
      '<text x="'+cx+'" y="'+(hubY+56)+'" text-anchor="middle" fill="var(--muted)" font-size="10">'+subCount(h)+' subnets'+(fw?' · '+esc(fw.name):'')+'</text>'+
      '<text x="'+cx+'" y="'+(hubY+74)+'" text-anchor="middle" fill="var(--band-crit)" font-size="9.5" font-weight="600">'+
        (v.ddosEnabled?'':'DDoS off')+((gws.length||ercs.length)?'':(v.ddosEnabled?'':' · ')+'no VPN gateway · no ExpressRoute')+'</text></g>';
    var sps = spokesOf[h] || [], sy = spokeY0;
    sps.sort(function(x,y){ return subCount(y.b)-subCount(x.b); });
    sps.forEach(function(p){
      var okc = p.state==='Connected';
      out += '<path d="M '+cx+' '+(hubY+hubH)+' V '+(sy-22)+' '+' M '+cx+' '+(sy-22)+' V '+sy+'" stroke="'+(okc?'var(--primary)':'var(--band-crit)')+'" stroke-width="2" fill="none"/>'+
        '<text x="'+(cx+8)+'" y="'+(sy-8)+'" fill="'+(okc?'var(--primary)':'var(--band-crit)')+'" font-size="8.5" font-weight="600">'+esc(p.state||'state n/a')+'</text>';
      var v2 = byDisp[p.b] || {};
      out += '<g class="diag-node" data-gopane="'+catId('networking.virtualNetworks')+'"><title>'+esc(p.b)+'</title>'+
        '<rect x="'+(cx-spokeW/2)+'" y="'+sy+'" width="'+spokeW+'" height="'+spokeH+'" rx="8" fill="var(--surface)" stroke="var(--primary)" stroke-width="1.4"/>'+
        '<text x="'+cx+'" y="'+(sy+23)+'" text-anchor="middle" fill="var(--ink)" font-weight="650" font-size="11.5">'+esc(p.b)+'</text>'+
        '<text x="'+cx+'" y="'+(sy+42)+'" text-anchor="middle" fill="var(--muted)" font-size="9.5">'+subCount(p.b)+' subnets · '+esc(tcTrunc(subName(v2.subscriptionId)||'',30))+'</text></g>';
      sy += spokeH + spokeGap;
    });
    bottoms.push(sps.length ? sy - spokeGap : hubY + hubH);
  });

  if(hubs.length===2 && crossPairs.length){
    var yMid = hubY + hubH/2;
    out += '<path d="M '+(centers[0]+hubW/2)+' '+yMid+' H '+(centers[1]-hubW/2)+'" stroke="var(--primary)" stroke-width="2.4" fill="none"/>'+
      '<text x="'+((centers[0]+centers[1])/2)+'" y="'+(yMid-8)+'" text-anchor="middle" fill="var(--primary)" font-size="9.5" font-weight="700">hub-to-hub peering · '+esc(crossPairs[0].state)+'</text>';
  }

  var y = Math.max.apply(null, bottoms.concat([spokeY0])) + 44;

  if(islandPairs.length){
    out += '<text x="14" y="'+y+'" fill="var(--faint)" font-size="10" font-weight="800" letter-spacing="1.5">PEERED OUTSIDE THE HUB-AND-SPOKE ('+islandPairs.length+' pair'+(islandPairs.length===1?'':'s')+')</text>';
    y += 14;
    islandPairs.forEach(function(p){
      var bw = 280, bh = 52, x1 = 40, x2 = x1 + bw + 150, warn = p.gwt && !gws.length;
      [[p.a,x1],[p.b,x2]].forEach(function(pair){
        var v3 = byDisp[pair[0]] || {};
        out += '<g class="diag-node" data-gopane="'+catId('networking.virtualNetworks')+'"><title>'+esc(pair[0])+'</title>'+
          '<rect x="'+pair[1]+'" y="'+y+'" width="'+bw+'" height="'+bh+'" rx="8" fill="var(--surface)" stroke="'+(warn?'var(--band-mod)':'var(--primary)')+'" stroke-width="1.4"/>'+
          '<text x="'+(pair[1]+bw/2)+'" y="'+(y+21)+'" text-anchor="middle" fill="var(--ink)" font-weight="650" font-size="11">'+esc(tcTrunc(pair[0],34))+'</text>'+
          '<text x="'+(pair[1]+bw/2)+'" y="'+(y+38)+'" text-anchor="middle" fill="var(--muted)" font-size="9">'+subCount(pair[0])+' subnets · '+esc(tcTrunc(subName(v3.subscriptionId)||'',26))+'</text></g>';
      });
      out += '<path d="M '+(x1+bw)+' '+(y+bh/2)+' H '+x2+'" stroke="'+(warn?'var(--band-mod)':'var(--primary)')+'" stroke-width="2" fill="none"/>'+
        '<text x="'+(x1+bw+75)+'" y="'+(y+bh/2-6)+'" text-anchor="middle" fill="'+(warn?'var(--band-mod)':'var(--primary)')+'" font-size="8.5" font-weight="600">'+esc(p.state)+'</text>';
      if(warn){
        out += '<text x="'+(x2+bw+16)+'" y="'+(y+bh/2+4)+'" fill="var(--band-mod)" font-size="9.5" font-weight="700">⚠ gateway transit configured, but no gateway was collected</text>';
      }
      y += 52 + 18;
    });
    y += 10;
  }

  if(unpeered.length){
    var chips = unpeered.map(function(d){ return { d:d, t: tcTrunc(d,30)+' · '+subCount(d) }; });
    var cy = y + 30, cxp = 30, rowH2 = 30, trayX = 14, trayW = W-28;
    var pos = [];
    chips.forEach(function(c){
      var wch = tcChipW(c.t, 9.5);
      if(cxp + wch > trayW - 14){ cxp = 30; cy += rowH2; }
      pos.push({ x:cxp, y:cy, w:wch, c:c });
      cxp += wch + 10;
    });
    var trayH = (cy + rowH2 + 6) - y;
    out += '<rect x="'+trayX+'" y="'+y+'" width="'+trayW+'" height="'+trayH+'" rx="10" fill="none" stroke="var(--faint)" stroke-width="1.2" stroke-dasharray="5 4"/>'+
      '<text x="30" y="'+(y+19)+'" fill="var(--faint)" font-size="10" font-weight="800" letter-spacing="1.5">NOT PEERED — '+unpeered.length+' VNETS WITH NO COLLECTED PEERING</text>';
    pos.forEach(function(p){
      out += '<g class="diag-node" data-gopane="'+catId('networking.virtualNetworks')+'"><title>'+esc(p.c.d)+' · '+subCount(p.c.d)+' subnets</title>'+
        '<rect x="'+p.x+'" y="'+(p.y+8)+'" width="'+p.w+'" height="20" rx="10" fill="var(--surface)" stroke="var(--border)"/>'+
        '<text x="'+(p.x+p.w/2)+'" y="'+(p.y+21)+'" text-anchor="middle" fill="var(--muted)" font-size="9.5">'+esc(p.c.t)+'</text></g>';
    });
    y += trayH + 12;
  }

  return svgWrap('vnettopo', 'VNet connectivity — hub and spoke',
    vnets.length+' VNets, '+pairs.length+' peering relationships (reciprocal links shown once). Hub candidates are selected by peering degree; each spoke label shows its subnet count and subscription. The pair outside the hubs and the '+unpeered.length+' unpeered VNets are drawn separately — other connectivity cannot be inferred from peering rows alone.',
    out, W, y+6);
}

