function pageOverview(){
  var gauges = assessments.map(function(a){
    var s = a.score || {};
    var fails = safeArr(a.findings).filter(function(f){ return f.status==='Fail'; }).length;
    return '<a class="tilelink goto" data-gopage="a-'+a.slug+'" href="#top"><div class="gaugebox hover"><div class="gtitle">'+esc(a.name)+' <span class="go">open →</span></div>'+
      bandChip(s.percent)+' <b style="margin-left:6px">'+(s.percent!=null?s.percent+' / 100':'')+'</b><span class="lede small"> '+safeArr(a.findings).length+' checks · '+fails+' not met</span>'+
      gauge(s.percent,true)+'</div></a>';
  }).join('');
  var high = allFindings.filter(function(f){ return f.status==='Fail' && f.severity==='high'; })
    .sort(function(a,b){
      var av = safeArr(a.evidence).filter(function(e){return e.resourceName;}).length * (a.weight||0);
      var bv = safeArr(b.evidence).filter(function(e){return e.resourceName;}).length * (b.weight||0);
      return bv-av;
    });
  var sp = high[0];
  var spotBlock = '';
  if(sp){
    var spNames = safeArr(sp.evidence).filter(function(e){return e.resourceName;}).slice(0,4).map(function(e){return '<span class="mono">'+esc(e.resourceName)+'</span>';}).join(', ');
    spotBlock = '<h3>The one item to act on this week</h3><div class="spot"><div class="k">HIGHEST EXPOSURE · '+esc((sp.area||'').toUpperCase())+'</div>'+
      '<h3 style="margin:6px 0 4px">'+esc(sp.title)+'</h3><p>'+(spNames?'Affected today: '+spNames+'.':'Nothing in scope satisfies this check today.')+' '+esc(String(sp.remediation||'').split(/(?<=\.)\s/)[0]||'')+'</p>'+
      '<a href="'+esc(betterLearnUrl(sp))+'" rel="noopener">Microsoft guidance →</a></div>';
  }
  return '<h2>Overview</h2>'+
  '<div class="collbox"><div class="ci"><span class="cl">✓ Collection</span><span class="cv">Read-only</span></div>'+
  '<div class="ci"><span class="cl">Tenant</span><span class="cv">'+esc(meta.tenantDisplayName||'')+'</span></div>'+
  '<div class="ci"><span class="cl">Run</span><span class="cv mono">'+esc(meta.runId||'')+'</span></div>'+
  '<div class="ci"><span class="cl">Collected</span><span class="cv">'+esc((meta.generatedOn||'').slice(0,16).replace('T',' '))+'</span></div>'+
  '<div class="ci"><span class="cl">Subscriptions in scope</span><span class="cv">'+subscriptions.length+'</span></div>'+
  '<div class="ci"><span class="cl">Method</span><span class="cv">Azure Resource Graph + ARM</span></div></div>'+
  '<p class="lede"><b>'+counts.total+' CAF/WAF checks were evaluated against this tenant</b> — '+counts.pass+' met, <b>'+counts.fail+' not met</b> ('+counts.high+' high severity), '+counts.manual+' need manual review — across an estate of '+n(invTotal)+' collected items in '+subscriptions.length+' subscriptions.</p>'+
  '<div class="kpis"><div class="kpi"><div class="l">Checks evaluated</div><div class="v">'+counts.total+'</div><div class="f">across '+assessments.length+' assessments</div></div>'+
  '<div class="kpi good"><div class="l">Met</div><div class="v">'+counts.pass+'</div><div class="f">of '+(counts.pass+counts.fail)+' automated</div></div>'+
  '<div class="kpi bad"><div class="l">Not met</div><div class="v">'+counts.fail+'</div><div class="f">'+counts.high+' high severity</div></div>'+
  '<div class="kpi"><div class="l">Manual review</div><div class="v">'+counts.manual+'</div><div class="f">listed as an agenda</div></div>'+
  '<a class="kpi tilelink goto" data-gopage="inv" href="#inv-structure"><div class="l">Management groups</div><div class="v">'+((inventory['governance.managementGroups']||{}).count||0)+'</div><div class="f">view hierarchy →</div></a>'+
  '<a class="kpi tilelink goto" data-gopage="inv" href="#inv-structure"><div class="l">Subscriptions</div><div class="v">'+subscriptions.length+'</div><div class="f">view list →</div></a></div>'+
  '<div class="eyebrow">Where to go</div><div class="menutiles">'+
  '<a class="mtile goto" data-gopage="inv" href="#top"><div class="mt">📦 Inventory &amp; audit</div><div class="md">'+n(invTotal)+' items in '+invEntries.length+' categories · what exists, and what looks wrong</div></a>'+
  '<a class="mtile goto" data-gopage="as" href="#top"><div class="mt">📋 Assessments</div><div class="md">'+assessments.length+' assessments · '+counts.total+' checks · the complete conformance register</div></a>'+
  '<a class="mtile goto" data-gopage="data" href="#top"><div class="mt">🗃️ Data &amp; drift</div><div class="md">Every finding and evidence row · change since the previous run</div></a>'+
  '<a class="mtile goto" data-gopage="road" href="#top"><div class="mt">🛠️ Remediation plan</div><div class="md">All '+counts.fail+' gaps, by team, with windows</div></a></div>'+
  '<div class="eyebrow">Assessment results — click any to open its full register</div>'+gauges+spotBlock;
}

