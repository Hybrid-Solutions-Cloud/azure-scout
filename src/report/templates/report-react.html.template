function tcNode(pane, inner){ return '<g class="diag-node" data-gopane="'+catId(pane)+'">'+inner+'</g>'; }
function tcBox(x,y,w,h,opt){
  opt = opt||{};
  return '<rect x="'+x+'" y="'+y+'" width="'+w+'" height="'+h+'" rx="'+(opt.rx||10)+'" fill="'+(opt.fill||'var(--surface)')+'" stroke="'+(opt.stroke||'var(--border)')+'" stroke-width="'+(opt.sw||1.5)+'"'+(opt.dash?' stroke-dasharray="'+opt.dash+'"':'')+'/>';
}
function tcText(x,y,txt,opt){
  opt = opt||{};
  return '<text x="'+x+'" y="'+y+'"'+(opt.anchor?' text-anchor="'+opt.anchor+'"':'')+' fill="'+(opt.fill||'var(--ink)')+'" font-size="'+(opt.fs||10)+'"'+(opt.fw?' font-weight="'+opt.fw+'"':'')+(opt.ls?' letter-spacing="'+opt.ls+'"':'')+'>'+esc(txt)+'</text>';
}
function tcArrow(x1,y1,x2,y2,color,dash){
  var a = Math.atan2(y2-y1,x2-x1), s=7;
  var p1 = (x2-s*Math.cos(a-0.45))+','+(y2-s*Math.sin(a-0.45)), p2 = (x2-s*Math.cos(a+0.45))+','+(y2-s*Math.sin(a+0.45));
  return '<line x1="'+x1+'" y1="'+y1+'" x2="'+x2+'" y2="'+y2+'" stroke="'+color+'" stroke-width="2"'+(dash?' stroke-dasharray="'+dash+'"':'')+'/>'+
    '<polygon points="'+x2+','+y2+' '+p1+' '+p2+'" fill="'+color+'"/>';
}

