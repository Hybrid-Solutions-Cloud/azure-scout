    var mx = sx + sw/2;
    out += peered
      ? '<path d="M '+cx+' '+(cy+hubH/2)+' V '+(sy-26)+' H '+mx+' V '+sy+'" stroke="var(--primary)" stroke-width="2" fill="none"/>'
      : '<path d="M '+cx+' '+(cy+hubH/2)+' V '+(sy-26)+' H '+mx+' V '+sy+'" stroke="var(--band-crit)" stroke-width="2" stroke-dasharray="4 4" fill="none" opacity=".55"/>'+
        '<text x="'+mx+'" y="'+(sy-32)+'" text-anchor="middle" fill="var(--band-crit)" font-size="10" font-weight="700">no peering</text>';
    out += '<g class="diag-node" data-gopane="'+catId('networking.virtualNetworks')+'">'+
      '<rect x="'+sx+'" y="'+sy+'" width="'+sw+'" height="66" rx="8" fill="var(--surface)" stroke="'+(peered?'var(--primary)':'var(--band-crit)')+'" stroke-width="1.5"/>'+
      '<text x="'+(sx+sw/2)+'" y="'+(sy+24)+'" text-anchor="middle" fill="var(--ink)" font-weight="650" font-size="11.5">'+esc(s.name)+'</text>'+
      '<text x="'+(sx+sw/2)+'" y="'+(sy+41)+'" text-anchor="middle" fill="var(--muted)" font-size="10.5">'+subs.length+' subnet'+(subs.length===1?'':'s')+' · '+(s.peeringCount||0)+' peering'+((s.peeringCount||0)===1?'':'s')+'</text>'+
      '<text x="'+(sx+sw/2)+'" y="'+(sy+56)+'" text-anchor="middle" fill="var(--faint)" font-size="9.5">'+esc(s.resourceGroup)+'</text></g>';
    sx += sw + gap;
  });

  return svgWrap('vnettopo', 'VNet connectivity — hub and spoke',
    vnets.length+' VNets. The hub is identified by the gateway it hosts; an edge is drawn where a peering exists and marked in red where a VNet has none. <b>Peering direction and the remote end of each edge need the collector extension</b> — today the payload carries a peering count per VNet, not the pairs.',
    out, w, sy+90);
