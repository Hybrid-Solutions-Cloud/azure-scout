  return svgWrap('edge', 'Edge & delivery — internet-facing entry points',
    total+' delivery and edge resources across '+tiers.length+' service tiers. '+
    (pubLb ? pubLb+' load balancer'+(pubLb===1?' takes':'s take')+' internet traffic on a public frontend'+(agws.length?'':' with no Application Gateway or WAF tier in front')+'. ' : '')+
    (basicBas ? basicBas+' of '+bas.length+' Bastion hosts run the Basic SKU. ' : '')+
    'NAT gateways are outbound-only; Bastion carries administrative sessions. Hover a card for the full resource name.',
    out, W, y+4);
}

function diagRouting(){
  var rts = safeArr((inventory['networking.routeTables']||{}).rows);
  if(!rts.length) return '';
  function defaults(rt){
    return String(rt.routes||'').split(';').map(function(s){ return s.trim(); })
      .filter(function(s){ return s.indexOf(':0.0.0.0/0->') !== -1; })
      .map(function(s){ return { name:s.split(':')[0], hop:s.split('->').pop() }; });
  }
  var groups = { forced:[], internet:[], none:[] };
  rts.forEach(function(rt){
    var ds = defaults(rt);
    var item = { rt:rt, ds:ds };
    if(ds.some(function(d){ return d.hop==='VirtualAppliance'; })) groups.forced.push(item);
    else if(ds.some(function(d){ return d.hop==='Internet'; })) groups.internet.push(item);
    else groups.none.push(item);
  });
  Object.keys(groups).forEach(function(k){ groups[k].sort(function(a,b){ return String(a.rt.name).localeCompare(String(b.rt.name)); }); });

  var W = 1200, y = 14, out = '', rowH = 27;
  function grp(title, note, items, color, rowNote){
    if(!items.length) return;
    out += '<text x="14" y="'+(y+12)+'" fill="'+color+'" font-size="10" font-weight="800" letter-spacing="1.5">'+esc(title)+'</text>'+
      '<text x="14" y="'+(y+27)+'" fill="var(--muted)" font-size="9.5">'+esc(note)+'</text>';
    y += 38;
    var boxY = y, boxH = items.length*rowH + 10;
    out += '<rect x="14" y="'+boxY+'" width="1172" height="'+boxH+'" rx="9" fill="var(--surface)" stroke="var(--border)" stroke-width="1.2"/>'+
      '<rect x="14" y="'+boxY+'" width="4" height="'+boxH+'" rx="2" fill="'+color+'"/>';
    items.forEach(function(it, i){
      var ry = boxY + 8 + i*rowH;
      var rt = it.rt, d0 = it.ds[0];
      out += '<g class="diag-node" data-gopane="'+catId('networking.routeTables')+'"><title>'+esc(rt.name)+' · '+esc(rt.resourceGroup)+'</title>'+
        '<text x="34" y="'+(ry+13)+'" fill="var(--ink)" font-weight="650" font-size="10">'+esc(tcTrunc(rt.name,34))+'</text>'+
        '<text x="300" y="'+(ry+13)+'" fill="var(--muted)" font-size="9.5">'+esc(tcRegionLoc(rt.location))+'</text>'+
        '<text x="410" y="'+(ry+13)+'" fill="var(--muted)" font-size="9.5">'+(rt.routeCount||0)+' routes · '+(rt.subnetCount||0)+' subnet'+((rt.subnetCount||0)===1?'':'s')+'</text>'+
        (d0 ? '<text x="560" y="'+(ry+13)+'" fill="'+color+'" font-size="9.5" font-weight="650" class="mono">0.0.0.0/0 → '+esc(d0.hop)+'</text>' : '<text x="560" y="'+(ry+13)+'" fill="var(--faint)" font-size="9.5" font-style="italic">no default route</text>')+
        '<text x="820" y="'+(ry+13)+'" fill="var(--faint)" font-size="9">'+(rt.disableBgpRoutePropagation?'BGP propagation off':'BGP propagation on')+'</text>'+
        (rowNote ? '<text x="985" y="'+(ry+13)+'" fill="var(--faint)" font-size="9">'+esc(rowNote(it))+'</text>' : '')+
        '</g>';
    });
    y = boxY + boxH + 16;
  }
  grp('FORCED TUNNELING — DEFAULT ROUTE THROUGH THE FIREWALL / NVA ('+groups.forced.length+')',
    'Conforming pattern: outbound traffic leaves through an inspected appliance. BGP propagation off is the expected setting with user-defined routes.',
    groups.forced, 'var(--band-exc)', null);
  grp('DEFAULT ROUTE DIRECT TO INTERNET ('+groups.internet.length+')',
    'On a firewall subnet this is by design — it is the firewall\'s own egress. Anywhere else it bypasses inspection.',
    groups.internet, 'var(--accent)',
    function(it){ return /firewall/i.test(it.rt.name||'') ? 'by design — firewall egress' : '⚠ bypasses the firewall'; });
  grp('NO DEFAULT ROUTE ('+groups.none.length+')',
    'These subnets fall back to system routing for 0.0.0.0/0 (or receive routes another way, e.g. the SD-WAN appliance interfaces).',
    groups.none, 'var(--faint)', null);

  return svgWrap('routing', 'Routing & forced tunneling — user-defined routes',
    rts.length+' route tables, grouped by what their default route does. '+groups.forced.length+' force outbound traffic through a virtual appliance (the conforming forced-tunneling pattern), '+
    groups.internet.length+' send 0.0.0.0/0 straight to the internet ('+(groups.internet.filter(function(it){ return /firewall/i.test(it.rt.name||''); }).length)+' of them on firewall subnets, where that is the design), and '+
    groups.none.length+' carry no default route. The 0.0.0.0/0 route decides where every outbound packet leaves the subnet.',
    out, W, y);
}

