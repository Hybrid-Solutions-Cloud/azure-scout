  return svgWrap('plink', 'Private link — endpoints and the services they front',
    pes.length+' private endpoints and the '+uniq.length+' DNS zones that resolve them. Drawn from measured data: each endpoint\'s target resource is collected today.',
    defs+out, w, h);
