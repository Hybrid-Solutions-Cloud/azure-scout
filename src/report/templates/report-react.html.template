var CAT_ORDER = ['General','AI','Analytics','Compute','Containers','Databases','DevOps','Hybrid','Identity','Integration','IoT','Management','Migration','Monitor','Networking','Security','Storage','Web'];
var CAT_LABEL = { AI:'AI + Machine Learning', Hybrid:'Hybrid + multicloud', IoT:'Internet of Things', Management:'Management and governance', Web:'Web & Mobile' };
function keyCat(k){
  if(/^(subscriptions|tags|advisor)$/.test(k)) return 'General';
  if(k.indexOf('networking.')===0) return 'Networking';
  if(k.indexOf('compute.')===0) return 'Compute';
  if(k==='management.logAnalyticsWorkspaces' || k.indexOf('opsPosture.')===0) return 'Monitor';
  if(k.indexOf('management.')===0) return 'Management';
  if(k.indexOf('security.')===0) return 'Security';
  if(/^governance\.(roleAssignments|pimEligibility|classicAdministrators)$/.test(k)) return 'Identity';
  if(k.indexOf('governance.')===0) return 'Management';
  if(k.indexOf('devops.')===0) return 'DevOps';
  var m = k.match(/^domains\.([a-z]+)\./i);
  if(m){
    var map = { storage:'Storage', databases:'Databases', web:'Web', containers:'Containers', security:'Security', ai:'AI', hybrid:'Hybrid', integration:'Integration', iot:'IoT', migration:'Migration', analytics:'Analytics', management:'Management' };
    return map[m[1].toLowerCase()] || 'General';
  }
  return null; // derived set (costCleanup.*/finops.*) — lives in the audit/cost blades, not the category tree
}
function grpId(g){ return 'grp-'+g.replace(/[^A-Za-z0-9_-]+/g,'-'); }

function pageInventory(){
  var pips = (inventory['costCleanup.orphanedPips']||{}).count || 0;
  var pipMo = pips * 3.65;
  var opp = pips ? '<div class="opp" id="inv-opp"><div class="t">💡 COST OPTIMIZATION OPPORTUNITY</div>'+
    '<div>'+pips+' orphaned public IP address'+(pips===1?'':'es')+' '+(pips===1?'is':'are')+' reserved but attached to nothing. Releasing them saves:</div>'+
    '<div class="big"><span>Monthly: <b>$'+pipMo.toFixed(2)+'</b></span><span>Yearly: <b>$'+(pipMo*12).toFixed(2)+'</b></span></div>'+
    '<div class="act"><b>Action:</b> confirm each address is unreferenced (DNS, firewall rules), then delete. Arithmetic: '+pips+' × $3.65/month per reserved standard public IP × 12 months.</div></div>' : '';

  var mgRows = safeArr((inventory['governance.managementGroups']||{}).rows);
  var kids = {};
  mgRows.forEach(function(m){ var par = m.parent||''; (kids[par]=kids[par]||[]).push(m); });
  var mgNames = {}; mgRows.forEach(function(m){ mgNames[m.name]=1; });
  var roots = mgRows.filter(function(m){ return !m.parent || !mgNames[m.parent]; });
  function mgTree(list, depth){
    return list.map(function(m){
      return '<div class="mgrow" style="padding-left:'+(depth*22)+'px">'+(depth?'└ ':'')+'<b>'+esc(m.displayName)+'</b> <span class="mono small">'+esc(m.name)+'</span></div>'+
        mgTree(kids[m.name]||[], depth+1);
    }).join('');
  }
  var subRows = subscriptions.map(function(s){ return '<tr><td class="mono">'+esc(s.name)+'</td><td class="mono small">'+esc(s.id)+'</td><td>'+esc(s.state)+'</td></tr>'; }).join('');
  var tenantStructure = '<h3 id="inv-structure">Tenant structure</h3><div class="eyebrow">Management-group hierarchy ('+mgRows.length+')</div>'+
    '<div class="gaugebox slim">'+mgTree(roots,0)+'</div><div class="eyebrow">Subscriptions ('+subscriptions.length+')</div>'+
    '<div class="twrap"><table><tr><th>Subscription</th><th>Id</th><th>State</th></tr>'+subRows+'</table></div>';

  var overviewPane = '<h2>Inventory &amp; audit — overview</h2>'+
    '<div class="about"><b>About this environment.</b> The estate holds <b>'+n(invTotal)+' collected items</b> across <b>'+subscriptions.length+' subscriptions</b> in '+invEntries.length+' categories, catalogued read-only via Azure Resource Graph and ARM. This page describes what exists and flags what looks wrong; conformance judgements live on the Assessments pages.</div>'+
    '<div class="kpis"><div class="kpi"><div class="l">Collected items</div><div class="v">'+n(invTotal)+'</div><div class="f">read-only, ARG + ARM</div></div>'+
    '<div class="kpi"><div class="l">Subscriptions</div><div class="v">'+subscriptions.length+'</div><div class="f">all enabled</div></div>'+
    '<div class="kpi"><div class="l">Categories</div><div class="v">'+invEntries.length+'</div><div class="f">of '+Object.keys(inventory).length+' collected have data</div></div>'+
    '<div class="kpi"><div class="l">Virtual machines</div><div class="v">'+((inventory['compute.virtualMachines']||{}).count||0)+'</div><div class="f">select Compute on the left</div></div></div>'+
    '<div class="eyebrow">Top categories — click a card to open its items</div><div class="cards">'+
    invSorted.slice(0,12).map(function(p){ var k=p[0], v=p[1]; return '<a class="card invgo" data-pane="'+catId(k)+'" href="#"><div class="c">'+n(v.count)+'</div><div class="l"><b>'+esc(catLeaf(v.label||k))+'</b></div>'+(catPath(v.label)?'<div class="lp">'+esc(catPath(v.label))+'</div>':'')+'<div class="go">view items →</div></a>'; }).join('')+
    '</div><div class="prov">Pricing as of Aug 2026 — <a href="'+AZURE_PRICING_URL+'" rel="noopener">official pricing</a>. Every figure shows its arithmetic.</div>';

  var groups = {};
  Object.keys(inventory).forEach(function(k){
    var v = inventory[k]; if(!v) return;
    var g = keyCat(k); if(!g) return;
    (groups[g]=groups[g]||[]).push([k,v]);
  });
  CAT_ORDER.forEach(function(c){ if(!groups[c]) groups[c]=[]; });
  var sortedGroups = CAT_ORDER.map(function(c){ return [c, groups[c]||[]]; });
  var sideCats = sortedGroups.map(function(pair){
    var g = pair[0], items = pair[1];
    var head = '<a class="sidehead invgo" data-pane="'+grpId(g)+'" href="#" title="Show a summary of '+esc(CAT_LABEL[g]||g)+'">'+esc(CAT_LABEL[g]||g)+'</a>';
    var body = items.length ? '' : '<span class="sideitem zero"><span>no collectors returned data</span></span>';
    var itemsSorted = items.slice().sort(function(x,y){
      return (y[1].count||0)-(x[1].count||0) || catLeaf(x[1].label||x[0]).localeCompare(catLeaf(y[1].label||y[0]));
    });
    body += itemsSorted.map(function(p){
      var k=p[0], v=p[1];
      return '<a class="sideitem invgo'+(v.count?'':' zero')+'" data-pane="'+catId(k)+'" href="#"><span>'+esc(catLeaf(v.label||k))+'</span><span class="cnt">'+n(v.count||0)+'</span></a>';
    }).join('');
    return head+body;
  }).join('');
  var groupPanes = sortedGroups.map(function(pair){
    var g = pair[0], items = pair[1];
    var total = items.reduce(function(s,p){ return s+(p[1].count||0); },0);
    var withData = items.filter(function(p){ return p[1].count>0; }).length;
    var cards = items.slice().sort(function(x,y){ return (y[1].count||0)-(x[1].count||0); }).map(function(p){
      var k=p[0], v=p[1];
      return '<a class="card invgo'+(v.count?'':' zerocard')+'" data-pane="'+catId(k)+'" href="#"><div class="c">'+n(v.count||0)+'</div><div class="l"><b>'+esc(catLeaf(v.label||k))+'</b></div><div class="go">'+(v.count?'view items →':'none in scope')+'</div></a>';
    }).join('');
    return [grpId(g), '<h2>'+esc(CAT_LABEL[g]||g)+' <span class="h2sub">'+items.length+' collector'+(items.length===1?'':'s')+' · '+n(total)+' items · '+withData+' with data</span></h2>'+
      '<p class="lede small">Everything collected under the <b>'+esc(CAT_LABEL[g]||g)+'</b> category — including collectors that found nothing in scope.</p>'+
      (items.length ? '<div class="cards">'+cards+'</div>' : '<p class="lede">No collectors returned data for this category in this run.</p>')];
  });

  var costFails = allFindings.filter(function(f){ return /cost|billing|finops/i.test(f.area||''); });
  var advisorCost = safeArr((inventory['advisor']||{}).rows).filter(function(r){ return lc(r.Category||r.category)==='cost'; });
  var costPane = '<h2>Cost optimization</h2>'+opp+
    (costFails.length ? '<div class="eyebrow">Cost checks from the assessments ('+costFails.length+')</div><div class="twrap"><table><tr><th>Check</th><th>Assessment</th><th>Severity</th><th>Result</th><th></th></tr>'+
      costFails.map(function(f){ return '<tr><td>'+esc(f.title)+'</td><td>'+esc(f.assessment)+'</td><td>'+sevPill(f.severity)+'</td><td>'+statusPill(f.status)+'</td><td><a class="goto jump" data-gopage="a-'+f.slug+'" href="#g-'+anchorId(f.id)+'">'+(f.status==='Fail'?'open the fix →':'details →')+'</a></td></tr>'; }).join('')+'</table></div>' : '')+
    (advisorCost.length ? '<div class="eyebrow">Azure Advisor — cost recommendations ('+advisorCost.length+')</div>'+categoryBlocksFor('advisor-cost', { label:'Advisor cost', count:advisorCost.length, rows:advisorCost }) : '')+
    '<div class="eyebrow">FinOps data collected</div><div class="twrap"><table><tr><th>Dataset</th><th class="num">Rows</th><th>Note</th></tr>'+
    ['finops.costRows','finops.reservations','finops.reservationRecommendations','finops.anomalies','finops.blockedSubscriptions'].map(function(k){
      var v = inventory[k] || { count:0 };
      return '<tr'+(v.count?'':' style="opacity:.6"')+'><td>'+esc(catLeaf(v.label||k))+'</td><td class="num">'+n(v.count||0)+'</td><td>'+(v.count?'collected this run':'empty — requires -IncludeCosts and the Az.CostManagement module')+'</td></tr>';
    }).join('')+'</table></div>'+
    '<div class="eyebrow">Cleanup items</div><h3>Orphaned public IPs ('+((inventory['costCleanup.orphanedPips']||{}).count||0)+')</h3>'+
    categoryBlocksFor('costCleanup.orphanedPips', inventory['costCleanup.orphanedPips']||{rows:[],count:0})+
    '<h3>Orphaned disks ('+((inventory['costCleanup.orphanedDisks']||{}).count||0)+')</h3>'+
    categoryBlocksFor('costCleanup.orphanedDisks', inventory['costCleanup.orphanedDisks']||{rows:[],count:0})+
    '<div class="prov">Pricing as of Aug 2026 — <a href="'+AZURE_PRICING_URL+'" rel="noopener">official pricing</a>.</div>';

  var panes = [['inv-overview', overviewPane], ['inv-structure', '<h2>Tenant structure</h2>'+tenantStructure],
    ['inv-audit', '<h2>Audit callouts</h2>'+(estateCallouts()||'<p class="lede">Nothing looks wrong in the estate.</p>')],
    ['inv-opp', costPane]].concat(groupPanes).concat(
    Object.keys(inventory).filter(function(k){ return inventory[k]; }).map(function(k){ return [catId(k), categoryPane(k, inventory[k])]; })
  );

  return '<div class="invlayout"><nav class="side"><div class="sidehead">Inventory</div>'+
    '<a class="sideitem invgo on" data-pane="inv-overview" href="#"><span>Overview</span></a>'+
    '<a class="sideitem invgo" data-pane="inv-structure" href="#"><span>🏛 Tenant structure</span><span class="cnt">'+((inventory['governance.managementGroups']||{}).count||0)+' MG · '+subscriptions.length+' subs</span></a>'+
    '<a class="sideitem invgo" data-pane="inv-audit" href="#"><span>⚠ Audit callouts</span></a>'+
    '<a class="sideitem invgo" data-pane="inv-opp" href="#"><span>💰 Cost optimization</span></a>'+
    sideCats+'</nav><div class="invbody">'+
    panes.map(function(p,i){ return '<div class="invpane'+(i===0?' on':'')+'" id="pane-'+p[0]+'">'+p[1]+'</div>'; }).join('')+
    '</div></div>';
}

/* ============================================================
   PAGE: assessments landing
   ============================================================ */
function pageAssessments(){
  var tiles = assessments.map(function(a){
    var s = a.score || {};
    var fs = safeArr(a.findings);
    var fails = fs.filter(function(f){return f.status==='Fail';}).length;
    var passes = fs.filter(function(f){return f.status==='Pass';}).length;
    var manuals = fs.length - fails - passes;
    var areas = dedupeAreas(a.areas).filter(function(ar){ return areaStats(a,ar.name).findings.length; });
    var preview = areas.slice(0,6).map(function(ar){
      var b = band(ar.percent);
      return '<div class="arearow"><span>'+esc(ar.name)+'</span>'+(ar.percent!=null?gauge(ar.percent,false):'<span class="mono faintt manualonly">manual only</span>')+'<span class="bandlab" style="color:'+(b?bandVar[b]:'var(--faint)')+'">'+(b?bandLabel[b]:'MANUAL')+'</span></div>';
    }).join('');
    return '<div class="gaugebox"><div class="gtitle">'+esc(a.name)+' <a class="btn goto" data-gopage="a-'+a.slug+'" href="#top">Open full register →</a></div>'+
      '<div class="lede small">'+esc(a.framework||'')+'</div>'+bandChip(s.percent)+' <b style="margin-left:6px">'+(s.percent!=null?s.percent+' / 100':'')+'</b>'+
      '<span class="lede"> '+verdictSentence(s.percent)+'</span>'+gauge(s.percent,true)+
      '<div class="gl"><span>CRITICAL 0–33</span><span>MODERATE 34–66</span><span>EXCELLENT 67–100</span></div>'+
      '<div class="mono faintt" style="margin-top:5px">'+esc(s.formula||'')+'</div>'+
      '<div class="lede small" style="margin-top:8px">'+fs.length+' checks: <b class="okc">'+passes+' met</b> · <b class="badc">'+fails+' not met</b> · '+manuals+' manual</div>'+
      preview+(areas.length>6?'<div class="lede small">…and '+(areas.length-6)+' more areas in the full register</div>':'')+'</div>';
  }).join('');
  return '<h2>Assessments</h2><p class="lede">'+assessments.length+' assessments ran against this tenant — '+counts.total+' checks in total. Each opens into its complete conformance register: every check with its result, a gap block for every "Not met", and the manual checks as a review agenda.</p>'+tiles;
}

/* ============================================================
   PAGE: one assessment (the complete register)
   ============================================================ */
function areaChapter(a, area, idx){
  var st = areaStats(a, area.name);
  if(!st.findings.length) return '';
  var scored = st.pass + st.fail;
  var scoreLine = area.percent!=null ? '<b>'+area.percent+' / 100</b> <span class="mono faintt">'+esc(area.formula)+'</span>' : '<span class="mono faintt">'+esc(area.formula)+'</span>';
  var meetLine = scored ? 'You meet <b>'+st.pass+' of '+scored+'</b> automated checks in this area'+(st.manual?'; '+st.manual+' more need manual review':'')+'.'
    : 'All '+st.manual+' checks in this area need manual review — nothing here is automated yet.';
  var fails = st.findings.filter(function(f){ return f.status==='Fail'; }).sort(function(x,y){
    return (sevRank.hasOwnProperty(x.severity)?sevRank[x.severity]:3) - (sevRank.hasOwnProperty(y.severity)?sevRank[y.severity]:3) || ((y.evidenceCount||0)-(x.evidenceCount||0));
  });
  return '<details class="chapter" id="a-'+a.slug+'-'+idx+'" open><summary><span class="chsum">'+esc(area.name)+'</span> '+bandChip(area.percent)+
    '<span class="chstats"><b class="okc">'+st.pass+'✓</b> <b class="badc">'+st.fail+'✗</b> '+st.manual+'👁</span></summary>'+
    '<div class="gaugebox slim">'+scoreLine+gauge(area.percent,false)+'<p class="meet">'+meetLine+'</p></div>'+
    '<div class="eyebrow">The register — every check evaluated in this area</div>'+registerTable(st.findings,'a-'+a.slug)+
    (fails.length?'<div class="eyebrow">Gaps — a block for every "Not met" ('+fails.length+')</div>':'')+
    fails.map(gapBlock).join('')+manualAgenda(st.findings)+'</details>';
}
function pageAssessment(a){
  var s = a.score || {};
  var areas = dedupeAreas(a.areas).filter(function(ar){ return areaStats(a,ar.name).findings.length; });
  var fs = safeArr(a.findings);
  var fails = fs.filter(function(f){return f.status==='Fail';}).length;
  var passes = fs.filter(function(f){return f.status==='Pass';}).length;
  var manuals = fs.length - fails - passes;
  var bandRows = areas.map(function(ar,i){
    var st = areaStats(a, ar.name);
    var b = band(ar.percent);
    return '<div class="arearow"><a href="#a-'+a.slug+'-'+i+'">'+esc(ar.name)+'</a>'+(ar.percent!=null?gauge(ar.percent,false):'<span class="mono faintt manualonly">no automated checks — '+st.manual+' manual</span>')+
      '<span class="bandlab" style="color:'+(b?bandVar[b]:'var(--faint)')+'">'+(b?bandLabel[b]:'MANUAL')+'</span></div>';
  }).join('');
  var top = fs.filter(function(f){return f.status==='Fail';}).sort(function(x,y){
    return (sevRank.hasOwnProperty(x.severity)?sevRank[x.severity]:3) - (sevRank.hasOwnProperty(y.severity)?sevRank[y.severity]:3) || ((y.evidenceCount||0)-(x.evidenceCount||0));
  }).slice(0,5);
  var execBlock = '<div class="twrap"><table><tr><th>Check</th><th>Severity</th><th class="num">Affected</th></tr>'+
    top.map(function(f){ return '<tr><td>'+esc(f.title)+'</td><td>'+sevPill(f.severity)+'</td><td class="num">'+(f.evidenceCount||'—')+'</td></tr>'; }).join('')+'</table></div>'+
    '<p class="lede small">Executive view shows the summary this register earns. Switch the View toggle to <b>Consultant</b> for every check and every fix, or <b>Data</b> for everything expanded.</p>';
  return '<div class="crumb"><a class="goto" data-gopage="as" href="#top">← All assessments</a></div>'+
    '<h2>'+esc(a.name)+' <span class="h2sub">'+esc(a.framework||'')+' · '+fs.length+' checks: '+passes+' met · '+fails+' not met · '+manuals+' manual</span></h2>'+
    '<div class="gaugebox">'+bandChip(s.percent)+' <b style="margin-left:8px">'+(s.percent!=null?s.percent+' / 100':'')+'</b><span class="lede"> '+verdictSentence(s.percent)+'</span>'+gauge(s.percent,true)+
    '<div class="gl"><span>CRITICAL 0–33</span><span>MODERATE 34–66</span><span>EXCELLENT 67–100</span></div><div class="mono faintt" style="margin-top:5px">'+esc(s.formula||'')+'</div></div>'+
    '<div class="eyebrow">Design areas — click a name to jump to its chapter; chapters collapse</div><div class="gaugebox">'+bandRows+'</div>'+
    '<div class="depth-exec"><div class="eyebrow">Top gaps in this assessment — Executive view</div>'+execBlock+'</div>'+
    '<div class="depth-cons">'+areas.map(function(ar,i){ return areaChapter(a,ar,i); }).join('')+'</div>'+
    assessmentNext(a);
}
function assessmentNext(a){
  var fails = safeArr(a.findings).filter(function(f){ return f.status==='Fail'; });
  if(!fails.length) return '<h3>What\'s next</h3><p class="lede">No gaps — keep the manual review agenda on the team\'s calendar to hold this state.</p>';
  var groups = {}, order = [];
  fails.forEach(function(f){ if(!groups[f.area]){ groups[f.area]=[]; order.push(f.area); } groups[f.area].push(f); });
  var rows = order.map(function(area){
    var fs = groups[area].slice().sort(function(x,y){ return (sevRank.hasOwnProperty(x.severity)?sevRank[x.severity]:3)-(sevRank.hasOwnProperty(y.severity)?sevRank[y.severity]:3); });
    var acts = fs.slice(0,3).map(function(f){
      var evn = safeArr(f.evidence).filter(function(e){return e.resourceName;}).length;
      var names = safeArr(f.evidence).filter(function(e){return e.resourceName;}).slice(0,2).map(function(e){return '<span class="mono">'+esc(e.resourceName)+'</span>';}).join(', ');
      return '<a class="jump" href="#g-'+anchorId(f.id)+'">'+esc((f.title||'').replace(/\.$/,''))+'</a>'+(evn?' ('+evn+': '+names+(evn>2?', …':'')+')':'');
    }).join(' · ');
    return { area:area, cell: acts+(fs.length>3?' · +'+(fs.length-3)+' more above':''), owner: teamFor(area), win: windowFor(fs[0].severity), sev: sevRank.hasOwnProperty(fs[0].severity)?sevRank[fs[0].severity]:3, count: fs.length };
  }).sort(function(x,y){ return x.sev-y.sev || y.count-x.count; });
  var firstSorted = fails.slice().sort(function(x,y){
    return (sevRank.hasOwnProperty(x.severity)?sevRank[x.severity]:3)-(sevRank.hasOwnProperty(y.severity)?sevRank[y.severity]:3) || ((y.evidenceCount||0)-(x.evidenceCount||0));
  });
  var first = firstSorted[0];
  return '<h3 id="next-'+a.slug+'">What\'s next — closing this assessment\'s '+fails.length+' gaps</h3>'+
    '<p class="lede">Each action links back to its gap block above, which carries the affected resources, why it matters, and the numbered fix. The cross-assessment view lives on the <a class="goto" data-gopage="road" href="#top">Remediation plan</a> page.</p>'+
    '<div class="spot"><div class="k">START HERE</div><b>'+esc(first.title)+'</b> — '+sevPill(first.severity)+(first.evidenceCount?' · '+first.evidenceCount+' affected resource'+(first.evidenceCount===1?'':'s'):'')+' · <a class="jump" href="#g-'+anchorId(first.id)+'">open the fix ↑</a></div>'+
    '<div class="twrap"><table><tr><th>Domain</th><th>Actions (link to the fix above)</th><th>Owner</th><th>Window</th></tr>'+
    rows.map(function(r){ return '<tr><td><b>'+esc(r.area)+'</b><div class="q">'+r.count+' gap'+(r.count===1?'':'s')+'</div></td><td>'+r.cell+'</td><td>'+esc(r.owner)+'</td><td class="num">'+r.win+'</td></tr>'; }).join('')+'</table></div>';
}

/* ============================================================
   PAGE: data & drift
   ============================================================ */
function pageData(){
  var failsRanked = allFindings.filter(function(f){ return f.status==='Fail'; }).sort(function(a,b){
    return (sevRank.hasOwnProperty(a.severity)?sevRank[a.severity]:3)-(sevRank.hasOwnProperty(b.severity)?sevRank[b.severity]:3) || ((b.weight||0)-(a.weight||0));
  });
  var prio = {}; failsRanked.forEach(function(f,i){ prio[f.id]=i+1; });
  var rows = allFindings.map(function(f){
    return '<tr><td class="mono">'+esc(shortId(f.id))+'</td><td><a href="'+esc(betterLearnUrl(f))+'" rel="noopener">'+esc(f.title)+'</a></td><td>'+esc(f.assessment)+'</td><td>'+esc(f.area)+'</td><td>'+sevPill(f.severity)+'</td><td>'+statusPill(f.status)+'</td><td class="num">'+(prio[f.id]!=null?prio[f.id]:'—')+'</td><td class="num">'+(f.evidenceCount||0)+'</td><td><input class="noteb" placeholder="Add a note…"></td></tr>';
  }).join('');
  var evRows = namedEvidence.map(function(e){
    return '<tr><td class="mono">'+esc(shortId(e.fid))+'</td><td class="mono">'+esc(e.resourceName)+'</td><td class="mono">'+esc(subName(e.subscriptionId))+'</td><td>'+esc(e.detail||'')+'</td></tr>';
  }).join('');
  var d = drift || {};
  var dsum = d.Summary || {};
  var dRows = safeArr(d.Findings).filter(function(f){ return f.Drift && f.Drift!=='Unchanged'; }).map(function(f){
    var col = f.Drift==='Regressed' ? 'var(--fail)' : f.Drift==='Resolved' ? 'var(--pass)' : 'var(--ink)';
    return '<tr><td class="mono">'+esc(f.Id)+'</td><td>'+esc(f.Title)+'</td><td>'+esc(f.Area)+'</td><td>'+statusPill(f.PreviousStatus)+'</td><td>'+statusPill(f.CurrentStatus)+'</td><td><b style="color:'+col+'">'+esc(f.Drift)+'</b></td></tr>';
  }).join('');
  return '<h2>Data &amp; drift</h2>'+
    '<details class="sect" open><summary><span class="part">All '+counts.total+' findings</span><span class="hint">every check · Priority ranks the '+counts.fail+' gaps · check titles link to their specific Microsoft guidance</span></summary>'+
    '<div class="twrap"><table><tr><th>Id</th><th>Check</th><th>Assessment</th><th>Area</th><th>Severity</th><th>Result</th><th class="num">Priority</th><th class="num">Evidence</th><th>Notes</th></tr>'+rows+'</table></div></details>'+
    '<details class="sect" open><summary><span class="part">Evidence — every named resource ('+namedEvidence.length+' rows)</span></summary>'+
    '<div class="twrap"><table><tr><th>Check</th><th>Resource</th><th>Subscription</th><th>Observed</th></tr>'+evRows+'</table></div></details>'+
    '<details class="sect" open><summary><span class="part">Drift since previous run</span><span class="hint">'+esc(d.PreviousRunId||'')+' → '+esc(d.RunId||'')+', score '+(d.PreviousScore!=null?d.PreviousScore:'—')+' → '+(d.OverallScore!=null?d.OverallScore:'—')+'</span></summary>'+
    '<div class="kpis"><div class="kpi bad"><div class="l">Regressed</div><div class="v">'+(dsum.Regressed||0)+'</div></div>'+
    '<div class="kpi good"><div class="l">Resolved</div><div class="v">'+(dsum.Resolved||0)+'</div></div>'+
    '<div class="kpi"><div class="l">New</div><div class="v">'+(dsum.New||0)+'</div></div>'+
    '<div class="kpi"><div class="l">Unchanged</div><div class="v">'+(dsum.Unchanged||0)+'</div></div></div>'+
    (dRows ? '<div class="twrap"><table><tr><th>Check</th><th>Title</th><th>Area</th><th>Was</th><th>Now</th><th>Drift</th></tr>'+dRows+'</table></div>' : '<p class="lede small">No checks changed state between the two runs.</p>')+'</details>'+
    '<div class="prov">Data provenance: Azure Resource Graph + ARM, read-only · run '+esc(meta.runId||'')+' generated '+esc((meta.generatedOn||'').slice(0,16).replace('T',' '))+' · Azure Scout '+esc(meta.productVersion||'')+'.</div>';
}

/* ============================================================
   PAGE: remediation plan
   ============================================================ */
function pageRoadmap(){
  var groups = {}, order = [];
  allFindings.filter(function(f){return f.status==='Fail';}).forEach(function(f){ if(!groups[f.area]){groups[f.area]=[];order.push(f.area);} groups[f.area].push(f); });
  var rows = order.map(function(area){
    var fs = groups[area].slice().sort(function(a,b){ return (sevRank.hasOwnProperty(a.severity)?sevRank[a.severity]:3)-(sevRank.hasOwnProperty(b.severity)?sevRank[b.severity]:3); });
    var top = fs.slice(0,3).map(function(f){
      var evn = safeArr(f.evidence).filter(function(e){return e.resourceName;}).length;
      var names = safeArr(f.evidence).filter(function(e){return e.resourceName;}).slice(0,2).map(function(e){return '<span class="mono">'+esc(e.resourceName)+'</span>';}).join(', ');
      return esc((f.title||'').replace(/\.$/,'')) + (evn?' ('+evn+' resource'+(evn===1?'':'s')+': '+names+(evn>2?', …':'')+')':'');
    }).join(' · ');
    var more = fs.length>3 ? ' · +'+(fs.length-3)+' more in the register' : '';
    return { area:area, cell: top+more, owner: teamFor(area), win: windowFor(fs[0].severity), sev: sevRank.hasOwnProperty(fs[0].severity)?sevRank[fs[0].severity]:3, count: fs.length };
  }).sort(function(a,b){ return a.sev-b.sev || b.count-a.count; });
  var trs = rows.map(function(r){ return '<tr><td><b>'+esc(r.area)+'</b><div class="q">'+r.count+' gap'+(r.count===1?'':'s')+'</div></td><td>'+r.cell+'</td><td>'+esc(r.owner)+'</td><td class="num">'+r.win+'</td></tr>'; }).join('');

  var wsGroups = {}, wsOrder = [];
  allFindings.filter(function(f){return f.status==='Fail';}).forEach(function(f){
    var k = teamFor(f.area);
    if(!wsGroups[k]){ wsGroups[k]=[]; wsOrder.push(k); }
    wsGroups[k].push(f);
  });
  var ws = wsOrder.map(function(team){
    var fs = wsGroups[team].slice().sort(function(a,b){ return (sevRank.hasOwnProperty(a.severity)?sevRank[a.severity]:3)-(sevRank.hasOwnProperty(b.severity)?sevRank[b.severity]:3); });
    var size = fs.length>12?'XL':fs.length>6?'M':'S';
    return '<tr><td><b>'+esc(team)+'</b></td><td>'+sevPill(fs[0].severity)+'</td><td>'+fs.slice(0,3).map(function(f){return esc((f.title||'').replace(/\.$/,''));}).join(' · ')+(fs.length>3?' · +'+(fs.length-3)+' more':'')+'</td><td class="num">'+size+'</td><td class="num">'+fs.length+'</td></tr>';
  }).join('');

  return '<h2>Remediation plan</h2><p class="lede">All '+counts.fail+' gaps appear here — grouped by design area for the 90-day plan, and by accountable team for the workstream view. Nothing is curated out.</p>'+
    '<details class="sect" open><summary><span class="part">90-day roadmap — by design area</span></summary><div class="twrap"><table><tr><th>Domain</th><th>Action</th><th>Owner</th><th>Window</th></tr>'+trs+'</table></div>'+
    '<div class="prov">Owner defaults from the design-area → team mapping; windows derive from the area\'s highest severity.</div></details>'+
    '<details class="sect" open><summary><span class="part">Workstreams — by accountable team</span></summary><div class="twrap"><table><tr><th>Workstream</th><th>Priority</th><th>Top actions</th><th class="num">Size</th><th class="num">Gaps</th></tr>'+ws+'</table></div></details>';
}

/* ============================================================
   DIAGRAM KERNEL (AB#6933) — collision-free layout primitives.
   Kept intact (same signatures/behaviour) because tests/
   ReactReport.DiagramOverlap.Tests.ps1 runs this kernel in a Node
   vm sandbox and asserts diagramNetworkTopology()/diagramMgHierarchy()
   never overlap a rect/edge — see tests/diagram-overlap-checker.mjs.
   ============================================================ */
var CHAR_NARROW = 'iIl.,:;\'!|  '.split('');
var CHAR_WIDE = 'mMW%@'.split('');
function charW(ch, fontSize){
  if(CHAR_NARROW.indexOf(ch) !== -1) return fontSize * 0.30;
  if(CHAR_WIDE.indexOf(ch) !== -1) return fontSize * 0.88;
  if(/[A-Z0-9]/.test(ch)) return fontSize * 0.62;
  return fontSize * 0.52;
}
function measureText(str, fontSize){
  str = str===null||str===undefined ? '' : String(str);
  var w = 0;
  for(var i=0;i<str.length;i++) w += charW(str[i], fontSize);
  return w * 1.10;
}
function wrapText(str, maxWidth, fontSize, maxLines){
  str = (str===null||str===undefined ? '' : String(str)).trim();
  maxLines = maxLines || 2;
  if(!str) return { lines: [''], truncated: false };
  var words = str.split(/\s+/);
  var lines = []; var cur = '';
  for(var i=0;i<words.length;i++){
    var candidate = cur ? cur + ' ' + words[i] : words[i];
    if(measureText(candidate, fontSize) <= maxWidth || !cur){
      cur = candidate;
    } else {
      lines.push(cur);
      cur = words[i];
      if(lines.length === maxLines - 1){
        var rest = words.slice(i).join(' ');
        while(measureText(cur + '…', fontSize) > maxWidth && cur.length > 1){ cur = cur.slice(0, -1); }
        lines.push(cur + (rest !== cur ? '…' : ''));
        return { lines: lines, truncated: true };
      }
    }
  }
  if(cur) lines.push(cur);
  return { lines: lines, truncated: false };
}
function autoSizeBox(label, opts){
  opts = opts || {};
  var fontSize = opts.fontSize || 11;
  var padX = opts.padX===undefined ? 12 : opts.padX;
  var padY = opts.padY===undefined ? 8 : opts.padY;
  var maxW = opts.maxWidth || 170;
  var maxLines = opts.maxLines || 2;
  var wrapped = wrapText(label, maxW - padX*2, fontSize, maxLines);
  var textW = 0;
  wrapped.lines.forEach(function(l){ textW = Math.max(textW, measureText(l, fontSize)); });
  var w = Math.max(opts.minWidth || 64, Math.min(maxW, textW + padX*2));
  var h = Math.max(opts.minHeight || 34, wrapped.lines.length * (fontSize + 5) + padY*2 - 5);
  return { w: w, h: h, lines: wrapped.lines, truncated: wrapped.truncated, fontSize: fontSize };
}
function svgBoxNode(x, y, box, cls, extraAttrs){
  var titleTag = box.truncated ? '<title>'+esc(box._full||'')+'</title>' : '';
  var lineH = box.fontSize + 5;
  var startY = y + box.h/2 - ((box.lines.length-1)*lineH)/2 + box.fontSize*0.32;
  var textLines = box.lines.map(function(l,i){
    return '<tspan x="'+(x+box.w/2)+'" y="'+(startY + i*lineH)+'">'+esc(l)+'</tspan>';
  }).join('');
  return '<g class="diag-node '+(cls||'')+'" '+(extraAttrs||'')+'>'+titleTag+
    '<rect x="'+x+'" y="'+y+'" width="'+box.w+'" height="'+box.h+'" rx="6"></rect>'+
    '<text text-anchor="middle" font-size="'+box.fontSize+'">'+textLines+'</text>'+
    '</g>';
}
function routeOrthogonal(nodes, from, to, cell){
  cell = cell || 10;
  var minX=Infinity,minY=Infinity,maxX=-Infinity,maxY=-Infinity;
  nodes.forEach(function(nd){ minX=Math.min(minX,nd.x); minY=Math.min(minY,nd.y); maxX=Math.max(maxX,nd.x+nd.w); maxY=Math.max(maxY,nd.y+nd.h); });
  minX -= cell*2; minY -= cell*2; maxX += cell*2; maxY += cell*2;
  var cols = Math.max(1, Math.ceil((maxX-minX)/cell));
  var rows = Math.max(1, Math.ceil((maxY-minY)/cell));
  function toCell(px,py){ return { c: Math.round((px-minX)/cell), r: Math.round((py-minY)/cell) }; }
  function toPoint(c,r){ return { x: minX + c*cell, y: minY + r*cell }; }
  var blocked = {};
  nodes.forEach(function(nd){
    if(nd.id === from.id || nd.id === to.id) return;
    var c0 = Math.floor((nd.x-minX)/cell), c1 = Math.ceil((nd.x+nd.w-minX)/cell);
    var r0 = Math.floor((nd.y-minY)/cell), r1 = Math.ceil((nd.y+nd.h-minY)/cell);
    for(var r=r0;r<=r1;r++) for(var c=c0;c<=c1;c++) blocked[c+','+r] = true;
  });
  var start = toCell(from.x+from.w/2, from.y+from.h);
  var goal  = toCell(to.x+to.w/2, to.y);
  start.c = Math.max(0,Math.min(cols,start.c)); start.r = Math.max(0,Math.min(rows,start.r));
  goal.c = Math.max(0,Math.min(cols,goal.c)); goal.r = Math.max(0,Math.min(rows,goal.r));
  var key = function(c,r){ return c+','+r; };
  var came = {}; var visited = {};
  var queue = [{ c:start.c, r:start.r, dir:null }];
  visited[key(start.c,start.r)] = true;
  var dirs = [[0,-1],[0,1],[-1,0],[1,0]];
  var found = false;
  while(queue.length){
    var cur = queue.shift();
    if(cur.c === goal.c && cur.r === goal.r){ found = true; break; }
    for(var d=0; d<dirs.length; d++){
      var nc = cur.c + dirs[d][0], nr = cur.r + dirs[d][1];
      if(nc<0||nr<0||nc>cols||nr>rows) continue;
      var k = key(nc,nr);
      if(visited[k]) continue;
      if(blocked[k] && !(nc===goal.c && nr===goal.r)) continue;
      visited[k] = true;
      came[k] = key(cur.c,cur.r);
      queue.push({ c:nc, r:nr, dir:d });
    }
  }
  var pathCells = [];
  if(found){
    var ck = key(goal.c,goal.r);
    pathCells.push(goal);
    while(ck !== key(start.c,start.r)){
      var prevKey = came[ck];
      if(!prevKey) break;
      var parts = prevKey.split(',');
      var pc = { c: parseInt(parts[0],10), r: parseInt(parts[1],10) };
      pathCells.push(pc);
      ck = prevKey;
    }
    pathCells.reverse();
  } else {
    pathCells = [start, goal];
  }
  var pts = pathCells.map(function(c){ return toPoint(c.c, c.r); });
  var simplified = [pts[0]];
  for(var i=1;i<pts.length-1;i++){
    var a=simplified[simplified.length-1], b=pts[i], c=pts[i+1];
    var sameDir = (a.x===b.x && b.x===c.x) || (a.y===b.y && b.y===c.y);
    if(!sameDir) simplified.push(b);
  }
  simplified.push(pts[pts.length-1]);
  return simplified;
}
function polyline(points, cls){
  return '<polyline class="diag-edge '+(cls||'')+'" points="'+points.map(function(p){return p.x+','+p.y;}).join(' ')+'"></polyline>';
}
function layoutTree(roots, childrenOf, boxOf, hGap, vGap){
  hGap = hGap || 16; vGap = vGap || 60;
  var placed = [];
  var cursorX = 0;
  function place(node, depth){
    var kids = childrenOf(node);
    var box = boxOf(node);
    if(!kids.length){
      var x = cursorX;
      cursorX += box.w + hGap;
      placed.push({ node: node, box: box, x: x, y: depth*vGap, cx: x + box.w/2 });
      return x + box.w/2;
    }
    var childCenters = kids.map(function(k){ return place(k, depth+1); });
    var myCx = (childCenters[0] + childCenters[childCenters.length-1]) / 2;
    placed.push({ node: node, box: box, x: myCx - box.w/2, y: depth*vGap, cx: myCx });
    return myCx;
  }
  roots.forEach(function(r){ place(r, 0); });
  return placed;
}
function placeRingLabels(items, cx, cy, r){
  var placed = items.map(function(it){ return { angle: it.angle, text: it.text, box: autoSizeBox(it.text, { fontSize:10, maxWidth:120, maxLines:1, padX:4, padY:2 }) }; });
  placed.sort(function(a,b){ return a.angle - b.angle; });
  var minGapDeg = 9;
  for(var pass=0; pass<placed.length*2; pass++){
    var changed = false;
    for(var i=1;i<placed.length;i++){
      if(placed[i].angle - placed[i-1].angle < minGapDeg){
        placed[i].angle = placed[i-1].angle + minGapDeg;
        changed = true;
      }
    }
    if(!changed) break;
  }
  return placed.map(function(p){
    var rad = p.angle * Math.PI / 180;
    return { x: cx + r * Math.cos(rad), y: cy + r * Math.sin(rad), text: p.text, box: p.box };
  });
}

/* ---- the two kernel-based diagrams (MG hierarchy, VNets & subnets) ---- */
function diagramNetworkTopology(){
  var vnets = safeArr((inventory['networking.virtualNetworks']||{}).rows);
  var subnets = safeArr((inventory['networking.subnets']||{}).rows);
  if(!vnets.length) return null;
  var nodes = []; var edges = [];
  var colW = 260, colX0 = 20, vnetY = 20;
  vnets.forEach(function(v, i){
    var box = autoSizeBox(v.name || ('VNet '+i), { maxWidth:190, fontSize:11 });
    box._full = v.name;
    var vx = colX0 + i*colW;
    var id = 'vnet-'+i;
    nodes.push({ id:id, x:vx, y:vnetY, w:box.w, h:box.h, box:box, cls:'vnet', gopane:catId('networking.virtualNetworks') });
    var mySubnets = subnets.filter(function(s){ return s.vnet === v.name; });
    mySubnets.forEach(function(s, j){
      var sbox = autoSizeBox(s.subnet || ('Subnet '+j), { maxWidth:180, fontSize:10.5 });
      sbox._full = s.subnet;
      var sid = id+'-sn-'+j;
      nodes.push({ id:sid, x:vx + (box.w-sbox.w)/2, y: vnetY + box.h + 50 + j*(sbox.h+34), w:sbox.w, h:sbox.h, box:sbox, cls:'subnet', gopane:catId('networking.subnets') });
      edges.push({ from:id, to:sid });
    });
  });
  var maxX=0, maxY=0;
  nodes.forEach(function(nd){ maxX=Math.max(maxX,nd.x+nd.w); maxY=Math.max(maxY,nd.y+nd.h); });
  var byId = {}; nodes.forEach(function(nd){ byId[nd.id]=nd; });
  var edgeSvg = edges.map(function(e){
    var pts = routeOrthogonal(nodes, byId[e.from], byId[e.to], 10);
    return polyline(pts);
  }).join('');
  var nodeSvg = nodes.map(function(nd){ return svgBoxNode(nd.x, nd.y, nd.box, nd.cls, 'data-gopane="'+nd.gopane+'"'); }).join('');
  return {
    width: maxX+30, height: maxY+30,
    svg: '<svg viewBox="0 0 '+(maxX+30)+' '+(maxY+30)+'" width="100%" style="max-width:'+(maxX+30)+'px">'+
      '<g fill="var(--primary-tint)" stroke="var(--primary)">'+edgeSvg+nodeSvg+'</g></svg>',
    legend: [['VNet','var(--primary)'],['Subnet','var(--accent)']]
  };
}
function buildMgTree(mgs){
  var byName = {};
  mgs.forEach(function(m){ byName[m.name] = { name:m.name, displayName:m.displayName, parent:m.parent, id:m.id, children:[] }; });
  var roots = [];
  mgs.forEach(function(m){
    var node = byName[m.name];
    if(m.parent && byName[m.parent]) byName[m.parent].children.push(node);
    else roots.push(node);
  });
  return roots;
}
function diagramMgHierarchy(){
  var mgs = safeArr((inventory['governance.managementGroups']||{}).rows);
  if(!mgs.length) return null;
  var roots = buildMgTree(mgs);
  var boxOf = function(node){ var b = autoSizeBox(node.displayName || node.name, { maxWidth:170, fontSize:11 }); b._full = node.displayName||node.name; return b; };
  var placed = layoutTree(roots, function(nd){ return nd.children; }, boxOf, 18, 64);
  var maxX=0, maxY=0;
  placed.forEach(function(p){ maxX=Math.max(maxX,p.x+p.box.w); maxY=Math.max(maxY,p.y+p.box.h); });
  var byNode = {}; placed.forEach(function(p){ byNode[p.node.name] = p; });
  var gridNodes = placed.map(function(p){ return { id:p.node.name, x:p.x, y:p.y, w:p.box.w, h:p.box.h }; });
  var edgeSvg = '';
  placed.forEach(function(p){
    (p.node.children||[]).forEach(function(child){
      var c = byNode[child.name];
      if(!c) return;
      var pts = routeOrthogonal(gridNodes, gridNodes.filter(function(g){return g.id===p.node.name;})[0], gridNodes.filter(function(g){return g.id===child.name;})[0], 10);
      edgeSvg += polyline(pts);
    });
  });
  var nodeSvg = placed.map(function(p){ return svgBoxNode(p.x, p.y, p.box, 'mg', 'data-gopane="inv-structure"'); }).join('');
  return {
    width:maxX+30, height:maxY+30,
    svg:'<svg viewBox="0 0 '+(maxX+30)+' '+(maxY+30)+'" width="100%" style="max-width:'+(maxX+30)+'px">'+
      '<g fill="var(--primary-tint)" stroke="var(--primary)">'+edgeSvg+nodeSvg+'</g></svg>',
    legend: [['Management group','var(--primary)']]
  };
}

/* ---- simple bar-chart diagrams (estate top-10 / gaps by area) ---- */
function svgWrap(id, title, caption, inner, w, h){
  return '<div class="dgm" id="dg-'+id+'"><div class="dgmhead"><b>'+esc(title)+'</b><button class="btn dgmfull" data-dgm="dg-'+id+'">⛶ Full screen</button></div>'+
    '<div class="fig"><svg viewBox="0 0 '+w+' '+h+'" width="100%" role="img" aria-label="'+esc(title)+'">'+inner+'</svg><div class="cap">'+caption+'</div></div></div>';
}
function diagMgTreeBlade(){
  var d = diagramMgHierarchy();
  if(!d) return '<p class="lede">No management groups collected in this run.</p>';
  var mgRows = safeArr((inventory['governance.managementGroups']||{}).rows);
  return svgWrap('mg','Management-group hierarchy', mgRows.length+' management groups, drawn from governance.managementGroups. Click a node to open Tenant structure.', d.svg.replace(/^<svg[^>]*>|<\/svg>$/g,''), d.width, d.height);
}
function diagNetworkBlade(){
  var d = diagramNetworkTopology();
  if(!d) return '<p class="lede">No virtual networks collected in this run.</p>';
  var vnets = safeArr((inventory['networking.virtualNetworks']||{}).rows).length;
  var subnets = safeArr((inventory['networking.subnets']||{}).rows).length;
  return svgWrap('net','Virtual networks & subnets', vnets+' VNets, '+subnets+' subnets. Click to open the Networking inventory.', d.svg.replace(/^<svg[^>]*>|<\/svg>$/g,''), d.width, d.height);
}
function diagEstateBars(){
  if(!invSorted.length) return '<p class="lede">No inventory categories with data in this run.</p>';
  var top = invSorted.slice(0,10);
  var max = top[0][1].count, rowH = 30, w = 720, lw = 240;
  var out = '';
  top.forEach(function(p,i){
    var k=p[0], v=p[1];
    var y = 12 + i*rowH, bwid = Math.max(3, (w-lw-90) * v.count/max);
    out += '<g class="diag-node" data-gopane="'+catId(k)+'"><text x="'+lw+'" y="'+(y+14)+'" text-anchor="end" fill="var(--ink)" font-size="11.5">'+esc(catLeaf(v.label||k))+'</text>'+
      '<rect x="'+(lw+12)+'" y="'+y+'" width="'+bwid+'" height="19" rx="4" fill="var(--primary)"></rect>'+
      '<text x="'+(lw+20+bwid)+'" y="'+(y+14)+'" fill="var(--muted)" font-size="11">'+n(v.count)+'</text></g>';
  });
  return svgWrap('estate','Estate — top categories', 'Top 10 inventory categories by item count. Click a bar to open that category.', out, w, 12+top.length*rowH+8);
}
function diagSeverity(){
  var a = assessments[0];
  if(!a) return '<p class="lede">No assessments ran in this run.</p>';
  var areas = dedupeAreas(a.areas).map(function(ar){ return { ar:ar, st:areaStats(a,ar.name) }; }).filter(function(x){ return x.st.fail>0; })
    .sort(function(x,y){ return y.st.fail-x.st.fail; }).slice(0,10);
  if(!areas.length) return '<p class="lede">No gaps in '+esc(a.name)+'.</p>';
  var max = Math.max.apply(null, areas.map(function(x){return x.st.fail;})), rowH = 30, w = 720, lw = 250;
  var out = '';
  areas.forEach(function(x,i){
    var ar = x.ar, st = x.st;
    var y = 12 + i*rowH;
    var fails = safeArr(a.findings).filter(function(f){ return f.area===ar.name && f.status==='Fail'; });
    var hi = fails.filter(function(f){return f.severity==='high';}).length;
    var med = fails.filter(function(f){return f.severity==='medium';}).length;
    var lo = st.fail - hi - med;
    var unit = (w-lw-90)/max;
    var xcur = lw+12;
    out += '<g class="diag-node" data-gopage="a-'+a.slug+'"><text x="'+lw+'" y="'+(y+14)+'" text-anchor="end" fill="var(--ink)" font-size="11.5">'+esc(ar.name)+'</text>';
    [[hi,'var(--band-crit)'],[med,'var(--band-mod)'],[lo,'var(--low)']].forEach(function(pair){
      var cnt = pair[0], col = pair[1];
      if(cnt>0){ out += '<rect x="'+xcur+'" y="'+y+'" width="'+Math.max(2,cnt*unit-2)+'" height="19" rx="3" fill="'+col+'"></rect>'; xcur += cnt*unit; }
    });
    out += '<text x="'+(xcur+8)+'" y="'+(y+14)+'" fill="var(--muted)" font-size="11">'+st.fail+'</text></g>';
  });
  return svgWrap('sev','Gaps by design area — '+esc(a.name), 'Not-met checks per area, split high / medium / low. Click to open the assessment register.', out, w, 12+areas.length*rowH+8);
}
/* ---- AB#7050-7058 four additional network diagrams (VNet connectivity,
   hybrid site-to-site, private link & DNS, internet exposure). Ported from
   src/report/renderers/react/diagram-*.mjs -- esc/catId/svgWrap/safeArr are
   already defined above in this same script, so the modules' own duplicate
   copies of those helpers are dropped here; everything else is a direct
   port reading straight off the global `inventory` bag. ---- */
function diagVnetTopology(){
  var vnets = safeArr((inventory['networking.virtualNetworks']||{}).rows);
  var subnets = safeArr((inventory['networking.subnets']||{}).rows);
  var gws = safeArr((inventory['networking.vpnGateways']||{}).rows);
  if(!vnets.length) return '';

  var gwRg = gws.length ? gws[0].resourceGroup : null;
  var hub = vnets.find(function(v){ return gwRg && v.resourceGroup === gwRg; })
    || vnets.find(function(v){ return subnets.some(function(s){ return s.vnet === v.name && /gateway/i.test(s.subnet); }); })
    || vnets[0];
  var spokes = vnets.filter(function(v){ return v !== hub; });

  var w = 860, cx = w/2, cy = 210, hubW = 240, hubH = 78;
  var out = '';

  if(gws.length){
    var g = gws[0];
    out += '<g class="diag-node" data-gopane="'+catId('networking.vpnGateways')+'">'+
      '<rect x="'+(cx-110)+'" y="14" width="220" height="52" rx="8" fill="var(--surface)" stroke="var(--accent)" stroke-width="1.5" stroke-dasharray="5 3"/>'+
      '<text x="'+cx+'" y="34" text-anchor="middle" fill="var(--ink)" font-weight="700" font-size="12">'+esc(g.name)+'</text>'+
      '<text x="'+cx+'" y="50" text-anchor="middle" fill="var(--muted)" font-size="10.5">'+esc(g.gatewayType)+' · '+esc(g.sku)+' · BGP '+(g.bgp?'on':'off')+' · '+(g.activeActive?'active-active':'⚠ single instance')+'</text></g>'+
      '<path d="M '+cx+' 66 V '+(cy-hubH/2)+'" stroke="var(--accent)" stroke-width="2" fill="none"/>';
  }

  var hubSubs = subnets.filter(function(s){ return s.vnet === hub.name; });
  out += '<g class="diag-node" data-gopane="'+catId('networking.virtualNetworks')+'">'+
    '<rect x="'+(cx-hubW/2)+'" y="'+(cy-hubH/2)+'" width="'+hubW+'" height="'+hubH+'" rx="9" fill="var(--primary-tint)" stroke="var(--primary)" stroke-width="2.5"/>'+
    '<text x="'+cx+'" y="'+(cy-16)+'" text-anchor="middle" fill="var(--primary)" font-weight="800" font-size="10">HUB</text>'+
    '<text x="'+cx+'" y="'+(cy+2)+'" text-anchor="middle" fill="var(--ink)" font-weight="700" font-size="12">'+esc(hub.name)+'</text>'+
    '<text x="'+cx+'" y="'+(cy+19)+'" text-anchor="middle" fill="var(--muted)" font-size="10.5">'+hubSubs.length+' subnet'+(hubSubs.length===1?'':'s')+' · '+(hub.peeringCount||0)+' peering'+((hub.peeringCount||0)===1?'':'s')+' · DDoS '+(hub.ddosEnabled?'on':'off')+'</text></g>';

  var sw = 210, gap = 22, totalW = spokes.length*sw + (spokes.length-1)*gap;
  var sx = cx - totalW/2, sy = cy + 130;
  spokes.forEach(function(s){
