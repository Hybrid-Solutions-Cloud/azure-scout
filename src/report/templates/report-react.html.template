  var targets=tcPeTargets(),out='',W=1200;
  stores.forEach(function(s,i){var y=20+i*285,location=tcRegionLoc(tcLocation(s))||'Region unknown',hasPe=!!targets[tcId(s)],deny=tcValue(s,['networkDefaultDeny','Default Action','Network Default Action']),tls=tcValue(s,['minTls','Minimum TLS Version','minimumTlsVersion']);
    out+=tcText(20,y+18,tcTrunc(tcName(s)+' · '+location,105),{fs:13,fw:800});
    function lane(ly,label,kind,observed){var color=observed?'var(--primary)':'var(--band-mod)';out+=tcText(20,ly,label,{fs:10,fw:800});
      out+=tcBox(20,ly+12,210,68,{fill:'var(--primary-tint)'})+tcText(125,ly+38,'Client / site',{anchor:'middle',fw:800})+tcText(125,ly+59,'Source network not established',{anchor:'middle',fs:9});
      out+=tcArrow(233,ly+47,315,ly+47,color,observed?null:'5 4');
      out+=tcBox(320,ly+12,300,68,{stroke:color})+tcText(470,ly+38,kind,{anchor:'middle',fw:800})+tcText(470,ly+59,observed?'Association collected':'Requires design and validation',{anchor:'middle',fs:9,fill:'var(--muted)'});
      out+=tcArrow(623,ly+47,705,ly+47,color,observed?null:'5 4');
      out+=tcNode('domains.storage.storageAccounts',tcBox(710,ly+12,470,68,{stroke:color})+tcText(725,ly+35,tcTrunc(tcName(s),55),{fw:800})+tcText(725,ly+57,location+' · minimum TLS: '+(tls||'unknown'),{fs:9.5}));}
    lane(y+42,'Collected endpoint configuration',hasPe?'Private endpoint association':'Public endpoint configuration',hasPe);
    lane(y+153,'Private endpoint placement review','VNet, private DNS and routing',false);
    out+=tcText(20,y+257,'Network default: '+(deny===true?'Deny':deny===false?'Allow':deny||'unknown')+'. Choose endpoint placement from actual site, VNet, DNS and routing requirements; geographic detours are not assumed.',{fs:9.5,fill:'var(--muted)'});
  });
  return svgWrap('asiastore','Regional storage access — private endpoint trade-offs','Current evidence and a clearly labeled private-access design review, using each account’s real region. A missing endpoint row is not proof of public reachability.',out,W,35+stores.length*285);
}

