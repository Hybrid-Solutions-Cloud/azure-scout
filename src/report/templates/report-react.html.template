  document.getElementById('about-toggle').onclick = function(){ document.getElementById('about-overlay').classList.add('open'); };
  document.getElementById('about-close').onclick = function(){ document.getElementById('about-overlay').classList.remove('open'); };
  document.getElementById('about-overlay').onclick = function(e){ if(e.target.id==='about-overlay') e.currentTarget.classList.remove('open'); };
}

function wireInteractions(){
  document.addEventListener('keydown',function(e){var r=e.target.closest && e.target.closest('tr.rowclick');if(r && (e.key==='Enter'||e.key===' ')){e.preventDefault();showRowPopup(r.getAttribute('data-rk'),Number(r.getAttribute('data-ri')));}});
  document.querySelectorAll('[data-inventory-export]').forEach(function(b){b.addEventListener('click',function(){var k=b.getAttribute('data-inventory-export');dl(filenamePrefix()+'-'+k.replace(/[^a-z0-9_-]/gi,'-')+'.csv',buildCsvInventory(k),'text/csv');});});
  document.querySelectorAll('.nav').forEach(function(b){ b.addEventListener('click', function(){ setPage(b.getAttribute('data-page')); }); });

  document.querySelectorAll('.vbtn').forEach(function(b){
    b.addEventListener('click', function(){
      var v = b.getAttribute('data-view');
      document.body.setAttribute('data-view', v);
      document.querySelectorAll('.vbtn').forEach(function(x){ x.classList.toggle('on', x===b); });
      if(v==='data') document.querySelectorAll('details').forEach(function(d){ d.open = true; });
    });
  });

  document.querySelectorAll('.invgo').forEach(function(a){
    a.addEventListener('click', function(ev){ ev.preventDefault(); invSelect(a.getAttribute('data-pane')); });
  });

  document.querySelectorAll('a.goto').forEach(function(a){
    a.addEventListener('click', function(ev){
      ev.preventDefault();
      setPage(a.getAttribute('data-gopage'));
      var hash = a.getAttribute('href');
      if(hash && hash!=='#top'){
        var p = hash.slice(1);
        if(document.getElementById('pane-'+p)){ invSelect(p); return; }
        var el = document.querySelector(hash);
        if(el){
          var d = el.closest('details'); if(d) d.open = true;
          if(el.tagName==='DETAILS') el.open = true;
          el.scrollIntoView({ block:'start' });
        }
      }
    });
  });

  document.querySelectorAll('a[href^="#"]:not(.goto)').forEach(function(a){
    a.addEventListener('click', function(){
      var hh = a.getAttribute('href') || '', el = null;
      if(hh.length > 1){ try { el = document.querySelector(hh); } catch(e){ el = null; } }
      if(el){ var d = el.closest('details'); if(d) d.open = true; if(el.tagName==='DETAILS') el.open = true; }
    });
  });

  document.querySelectorAll('.dgmgo').forEach(function(a){
    a.addEventListener('click', function(ev){ ev.preventDefault(); dgmSelect(a.getAttribute('data-dpane')); });
  });

  document.querySelectorAll('.diag-node').forEach(function(g){
    g.addEventListener('click', function(){
      var pane = g.getAttribute('data-gopane'), page = g.getAttribute('data-gopage');
      if(pane){ setPage('inv'); invSelect(pane); }
      else if(page){ setPage(page); }
    });
  });

  document.querySelectorAll('.dgmfull').forEach(function(b){
    b.addEventListener('click', function(){
      var src = document.getElementById(b.getAttribute('data-dgm')).querySelector('svg');
      var ov = document.createElement('div'); ov.className = 'dgoverlay';
      ov.innerHTML = '<div class="bar"><button class="btn" data-z="in">＋ Zoom</button><button class="btn" data-z="out">－ Zoom</button><button class="btn" data-z="fit">Fit</button>'+
        '<span class="m" style="color:var(--faint);font-size:11.5px">wheel = zoom · drag = pan · Esc = close</span><button class="btn" data-z="x" style="margin-left:auto">✕ Close</button></div><div class="stage"></div>';
      var stage = ov.querySelector('.stage'); var svg = src.cloneNode(true); stage.appendChild(svg);
      document.body.appendChild(ov);
      var sc=1, tx=0, ty=0;
      function apply(){ svg.style.transform = 'translate('+tx+'px,'+ty+'px) scale('+sc+')'; }
      function fit(){ sc = Math.min(stage.clientWidth/svg.viewBox.baseVal.width, stage.clientHeight/svg.viewBox.baseVal.height)*0.95; tx=10; ty=10; svg.setAttribute('width', svg.viewBox.baseVal.width); svg.removeAttribute('height'); apply(); }
      fit();
      ov.querySelector('.bar').addEventListener('click', function(e){
        var z = e.target.getAttribute && e.target.getAttribute('data-z');
        if(z==='in') sc*=1.25; else if(z==='out') sc/=1.25; else if(z==='fit') return fit(); else if(z==='x') return ov.remove();
        apply();
      });
      stage.addEventListener('wheel', function(e){ e.preventDefault(); sc *= e.deltaY<0 ? 1.15 : 0.87; apply(); }, { passive:false });
      var drag = null;
      stage.addEventListener('mousedown', function(e){ drag = [e.clientX-tx, e.clientY-ty]; stage.style.cursor='grabbing'; });
      window.addEventListener('mousemove', function(e){ if(drag){ tx=e.clientX-drag[0]; ty=e.clientY-drag[1]; apply(); } });
      window.addEventListener('mouseup', function(){ drag=null; stage.style.cursor='grab'; });
      function escKey(e){ if(e.key==='Escape'){ ov.remove(); window.removeEventListener('keydown', escKey); } }
      window.addEventListener('keydown', escKey);
    });
  });

  document.addEventListener('click', function(e){
    var tr = e.target.closest && e.target.closest('tr.rowclick');
    if(!tr || e.target.closest('a,input,button')) return;
    showRowPopup(tr.getAttribute('data-rk'), parseInt(tr.getAttribute('data-ri'),10));
  });
  document.querySelectorAll('.catwrap').forEach(function(w){
    var input = w.querySelector('.tfilter'), table = w.querySelector('table');
    if(!table) return;
    if(input) input.addEventListener('input', function(){
      var q = input.value.toLowerCase();
      [].slice.call(table.rows).slice(1).forEach(function(tr){ tr.style.display = (JSON.stringify((ROWREG[tr.getAttribute('data-rk')]||[])[Number(tr.getAttribute('data-ri'))])||tr.textContent).toLowerCase().indexOf(q)>=0 ? '' : 'none'; });
    });
    [].slice.call(table.rows[0].cells).forEach(function(th, ci){
      th.style.cursor='pointer'; th.title='Click to sort';
      th.addEventListener('click', function(){
        var rows = [].slice.call(table.rows).slice(1);
        var dir = th.getAttribute('data-dir')==='asc' ? -1 : 1;
        [].slice.call(table.rows[0].cells).forEach(function(x){ x.removeAttribute('data-dir'); });
        th.setAttribute('data-dir', dir===1 ? 'asc' : 'desc');
        rows.sort(function(a,b){
          var x = (a.cells[ci]||{}).textContent||'', y = (b.cells[ci]||{}).textContent||'';
          var nx = parseFloat(x.replace(/,/g,'')), ny = parseFloat(y.replace(/,/g,''));
          if(!isNaN(nx) && !isNaN(ny)) return (nx-ny)*dir;
          return x.localeCompare(y)*dir;
        });
        rows.forEach(function(r){ r.parentNode.appendChild(r); });
      });
    });
  });

  var tb = document.getElementById('themebtn');
  tb.addEventListener('click', function(){
    var r = document.documentElement;
    var cur = r.getAttribute('data-theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    var next = cur==='dark' ? 'light' : 'dark';
    r.setAttribute('data-theme', next);
    tb.textContent = next==='dark' ? '◐ Theme: dark' : '◑ Theme: light';
    try{ localStorage.setItem('scout-report-theme', next); }catch(e){}
  });

  var eb = document.getElementById('exportbtn'), em = document.getElementById('exportmenu');
  eb.addEventListener('click', function(ev){ ev.stopPropagation(); em.classList.toggle('open'); });
  document.addEventListener('click', function(){ em.classList.remove('open'); });
  em.addEventListener('click', function(ev){
    var x = ev.target.getAttribute && ev.target.getAttribute('data-x');
    if(!x) return;
    em.classList.remove('open');
    if(x==='md') dl(filenamePrefix()+'.md', buildMarkdownExport(), 'text/markdown');
    else if(x==='json') dl(filenamePrefix()+'.json', buildJsonExport(), 'application/json');
    else if(x==='csv-findings') dl('findings.csv', buildCsvFindingsForCurrentAssessment() || buildCsvFindings());
    else if(x==='csv-evidence') dl('evidence.csv', buildCsvEvidence());
    else if(x==='print') window.print();
    else if(x==='html') dl(filenamePrefix()+'.html', '<!doctype html>'+document.documentElement.outerHTML, 'text/html');
  });
}
function filenamePrefix(){
  var parts = [identity.clientName, identity.reportTitle].filter(Boolean).join(' - ') || 'azure-scout-report';
  return parts.replace(/[\\/:*?"<>|]/g, '-').trim();
}

function loadPersistedTheme(){
  try{
    var t = localStorage.getItem('scout-report-theme');
    if(t){ document.documentElement.setAttribute('data-theme', t); var tb = document.getElementById('themebtn'); if(tb) tb.textContent = t==='dark' ? '◐ Theme: dark' : '◑ Theme: light'; }
  }catch(e){}
}
function initialView(){
  var m = meta.defaultMode;
  return m==='executive' ? 'exec' : m==='data' ? 'data' : 'cons';
}

function boot(){
  assemble();
  var v = initialView();
  document.body.setAttribute('data-view', v);
  document.querySelectorAll('.vbtn').forEach(function(b){ b.classList.toggle('on', b.getAttribute('data-view')===v); });
  initAbout();
  wireInteractions();
  loadPersistedTheme();
}
if(document.readyState === 'loading'){
  document.addEventListener('DOMContentLoaded', boot);
} else {
  boot();
}

/* exposed for the Node-based diagram overlap checker test (tests/) */
window.__SCOUT_DIAGRAM_KERNEL__ = {
  measureText: measureText, wrapText: wrapText, autoSizeBox: autoSizeBox,
  routeOrthogonal: routeOrthogonal, layoutTree: layoutTree, placeRingLabels: placeRingLabels,
  diagramNetworkTopology: diagramNetworkTopology, diagramMgHierarchy: diagramMgHierarchy,
  diagVnetTopology: diagVnetTopology, diagHybrid: diagHybrid, diagPrivateLink: diagPrivateLink, diagExposure: diagExposure,
  diagEdgeDelivery: diagEdgeDelivery, diagRouting: diagRouting,
  diagRegions:diagRegions, diagTrafficFlow:diagTrafficFlow, diagSdwanHa:diagSdwanHa, diagBackupCoverage:diagBackupCoverage, diagTwoPaths:diagTwoPaths, diagRegionalStorage:diagAsiaStorage,
  keyCat:keyCat, categoryBlocksFor:categoryBlocksFor, buildCsvInventory:buildCsvInventory, buildJsonExport:buildJsonExport
};
})();
</script>
