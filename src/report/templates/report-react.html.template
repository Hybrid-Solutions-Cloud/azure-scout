    '<div class="pg pg-inv">'+pageInventory()+'</div>'+
    '<div class="pg pg-as">'+pageAssessments()+'</div>'+
    assessments.map(function(a){ return '<div class="pg" data-assessment-page="a-'+a.slug+'">'+pageAssessment(a)+'</div>'; }).join('')+
    '<div class="pg pg-dgm">'+pageDiagrams()+'</div>'+
    '<div class="pg pg-data">'+pageData()+'</div>'+
    '<div class="pg pg-road">'+pageRoadmap()+'</div>';

  var note = '<div class="note"><b>'+esc(documentTitle())+'.</b> Overview → Inventory &amp; audit (sidebar per category, every category opens its item table) → Assessments (choose one, open its full register: all checks, a gap block for every fail, manual agenda) → Diagrams → Data &amp; drift → Remediation plan.</div>';

  document.getElementById('app').innerHTML = '<div class="page">'+note+topbar+pages+'</div>';
}

/* ============================================================
   WIRE — page/nav/blade interactions (ported behaviour from the
   approved mockup's own <script> section).
   ============================================================ */
function setPage(p){
  document.body.setAttribute('data-page', p);
  var navKey = p.indexOf('a-')===0 ? 'as' : p;
  document.querySelectorAll('.nav').forEach(function(x){ x.classList.toggle('on', x.getAttribute('data-page')===navKey); });
  document.querySelectorAll('.pg[data-assessment-page]').forEach(function(x){ x.classList.toggle('on', x.getAttribute('data-assessment-page')===p); });
  window.scrollTo(0,0);
}
function invSelect(p){
  document.querySelectorAll('.invpane').forEach(function(x){ x.classList.toggle('on', x.id==='pane-'+p); });
  document.querySelectorAll('.sideitem').forEach(function(x){ x.classList.toggle('on', x.getAttribute('data-pane')===p); });
}
function dgmSelect(p){
  document.querySelectorAll('.dgmpane').forEach(function(x){ x.classList.toggle('on', x.id==='pane-'+p); });
  document.querySelectorAll('.dgmgo').forEach(function(x){ x.classList.toggle('on', x.getAttribute('data-dpane')===p); });
}
function showExportWarning(msg){
  var el = document.getElementById('export-warning');
  el.textContent = msg; el.style.display = 'block';
  setTimeout(function(){ el.style.display='none'; }, 6000);
}
function dl(name, text, type){
  try{
    var b = new Blob([text], { type: type||'text/csv' });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(b); a.download = name;
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(function(){ URL.revokeObjectURL(a.href); }, 4000);
  }catch(e){
    showExportWarning('This document is embedded in a sandbox that blocks file downloads. Open the report in a full browser tab to export.');
  }
}

/* ---- exports built at runtime from the live payload (the mockup builds these once at
   Node build time; here they must be rebuilt in-browser since the payload is only known
   client-side). Content/shape mirrors the mockup's MD_EXPORT/JSON_EXPORT/CSV_* literals. */
function buildMarkdownExport(){
  var md = [];
  md.push('# '+(identity.reportTitle||'Azure Inventory and Assessment'));
  md.push('\n'+(identity.clientName||'')+' · '+(identity.classification||'')+' · run '+(meta.runId||'')+' · generated '+(meta.generatedOn||'').slice(0,16).replace('T',' '));
  md.push('\n**'+counts.total+' CAF/WAF checks evaluated** — '+counts.pass+' met, '+counts.fail+' not met ('+counts.high+' high severity), '+counts.manual+' manual review. Estate: '+n(invTotal)+' items across '+subscriptions.length+' subscriptions.');
  assessments.forEach(function(a){
    var s = a.score || {};
    md.push('\n## '+a.name);
    md.push('\n'+(a.framework||''));
    if(s.percent!=null) md.push('\nScore: **'+s.percent+' / 100** — '+(s.formula||''));
    dedupeAreas(a.areas).forEach(function(ar){
      var st = areaStats(a, ar.name);
      if(!st.findings.length) return;
      md.push('\n### '+ar.name+(ar.percent!=null?' — '+ar.percent+' / 100':' — manual only'));
      md.push('\n| Check | Title | Severity | Result | Evidence |\n|---|---|---|---|---|');
      st.findings.forEach(function(f){ md.push('| '+shortId(f.id)+' | '+(f.title||'').replace(/\|/g,'/')+' | '+f.severity+' | '+(f.status==='Fail'?'Not met':f.status==='Pass'?'Met':'Manual')+' | '+(f.evidenceCount||0)+' |'); });
      st.findings.filter(function(f){return f.status==='Fail';}).forEach(function(f){
        md.push('\n#### ✗ '+f.title+' ('+shortId(f.id)+', '+f.severity+')');
        var ev = safeArr(f.evidence).filter(function(e){return e.resourceName;});
        md.push(ev.length ? '\nAffected: '+ev.map(function(e){return '`'+e.resourceName+'`';}).join(', ') : '\nNothing in scope satisfies this check — the gap is the absence itself.');
        md.push('\n**Fix:** '+f.remediation);
        md.push('\n[Microsoft guidance]('+betterLearnUrl(f)+')');
      });
      var ms = st.findings.filter(function(f){return f.status!=='Pass' && f.status!=='Fail';});
      if(ms.length){ md.push('\n**Manual review agenda:**'); ms.forEach(function(f){ md.push('- '+f.title+' — '+f.remediation); }); }
    });
  });
  md.push('\n## Remediation plan\n\n| Domain | Gaps | Owner | Window |\n|---|---|---|---|');
  var groups = {}, order = [];
  allFindings.filter(function(f){return f.status==='Fail';}).forEach(function(f){ if(!groups[f.area]){groups[f.area]=[];order.push(f.area);} groups[f.area].push(f); });
  order.forEach(function(area){
    var fs = groups[area];
    var sorted = fs.slice().sort(function(x,y){ return (sevRank.hasOwnProperty(x.severity)?sevRank[x.severity]:3)-(sevRank.hasOwnProperty(y.severity)?sevRank[y.severity]:3); });
    md.push('| '+area+' | '+fs.length+': '+fs.slice(0,3).map(function(f){return (f.title||'').replace(/\|/g,'/');}).join('; ')+(fs.length>3?'; …':'')+' | '+teamFor(area)+' | '+windowFor(sorted[0].severity)+' |');
  });
  md.push('\n---\nGenerated by '+(meta.productName||'Azure Scout')+' '+(meta.productVersion||'')+' — data collected read-only via Azure Resource Graph + ARM.');
  return md.join('\n');
}
function buildJsonExport(){
  return JSON.stringify({
    meta: meta, identity: identity,
    summary: { checks: counts.total, met: counts.pass, notMet: counts.fail, highSeverity: counts.high, manual: counts.manual },
    subscriptions: subscriptions,
    assessments: assessments.map(function(a){
      return { slug:a.slug, name:a.name, framework:a.framework, score:a.score, areas: dedupeAreas(a.areas),
        findings: safeArr(a.findings).map(function(f){ var c={}; for(var k in f) c[k]=f[k]; c.learnUrl = betterLearnUrl(f); return c; }) };
    }),
    inventory: (function(){ var o={}; invEntries.forEach(function(p){ o[p[0]] = { label:p[1].label, count:p[1].count }; }); return o; })(),
    drift: drift
  }, null, 1);
}
function csvQuote(v){ return '"'+String(v===null||v===undefined?'':v).replace(/"/g,'""')+'"'; }
function csvFindingsRows(rows){
  var cols = ['id','title','assessment','area','severity','status','weight','remediation','learnUrl','evidenceCount'];
  var lines = [cols.join(',')];
  rows.forEach(function(f){
    lines.push(cols.map(function(c){ return csvQuote(c==='id'?shortId(f.id):c==='learnUrl'?betterLearnUrl(f):f[c]); }).join(','));
  });
  return lines.join('\r\n');
}
function buildCsvFindings(){ return csvFindingsRows(allFindings); }
// Scoped to whichever assessment is currently open (state.section==='a-<slug>'), so the
// export menu's "Findings CSV" downloads just that register when a reader is deep in one
// assessment — mirrors the old per-assessment CSV filter, adapted to the v6 page model.
function buildCsvFindingsForCurrentAssessment(){
  var cols = ['id','title','assessment','area','severity','status','weight','remediation','learnUrl','evidenceCount'];
  var page = document.body.getAttribute('data-page') || '';
  if(page.indexOf('a-')!==0) return null;
  var rows = allFindings.filter(function(f){ return ('a-'+f.slug)===page; });
  if(!rows.length) return null;
  var lines = [cols.join(',')];
  rows.forEach(function(f){
    lines.push(cols.map(function(c){ return csvQuote(c==='id'?shortId(f.id):c==='learnUrl'?betterLearnUrl(f):f[c]); }).join(','));
  });
  return lines.join('\r\n');
}
function buildCsvEvidence(){
  var lines = [['FindingId','ResourceName','ResourceId','SubscriptionId','Detail'].join(',')];
  namedEvidence.forEach(function(e){
    lines.push([shortId(e.fid), e.resourceName, e.resourceId, e.subscriptionId, e.detail].map(csvQuote).join(','));
  });
  return lines.join('\r\n');
}

function initAbout(){
  var body = document.getElementById('about-body');
  var rows = [['Product', meta.productName], ['Version', meta.productVersion], ['Reference', meta.productUrl]];
  body.innerHTML = rows.filter(function(r){return r[1];}).map(function(r){
    return '<dt>'+esc(r[0])+'</dt><dd>'+(r[0]==='Reference' ? '<a href="'+esc(r[1])+'" target="_blank" rel="noopener">'+esc(r[1])+'</a>' : esc(r[1]))+'</dd>';
  }).join('');
  document.getElementById('about-toggle').onclick = function(){ document.getElementById('about-overlay').classList.add('open'); };
  document.getElementById('about-close').onclick = function(){ document.getElementById('about-overlay').classList.remove('open'); };
  document.getElementById('about-overlay').onclick = function(e){ if(e.target.id==='about-overlay') e.currentTarget.classList.remove('open'); };
}

function wireInteractions(){
  document.querySelectorAll('.nav').forEach(function(b){ b.addEventListener('click', function(){ setPage(b.getAttribute('data-page')); }); });

  document.querySelectorAll('.vbtn').forEach(function(b){
    b.addEventListener('click', function(){
      var v = b.getAttribute('data-view');
      document.body.setAttribute('data-view', v);
      document.querySelectorAll('.vbtn').forEach(function(x){ x.classList.toggle('on', x===b); });
      if(v==='data') document.querySelectorAll('details').forEach(function(d){ d.open = true; });
    });
  });

  document.querySelectorAll('.invgo').forEach(function(a){
    a.addEventListener('click', function(ev){ ev.preventDefault(); invSelect(a.getAttribute('data-pane')); });
  });

  document.querySelectorAll('a.goto').forEach(function(a){
    a.addEventListener('click', function(ev){
      ev.preventDefault();
      setPage(a.getAttribute('data-gopage'));
      var hash = a.getAttribute('href');
      if(hash && hash!=='#top'){
        var p = hash.slice(1);
        if(document.getElementById('pane-'+p)){ invSelect(p); return; }
        var el = document.querySelector(hash);
        if(el){
          var d = el.closest('details'); if(d) d.open = true;
          if(el.tagName==='DETAILS') el.open = true;
          el.scrollIntoView({ block:'start' });
        }
      }
    });
  });

  document.querySelectorAll('a[href^="#"]:not(.goto)').forEach(function(a){
    a.addEventListener('click', function(){
      var el = document.querySelector(a.getAttribute('href'));
      if(el){ var d = el.closest('details'); if(d) d.open = true; if(el.tagName==='DETAILS') el.open = true; }
    });
  });

  document.querySelectorAll('.dgmgo').forEach(function(a){
    a.addEventListener('click', function(ev){ ev.preventDefault(); dgmSelect(a.getAttribute('data-dpane')); });
  });

  document.querySelectorAll('.diag-node').forEach(function(g){
    g.addEventListener('click', function(){
      var pane = g.getAttribute('data-gopane'), page = g.getAttribute('data-gopage');
      if(pane){ setPage('inv'); invSelect(pane); }
      else if(page){ setPage(page); }
    });
  });

  document.querySelectorAll('.dgmfull').forEach(function(b){
    b.addEventListener('click', function(){
      var src = document.getElementById(b.getAttribute('data-dgm')).querySelector('svg');
      var ov = document.createElement('div'); ov.className = 'dgoverlay';
      ov.innerHTML = '<div class="bar"><button class="btn" data-z="in">＋ Zoom</button><button class="btn" data-z="out">－ Zoom</button><button class="btn" data-z="fit">Fit</button>'+
        '<span class="m" style="color:var(--faint);font-size:11.5px">wheel = zoom · drag = pan · Esc = close</span><button class="btn" data-z="x" style="margin-left:auto">✕ Close</button></div><div class="stage"></div>';
      var stage = ov.querySelector('.stage'); var svg = src.cloneNode(true); stage.appendChild(svg);
      document.body.appendChild(ov);
      var sc=1, tx=0, ty=0;
      function apply(){ svg.style.transform = 'translate('+tx+'px,'+ty+'px) scale('+sc+')'; }
      function fit(){ sc = Math.min(stage.clientWidth/svg.viewBox.baseVal.width, stage.clientHeight/svg.viewBox.baseVal.height)*0.95; tx=10; ty=10; svg.setAttribute('width', svg.viewBox.baseVal.width); svg.removeAttribute('height'); apply(); }
      fit();
      ov.querySelector('.bar').addEventListener('click', function(e){
        var z = e.target.getAttribute && e.target.getAttribute('data-z');
        if(z==='in') sc*=1.25; else if(z==='out') sc/=1.25; else if(z==='fit') return fit(); else if(z==='x') return ov.remove();
        apply();
      });
      stage.addEventListener('wheel', function(e){ e.preventDefault(); sc *= e.deltaY<0 ? 1.15 : 0.87; apply(); }, { passive:false });
      var drag = null;
      stage.addEventListener('mousedown', function(e){ drag = [e.clientX-tx, e.clientY-ty]; stage.style.cursor='grabbing'; });
      window.addEventListener('mousemove', function(e){ if(drag){ tx=e.clientX-drag[0]; ty=e.clientY-drag[1]; apply(); } });
      window.addEventListener('mouseup', function(){ drag=null; stage.style.cursor='grab'; });
      function escKey(e){ if(e.key==='Escape'){ ov.remove(); window.removeEventListener('keydown', escKey); } }
      window.addEventListener('keydown', escKey);
    });
  });

  document.querySelectorAll('.catwrap').forEach(function(w){
    var input = w.querySelector('.tfilter'), table = w.querySelector('table');
    if(!table) return;
    if(input) input.addEventListener('input', function(){
      var q = input.value.toLowerCase();
      [].slice.call(table.rows).slice(1).forEach(function(tr){ tr.style.display = tr.textContent.toLowerCase().indexOf(q)>=0 ? '' : 'none'; });
    });
    [].slice.call(table.rows[0].cells).forEach(function(th, ci){
      th.style.cursor='pointer'; th.title='Click to sort';
      th.addEventListener('click', function(){
        var rows = [].slice.call(table.rows).slice(1);
        var dir = th.getAttribute('data-dir')==='asc' ? -1 : 1;
        [].slice.call(table.rows[0].cells).forEach(function(x){ x.removeAttribute('data-dir'); });
        th.setAttribute('data-dir', dir===1 ? 'asc' : 'desc');
        rows.sort(function(a,b){
          var x = (a.cells[ci]||{}).textContent||'', y = (b.cells[ci]||{}).textContent||'';
          var nx = parseFloat(x.replace(/,/g,'')), ny = parseFloat(y.replace(/,/g,''));
          if(!isNaN(nx) && !isNaN(ny)) return (nx-ny)*dir;
          return x.localeCompare(y)*dir;
        });
        rows.forEach(function(r){ r.parentNode.appendChild(r); });
      });
    });
  });

  var tb = document.getElementById('themebtn');
  tb.addEventListener('click', function(){
    var r = document.documentElement;
    var cur = r.getAttribute('data-theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    var next = cur==='dark' ? 'light' : 'dark';
    r.setAttribute('data-theme', next);
    tb.textContent = next==='dark' ? '◐ Theme: dark' : '◑ Theme: light';
    try{ localStorage.setItem('scout-report-theme', next); }catch(e){}
  });

  var eb = document.getElementById('exportbtn'), em = document.getElementById('exportmenu');
  eb.addEventListener('click', function(ev){ ev.stopPropagation(); em.classList.toggle('open'); });
  document.addEventListener('click', function(){ em.classList.remove('open'); });
  em.addEventListener('click', function(ev){
    var x = ev.target.getAttribute && ev.target.getAttribute('data-x');
    if(!x) return;
    em.classList.remove('open');
    if(x==='md') dl(filenamePrefix()+'.md', buildMarkdownExport(), 'text/markdown');
    else if(x==='json') dl(filenamePrefix()+'.json', buildJsonExport(), 'application/json');
    else if(x==='csv-findings') dl('findings.csv', buildCsvFindingsForCurrentAssessment() || buildCsvFindings());
    else if(x==='csv-evidence') dl('evidence.csv', buildCsvEvidence());
    else if(x==='print') window.print();
    else if(x==='html') dl(filenamePrefix()+'.html', '<!doctype html>'+document.documentElement.outerHTML, 'text/html');
  });
}
function filenamePrefix(){
  var parts = [identity.clientName, identity.reportTitle].filter(Boolean).join(' - ') || 'azure-scout-report';
  return parts.replace(/[\\/:*?"<>|]/g, '-').trim();
}

function loadPersistedTheme(){
  try{
    var t = localStorage.getItem('scout-report-theme');
    if(t){ document.documentElement.setAttribute('data-theme', t); var tb = document.getElementById('themebtn'); if(tb) tb.textContent = t==='dark' ? '◐ Theme: dark' : '◑ Theme: light'; }
  }catch(e){}
}
function initialView(){
  var m = meta.defaultMode;
  return m==='executive' ? 'exec' : m==='data' ? 'data' : 'cons';
}

function boot(){
  assemble();
  var v = initialView();
  document.body.setAttribute('data-view', v);
  document.querySelectorAll('.vbtn').forEach(function(b){ b.classList.toggle('on', b.getAttribute('data-view')===v); });
  initAbout();
  wireInteractions();
  loadPersistedTheme();
}
if(document.readyState === 'loading'){
  document.addEventListener('DOMContentLoaded', boot);
} else {
  boot();
}

/* exposed for the Node-based diagram overlap checker test (tests/) */
window.__SCOUT_DIAGRAM_KERNEL__ = {
  measureText: measureText, wrapText: wrapText, autoSizeBox: autoSizeBox,
  routeOrthogonal: routeOrthogonal, layoutTree: layoutTree, placeRingLabels: placeRingLabels,
  diagramNetworkTopology: diagramNetworkTopology, diagramMgHierarchy: diagramMgHierarchy,
  diagVnetTopology: diagVnetTopology, diagHybrid: diagHybrid, diagPrivateLink: diagPrivateLink, diagExposure: diagExposure
};
})();
</script>
