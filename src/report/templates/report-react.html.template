    var rs = byNsg[nsg];
    out += '<path d="M 20 '+(y+30)+' H 130" stroke="var(--band-crit)" stroke-width="2" fill="none"/>'+
      '<g class="diag-node" data-gopane="'+catId('networking.nsgPublicInbound')+'">'+
