    return (sevRank.hasOwnProperty(a.severity)?sevRank[a.severity]:3)-(sevRank.hasOwnProperty(b.severity)?sevRank[b.severity]:3) || ((b.weight||0)-(a.weight||0));
  });
  var prio = {}; failsRanked.forEach(function(f,i){ prio[f.id]=i+1; });
  var rowCap = 60;
  var rows = allFindings.map(function(f,i){
    return '<tr'+(i>=rowCap?' class="depth-data"':'')+'><td class="mono">'+esc(shortId(f.id))+'</td><td><a href="'+esc(betterLearnUrl(f))+'" rel="noopener">'+esc(f.title)+'</a></td><td>'+esc(f.assessment)+'</td><td>'+esc(f.area)+'</td><td>'+sevPill(f.severity)+'</td><td>'+statusPill(f.status)+'</td><td class="num">'+(prio[f.id]!=null?prio[f.id]:'—')+'</td><td class="num">'+(f.evidenceCount||0)+'</td><td><input class="noteb" placeholder="Add a note…"></td></tr>';
  }).join('');
  var evRows = namedEvidence.map(function(e,i){
    return '<tr'+(i>=rowCap?' class="depth-data"':'')+'><td class="mono">'+esc(shortId(e.fid))+'</td><td class="mono">'+esc(e.resourceName)+'</td><td class="mono">'+esc(subName(e.subscriptionId))+'</td><td>'+esc(e.detail||'')+'</td></tr>';
  }).join('');
  var d = drift || {};
  var dsum = d.Summary || {};
  var dRows = safeArr(d.Findings).filter(function(f){ return f.Drift && f.Drift!=='Unchanged'; }).map(function(f){
    var col = f.Drift==='Regressed' ? 'var(--fail)' : f.Drift==='Resolved' ? 'var(--band-exc)' : 'var(--ink)';
    return '<tr><td class="mono">'+esc(f.Id)+'</td><td>'+esc(f.Title)+'</td><td>'+esc(f.Area)+'</td><td>'+statusPill(f.PreviousStatus)+'</td><td>'+statusPill(f.CurrentStatus)+'</td><td><b style="color:'+col+'">'+esc(f.Drift)+'</b></td></tr>';
  }).join('');
  var execTop = failsRanked.slice(0,10).map(function(f){
    return '<tr><td>'+esc(f.title)+'</td><td>'+esc(f.assessment)+'</td><td>'+sevPill(f.severity)+'</td><td class="num">'+(f.evidenceCount||0)+'</td></tr>';
  }).join('');
  return '<div class="depth-exec"><h2>Data &amp; drift — executive summary</h2>'+
    '<div class="kpis"><div class="kpi bad"><div class="l">Regressed</div><div class="v">'+(dsum.Regressed||0)+'</div></div>'+
    '<div class="kpi good"><div class="l">Resolved</div><div class="v">'+(dsum.Resolved||0)+'</div></div>'+
    '<div class="kpi"><div class="l">New</div><div class="v">'+(dsum.New||0)+'</div></div>'+
    '<div class="kpi"><div class="l">Unchanged</div><div class="v">'+(dsum.Unchanged||0)+'</div></div></div>'+
    '<div class="eyebrow">Top '+Math.min(10,failsRanked.length)+' priority gaps of '+counts.fail+'</div>'+
    '<div class="twrap"><table><tr><th>Check</th><th>Assessment</th><th>Severity</th><th class="num">Evidence</th></tr>'+execTop+'</table></div>'+
    '<p class="lede small">Switch to Consultant for the full findings and evidence register, or Data for every row plus drift.</p></div>'+
    '<div class="depth-cons"><h2>Data &amp; drift</h2>'+
    '<details class="sect" open><summary><span class="part">All '+counts.total+' findings</span><span class="hint">every check · Priority ranks the '+counts.fail+' gaps · check titles link to their specific Microsoft guidance</span></summary>'+
    '<div class="twrap"><table><tr><th>Id</th><th>Check</th><th>Assessment</th><th>Area</th><th>Severity</th><th>Result</th><th class="num">Priority</th><th class="num">Evidence</th><th>Notes</th></tr>'+rows+'</table></div>'+
    (allFindings.length>rowCap?'<div class="capnote">Showing '+rowCap+' of '+allFindings.length+' by default — switch to the Data view for every row.</div>':'')+'</details>'+
    '<details class="sect" open><summary><span class="part">Evidence — every named resource ('+namedEvidence.length+' rows)</span></summary>'+
    '<div class="twrap"><table><tr><th>Check</th><th>Resource</th><th>Subscription</th><th>Observed</th></tr>'+evRows+'</table></div>'+
    (namedEvidence.length>rowCap?'<div class="capnote">Showing '+rowCap+' of '+namedEvidence.length+' by default — switch to the Data view for every row.</div>':'')+'</details>'+
    '<details class="sect" open><summary><span class="part">Drift since previous run</span><span class="hint">'+esc(d.PreviousRunId||'')+' → '+esc(d.RunId||'')+', score '+(d.PreviousScore!=null?d.PreviousScore:'—')+' → '+(d.OverallScore!=null?d.OverallScore:'—')+'</span></summary>'+
    '<div class="kpis"><div class="kpi bad"><div class="l">Regressed</div><div class="v">'+(dsum.Regressed||0)+'</div></div>'+
    '<div class="kpi good"><div class="l">Resolved</div><div class="v">'+(dsum.Resolved||0)+'</div></div>'+
    '<div class="kpi"><div class="l">New</div><div class="v">'+(dsum.New||0)+'</div></div>'+
    '<div class="kpi"><div class="l">Unchanged</div><div class="v">'+(dsum.Unchanged||0)+'</div></div></div>'+
    (dRows ? '<div class="twrap"><table><tr><th>Check</th><th>Title</th><th>Area</th><th>Was</th><th>Now</th><th>Drift</th></tr>'+dRows+'</table></div>' : '<p class="lede small">No checks changed state between the two runs.</p>')+'</details>'+
    '<div class="prov">Data provenance: Azure Resource Graph + ARM, read-only · run '+esc(meta.runId||'')+' generated '+esc((meta.generatedOn||'').slice(0,16).replace('T',' '))+' · Azure Scout '+esc(meta.productVersion||'')+'.</div></div>';
}

