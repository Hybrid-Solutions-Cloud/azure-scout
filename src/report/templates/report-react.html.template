function diagPrivateLink(){
  var pes = safeArr((inventory['networking.privateEndpoints']||{}).rows);
  var dns = safeArr((inventory['networking.privateDnsZones']||{}).rows);
  if(!pes.length) return '';
  var zoneSet = {}; dns.forEach(function(z){ zoneSet[String(z.name).toLowerCase()] = 1; });
  var FAM = [
    ['storage','storageaccounts','Storage accounts',['privatelink.blob.core.windows.net','privatelink.file.core.windows.net','privatelink.queue.core.windows.net','privatelink.table.core.windows.net','privatelink.dfs.core.windows.net','privatelink.web.core.windows.net']],
    ['keyvault','vaults','Key Vault',['privatelink.vaultcore.azure.net']],
    ['datafactory','factories','Data Factory',['privatelink.datafactory.azure.net','privatelink.adf.azure.com']],
    ['web','sites','App Service',['privatelink.azurewebsites.net']],
    ['sql','servers','SQL Database',['privatelink.database.windows.net']],
    ['machinelearningservices','workspaces','Azure Machine Learning',['privatelink.api.azureml.ms','privatelink.notebooks.azure.net']],
    ['containerregistry','registries','Container Registry',['privatelink.azurecr.io']],
    ['databricks','workspaces','Azure Databricks',['privatelink.azuredatabricks.net']],
    ['synapse','workspaces','Synapse Analytics',['privatelink.sql.azuresynapse.net']],
    ['eventhub','namespaces','Event Hubs',['privatelink.servicebus.windows.net']],
    ['deviceupdate','accounts','Device Update for IoT Hub',['privatelink.api.adu.microsoft.com']],
    ['devices','iothubs','IoT Hub',['privatelink.azure-devices.net']],
    ['desktopvirtualization','hostpools','AVD host pools',['privatelink.wvd.microsoft.com']],
    ['compute','diskaccesses','Disk Access',['privatelink.blob.core.windows.net']],
    ['botservice','botservices','Bot Service',['privatelink.directline.botframework.com']],
    ['eventgrid','topics','Event Grid',['privatelink.eventgrid.azure.net']],
    ['iotcentral','iotapps','IoT Central',['privatelink.azureiotcentral.com']],
    ['web','staticsites','Static Web Apps',['privatelink.azurestaticapps.net']],
    ['dbforpostgresql','flexibleservers','PostgreSQL Flexible Server',['privatelink.postgres.database.azure.com']]
  ];
  var counts = {}, other = 0;
  pes.forEach(function(p){
    var prov = String(p.targetProvider||'').toLowerCase().replace('microsoft.',''), typ = String(p.targetType||'').toLowerCase();
    var fam = FAM.filter(function(f){ return f[0]===prov && f[1]===typ; })[0];
    if(fam) counts[fam[2]] = (counts[fam[2]]||0)+1; else other++;
  });
  var rows = FAM.filter(function(f){ return counts[f[2]]; }).map(function(f){
    var zs = f[3], present = zs.filter(function(z){ return zoneSet[z]; }).length;
    return { label:f[2], count:counts[f[2]], zones:zs, present:present };
  }).sort(function(a,b){ return b.count-a.count; });
  if(other) rows.push({ label:'Other services', count:other, zones:[], present:0 });
  var maxC = rows[0].count;

  var W = 1200, y = 46, rowH = 30, out = '';
  out += '<text x="14" y="24" fill="var(--faint)" font-size="10" font-weight="800" letter-spacing="1.5">'+pes.length+' PRIVATE ENDPOINTS BY TARGET SERVICE · DNS ZONE COVERAGE</text>';
  var barX = 300, barMax = 560, chipX = 900;
  rows.forEach(function(r){
    var bw = Math.max(3, barMax*r.count/maxC);
    out += '<g class="diag-node" data-gopane="'+catId('networking.privateEndpoints')+'"><title>'+esc(r.label)+' — '+r.count+' private endpoint'+(r.count===1?'':'s')+'</title>'+
      '<text x="'+(barX-14)+'" y="'+(y+14)+'" text-anchor="end" fill="var(--ink)" font-size="10.5">'+esc(r.label)+'</text>'+
      '<rect x="'+barX+'" y="'+(y+3)+'" width="'+bw+'" height="15" rx="3" fill="var(--primary)" opacity="0.85"/>'+
      '<text x="'+(barX+bw+8)+'" y="'+(y+14)+'" fill="var(--muted)" font-size="10" font-weight="650">'+r.count+'</text></g>';
    if(r.zones.length){
      var ok = r.present===r.zones.length, none = r.present===0;
      var ctext = ok ? (r.zones.length>1 ? r.present+'/'+r.zones.length+' DNS zones' : 'DNS zone present') : none ? 'DNS zone missing' : r.present+'/'+r.zones.length+' DNS zones';
      var ccol = ok ? 'var(--band-exc)' : none ? 'var(--band-crit)' : 'var(--band-mod)';
      out += '<g><title>'+esc(r.zones.join(', '))+'</title><rect x="'+chipX+'" y="'+(y+2)+'" width="128" height="17" rx="8.5" fill="color-mix(in srgb,'+ccol+' 12%,transparent)"/>'+
        '<text x="'+(chipX+64)+'" y="'+(y+14)+'" text-anchor="middle" fill="'+ccol+'" font-size="8.5" font-weight="700">'+(ok?'✓ ':'')+esc(ctext)+'</text></g>';
    }
    y += rowH;
  });

  y += 18;
  var uniq = dns.map(function(z){ return z.name; }).filter(function(v,i,a){ return a.indexOf(v)===i; }).sort();
  out += '<text x="14" y="'+y+'" fill="var(--faint)" font-size="10" font-weight="800" letter-spacing="1.5">PRIVATE DNS ZONES ('+uniq.length+')</text>';
  y += 10;
  uniq.forEach(function(z, i){
    var x = 14 + (i%3)*394, yy = y + Math.floor(i/3)*25;
    out += '<g class="diag-node" data-gopane="'+catId('networking.privateDnsZones')+'"><rect x="'+x+'" y="'+yy+'" width="382" height="20" rx="4" fill="var(--surface)" stroke="var(--border)"/>'+
      '<text x="'+(x+9)+'" y="'+(yy+14)+'" fill="var(--ink)" font-size="9.5" class="mono">'+esc(z)+'</text></g>';
  });
  y += Math.ceil(uniq.length/3)*25 + 14;

  var missing = rows.filter(function(r){ return r.zones.length && r.present<r.zones.length; });
  return svgWrap('plink', 'Private Link — endpoint coverage and DNS resolution',
    pes.length+' private endpoints aggregated by the service they front, with the private DNS zone coverage each service family needs'+
    (missing.length ? '. <b>'+esc(missing.map(function(m){ return m.label; }).join(', '))+'</b> '+(missing.length===1?'has':'have')+' endpoints without a matching privatelink DNS zone — private resolution for those endpoints should be verified.' : '. Every service family with endpoints has its privatelink DNS zones in place.')+
    ' The full endpoint-by-endpoint register is in the Data view and the Networking inventory.',
    out, W, y);
}

function diagExposure(){
  var rules = safeArr((inventory['networking.nsgPublicInbound']||{}).rows);
  if(!rules.length) return '';
  function rank(r){
    var p = String(r.port||'');
    if(p==='*'||/AllowAll/i.test(r.rule||'')) return 0;
    if(p==='3389') return 1;
    if(p==='22') return 2;
    if(p==='443') return 4;
    return 3;
  }
  var byNsg = {}, order = [];
  rules.forEach(function(r){ if(!byNsg[r.nsg]){ byNsg[r.nsg]=[]; order.push(r.nsg); } byNsg[r.nsg].push(r); });
  var groups = order.map(function(nsgName){
    var rs = byNsg[nsgName].slice().sort(function(a,b){ return rank(a)-rank(b); });
    return { nsg:nsgName, rs:rs, sev:Math.min.apply(null, rs.map(rank)) };
  }).sort(function(a,b){ return a.sev-b.sev || b.rs.length-a.rs.length; });
  var crit = groups.filter(function(g){ return g.sev<=2; }), rest = groups.filter(function(g){ return g.sev>2; });

  var W = 1200, out = '', y = 16;
  out += '<defs><marker id="arw2" markerWidth="8" markerHeight="8" refX="7" refY="3" orient="auto"><path d="M0,0 L7,3 L0,6 z" fill="var(--band-crit)"/></marker></defs>';
  out += '<text x="24" y="'+(y+12)+'" fill="var(--band-crit)" font-weight="800" font-size="12" letter-spacing="2">INTERNET</text>';
  var spineTop = y+20; y += 34;

  function section(title, gs, color){
    if(!gs.length) return;
    out += '<text x="60" y="'+(y+12)+'" fill="'+color+'" font-size="10" font-weight="800" letter-spacing="1.5">'+esc(title)+'</text>';
    y += 22;
    gs.forEach(function(g){
      var chipY = 0, chipX0 = 470, cx2 = chipX0, rows2 = 1;
      var chips = g.rs.map(function(r){
        var t = ':'+r.port+' · '+String(r.rule||'');
        var wc = tcChipW(t, 9);
        if(cx2 + wc > 1150){ cx2 = chipX0; rows2++; }
        var pos2 = { x:cx2, row:rows2, t:t, sev:rank(r) };
        cx2 += wc + 12; pos2.w = wc;
        return pos2;
      });
      var cardH = 26 + rows2*22 + 6;
      out += '<path d="M 30 '+(y+cardH/2)+' H 52" stroke="'+color+'" stroke-width="2" fill="none" marker-end="url(#arw2)"/>'+
        '<g class="diag-node" data-gopane="'+catId('networking.nsgPublicInbound')+'"><title>'+esc(g.nsg)+' — '+g.rs.length+' internet-inbound rule'+(g.rs.length===1?'':'s')+'</title>'+
        '<rect x="56" y="'+y+'" width="1124" height="'+cardH+'" rx="8" fill="var(--surface)" stroke="'+color+'" stroke-width="1.4"/>'+
        '<text x="72" y="'+(y+19)+'" fill="var(--ink)" font-weight="700" font-size="11">'+esc(g.nsg)+'</text>'+
        '<text x="'+(chipX0-8)+'" y="'+(y+19)+'" fill="var(--faint)" font-size="9" text-anchor="end"> </text>'+
        '<text x="72" y="'+(y+19+16)+'" fill="var(--faint)" font-size="9">'+esc(g.rs[0].resourceGroup)+'</text>';
      chips.forEach(function(c){
        var cy2 = y + 8 + (c.row-1)*22;
        var col = c.sev<=2 ? 'var(--band-crit)' : c.sev===4 ? 'var(--band-mod)' : 'var(--band-mod)';
        out += '<rect x="'+c.x+'" y="'+cy2+'" width="'+c.w+'" height="18" rx="9" fill="color-mix(in srgb,'+col+' 13%,transparent)"/>'+
          '<text x="'+(c.x+c.w/2)+'" y="'+(cy2+13)+'" text-anchor="middle" fill="'+col+'" font-size="9" font-weight="650" class="mono">'+esc(c.t)+'</text>';
      });
      out += '</g>';
      y += cardH + 12;
    });
    y += 8;
  }
  section('CRITICAL — ALLOW-ALL AND MANAGEMENT PORTS ('+crit.length+' NSGS)', crit, 'var(--band-crit)');
  section('REVIEW — HTTPS AND SCOPED SERVICES ('+rest.length+' NSGS)', rest, 'var(--band-mod)');
  out += '<path d="M 30 '+spineTop+' V '+(y-24)+'" stroke="var(--band-crit)" stroke-width="2.4" stroke-dasharray="6 4" fill="none"/>';

  return svgWrap('exposure', 'Internet exposure — inbound paths from outside',
    rules.length+' NSG rules across '+groups.length+' network security groups permit inbound traffic from the internet, ordered worst-first: allow-all and management ports (RDP 3389, SSH 22) before scoped HTTPS. The collect records the rule and port; the subnet or NIC each NSG protects is in the Networking inventory. Every one of these should be intentional — this is the estate\'s front door.',
    out, W, y+4);
}

function diagEdgeDelivery(){
  var fds  = safeArr((inventory['networking.frontDoors']||{}).rows);
  var tms  = safeArr((inventory['networking.trafficManagerProfiles']||{}).rows);
  var agws = safeArr((inventory['networking.applicationGateways']||{}).rows);
  var lbs  = safeArr((inventory['networking.loadBalancers']||{}).rows);
  var nats = safeArr((inventory['networking.natGateways']||{}).rows);
  var bas  = safeArr((inventory['networking.bastionHosts']||{}).rows);
  var plur = function(nv,s){ return nv+' '+s+(nv===1?'':'s'); };
  var tiers = [
    { key:'networking.frontDoors', label:'FRONT DOOR', rows:fds,
      sub:function(r){ return (r.sku||'classic')+' · '+(r.enabledState||r.provisioningState||'state n/a')+' · '+plur(r.endpointCount||0,'endpoint'); },
      warn:function(){ return null; }, flag:function(){ return null; } },
    { key:'networking.trafficManagerProfiles', label:'TRAFFIC MANAGER', rows:tms,
      sub:function(r){ return (r.trafficRoutingMethod||'method n/a')+' · '+(r.profileStatus||'')+' · '+plur(r.endpointCount||0,'endpoint'); },
      warn:function(r){ return String(r.monitorStatus||'')==='Degraded' ? '⚠ probe degraded' : null; }, flag:function(){ return null; } },
    { key:'networking.applicationGateways', label:'APPLICATION GATEWAYS', rows:agws,
      sub:function(r){ return (r.tier||r.sku||'sku n/a')+' · '+plur(r.listenerCount||0,'listener')+' · '+plur(r.backendPoolCount||0,'pool'); },
      warn:function(r){ return r.wafEnabled ? null : '⚠ no WAF in front of internet traffic'; }, flag:function(r){ return r.wafEnabled ? 'WAF on' : null; } },
    { key:'networking.loadBalancers', label:'LOAD BALANCERS', rows:lbs,
      sub:function(r){ return (r.sku||'sku n/a')+' · '+tcRegionLoc(r.location)+' · '+plur(r.frontendIpCount||0,'frontend')+' · '+plur(r.backendPoolCount||0,'pool'); },
      warn:function(){ return null; }, flag:function(r){ return r.hasPublicFrontend ? 'public frontend — internet entry point' : 'internal only'; },
      flagColor:function(r){ return r.hasPublicFrontend ? 'var(--band-crit)' : 'var(--band-exc)'; } },
    { key:'networking.natGateways', label:'NAT GATEWAYS — OUTBOUND ONLY', rows:nats,
      sub:function(r){ return tcRegionLoc(r.location)+' · '+plur(r.publicIpCount||0,'public IP')+' · '+plur(r.subnetCount||0,'subnet')+(r.idleTimeoutInMinutes?' · idle timeout '+r.idleTimeoutInMinutes+' min':''); },
      warn:function(){ return null; }, flag:function(){ return null; } },
    { key:'networking.bastionHosts', label:'BASTION HOSTS — ADMIN ACCESS', rows:bas,
      sub:function(r){ return (r.sku||'sku n/a')+' · '+tcRegionLoc(r.location)+(r.vnet?' · '+tcDisp(r.vnet):''); },
      warn:function(r){ return String(r.sku||'')==='Basic' ? '⚠ Basic SKU — no session recording, no scaling' : null; }, flag:function(r){ return String(r.sku||'')==='Basic' ? null : (r.sku||null); } }
  ].filter(function(t){ return t.rows.length; });
  if(!tiers.length) return '';

  var W = 1200, cardW = 360, cardH = 54, perRow = 3, gapX = 16, gapY = 10, x0 = 48;
  var out = '<text x="20" y="26" fill="var(--band-crit)" font-weight="800" font-size="12" letter-spacing="2">INTERNET</text>';
  var y = 48;
  tiers.forEach(function(t){
    out += '<path d="M 24 '+(y+4)+' H 40" stroke="var(--band-crit)" stroke-width="2" fill="none"/>'+
      '<text x="'+x0+'" y="'+(y+8)+'" fill="var(--faint)" font-size="10" font-weight="800" letter-spacing="1.5">'+t.label+' ('+t.rows.length+')</text>';
    y += 18;
    t.rows.forEach(function(r, i){
      var col = i % perRow, row = Math.floor(i / perRow);
      var cx0 = x0 + col*(cardW+gapX), cy0 = y + row*(cardH+gapY);
      var wn = t.warn(r), fl = t.flag ? t.flag(r) : null;
      var fcol = t.flagColor ? t.flagColor(r) : 'var(--accent)';
      var nm = tcDisp(String(r.name||''));
      if(nm !== String(r.name||'')) nm = nm + ' · ' + String(r.name).slice(0,8);
      out += '<g class="diag-node" data-gopane="'+catId(t.key)+'"><title>'+esc(r.name)+' · '+esc(r.resourceGroup||'')+'</title>'+
        '<rect x="'+cx0+'" y="'+cy0+'" width="'+cardW+'" height="'+cardH+'" rx="7" fill="var(--surface)" stroke="'+(wn?'var(--band-mod)':'var(--border)')+'" stroke-width="1.4"/>'+
        '<text x="'+(cx0+12)+'" y="'+(cy0+17)+'" fill="var(--ink)" font-weight="650" font-size="10.5">'+esc(tcTrunc(nm,44))+'</text>'+
        '<text x="'+(cx0+12)+'" y="'+(cy0+31)+'" fill="var(--muted)" font-size="9">'+esc(tcTrunc(t.sub(r),58))+'</text>'+
        (wn ? '<text x="'+(cx0+12)+'" y="'+(cy0+46)+'" fill="var(--band-mod)" font-weight="700" font-size="9">'+esc(wn)+'</text>'
            : (fl ? '<text x="'+(cx0+12)+'" y="'+(cy0+46)+'" fill="'+fcol+'" font-weight="650" font-size="9">'+esc(fl)+'</text>' : ''))+
        '</g>';
    });
    y += Math.ceil(t.rows.length / perRow)*(cardH+gapY) + 12;
  });
  out = '<path d="M 24 32 V '+(y-24)+'" stroke="var(--band-crit)" stroke-width="2.4" stroke-dasharray="6 4" fill="none"/>' + out;

  var total = tiers.reduce(function(a,t){ return a+t.rows.length; }, 0);
