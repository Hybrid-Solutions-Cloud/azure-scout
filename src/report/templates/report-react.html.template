function setPage(p){
  document.body.setAttribute('data-page', p);
  var navKey = p.indexOf('a-')===0 ? 'as' : p;
  document.querySelectorAll('.nav').forEach(function(x){ x.classList.toggle('on', x.getAttribute('data-page')===navKey); });
  document.querySelectorAll('.pg[data-assessment-page]').forEach(function(x){ x.classList.toggle('on', x.getAttribute('data-assessment-page')===p); });
  window.scrollTo(0,0);
}
function invSelect(p){
  document.querySelectorAll('.invpane').forEach(function(x){ x.classList.toggle('on', x.id==='pane-'+p); });
  document.querySelectorAll('.sideitem').forEach(function(x){ x.classList.toggle('on', x.getAttribute('data-pane')===p); });
}
function dgmSelect(p){
  document.querySelectorAll('.dgmpane').forEach(function(x){ x.classList.toggle('on', x.id==='pane-'+p); });
  document.querySelectorAll('.dgmgo').forEach(function(x){ x.classList.toggle('on', x.getAttribute('data-dpane')===p); });
}
function showExportWarning(msg){
  var el = document.getElementById('export-warning');
  el.textContent = msg; el.style.display = 'block';
  setTimeout(function(){ el.style.display='none'; }, 6000);
}
function dl(name, text, type){
  try{
    var b = new Blob([text], { type: type||'text/csv' });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(b); a.download = name;
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(function(){ URL.revokeObjectURL(a.href); }, 4000);
  }catch(e){
    showExportWarning('This document is embedded in a sandbox that blocks file downloads. Open the report in a full browser tab to export.');
  }
}

/* ---- exports built at runtime from the live payload (the mockup builds these once at
   Node build time; here they must be rebuilt in-browser since the payload is only known
   client-side). Content/shape mirrors the mockup's MD_EXPORT/JSON_EXPORT/CSV_* literals. */
function buildMarkdownExport(){
  var md = [];
  md.push('# '+(identity.reportTitle||'Azure Inventory and Assessment'));
  md.push('\n'+(identity.clientName||'')+' · '+(identity.classification||'')+' · run '+(meta.runId||'')+' · generated '+(meta.generatedOn||'').slice(0,16).replace('T',' '));
  md.push('\n**'+counts.total+' CAF/WAF checks evaluated** — '+counts.pass+' met, '+counts.partial+' partially met, '+counts.fail+' not met ('+counts.high+' high severity), '+counts.manual+' manual, '+counts.notAssessed+' not assessed, '+counts.unknown+' unknown, '+counts.error+' errors. Estate: '+n(invTotal)+' items across '+subscriptions.length+' subscriptions.');
  assessments.forEach(function(a){
    var s = a.score || {};
    md.push('\n## '+a.name);
    md.push('\n'+(a.framework||''));
    if(s.percent!=null) md.push('\nScore: **'+s.percent+' / 100** — '+(s.formula||''));
    dedupeAreas(a.areas).forEach(function(ar){
      var st = areaStats(a, ar);
      if(!st.findings.length) return;
      md.push('\n### '+ar.name+(ar.percent!=null?' — '+ar.percent+' / 100':' — manual only'));
      md.push('\n| Check | Title | Severity | Result | Evidence |\n|---|---|---|---|---|');
      st.findings.forEach(function(f){ md.push('| '+shortId(f.id)+' | '+(f.title||'').replace(/\|/g,'/')+' | '+f.severity+' | '+statusLabel(f.status)+' | '+(f.evidenceCount||0)+' |'); });
      st.findings.filter(function(f){return f.status==='Fail';}).forEach(function(f){
        md.push('\n#### ✗ '+f.title+' ('+shortId(f.id)+', '+f.severity+')');
        var ev = safeArr(f.evidence).filter(function(e){return e.resourceName;});
        md.push(ev.length ? '\nAffected: '+ev.map(function(e){return '`'+e.resourceName+'`';}).join(', ') : '\nNothing in scope satisfies this check — the gap is the absence itself.');
        md.push('\n**Fix:** '+f.remediation);
        md.push('\n[Microsoft guidance]('+betterLearnUrl(f)+')');
      });
      var ms = st.findings.filter(function(f){return f.status!=='Pass' && f.status!=='Fail';});
      if(ms.length){ md.push('\n**Review and availability agenda:**'); ms.forEach(function(f){ md.push('- **'+statusLabel(f.status)+'** — '+f.title+' — '+f.remediation); }); }
    });
  });
  md.push('\n## Remediation plan\n\n| Domain | Gaps | Owner | Window |\n|---|---|---|---|');
  var groups = {}, order = [];
  allFindings.filter(function(f){return f.status==='Fail';}).forEach(function(f){ if(!groups[f.area]){groups[f.area]=[];order.push(f.area);} groups[f.area].push(f); });
  order.forEach(function(area){
    var fs = groups[area];
    var sorted = fs.slice().sort(function(x,y){ return (sevRank.hasOwnProperty(x.severity)?sevRank[x.severity]:3)-(sevRank.hasOwnProperty(y.severity)?sevRank[y.severity]:3); });
    md.push('| '+area+' | '+fs.length+': '+fs.slice(0,3).map(function(f){return (f.title||'').replace(/\|/g,'/');}).join('; ')+(fs.length>3?'; …':'')+' | '+teamFor(area)+' | '+windowFor(sorted[0].severity)+' |');
  });
  md.push('\n---\nGenerated by '+(meta.productName||'Azure Scout')+' '+(meta.productVersion||'')+' — data collected read-only via Azure Resource Graph + ARM.');
  return md.join('\n');
}
function buildJsonExport(){
  return JSON.stringify({
    meta: meta, identity: identity,
    summary: { checks: counts.total, met: counts.pass, partiallyMet: counts.partial, notMet: counts.fail, highSeverity: counts.high, manual: counts.manual, unknown: counts.unknown, errors: counts.error, notAssessed: counts.notAssessed },
    subscriptions: subscriptions,
    assessments: assessments.map(function(a){
      return { slug:a.slug, name:a.name, framework:a.framework, score:a.score, areas: dedupeAreas(a.areas),
        findings: safeArr(a.findings).map(function(f){ var c={}; for(var k in f) c[k]=f[k]; c.learnUrl = betterLearnUrl(f); return c; }) };
    }),
    inventory: inventory,
    discovery: discovery,
    drift: drift
  }, null, 1);
}
function buildCsvInventory(k){
  var rows=safeArr((inventory[k]||{}).rows), cols=[];
  rows.forEach(function(r){Object.keys(r).forEach(function(c){if(cols.indexOf(c)<0)cols.push(c);});});
  return [cols.map(csvQuote).join(',')].concat(rows.map(function(r){return cols.map(function(c){var v=r[c];return csvQuote(v && typeof v==='object'?JSON.stringify(v):v);}).join(',');})).join('\r\n');
}
function csvQuote(v){
  var s = String(v===null||v===undefined?'':v);
  if(/^[\t\r\n ]*[=+\-@]/.test(s)) s="'"+s;
  return '"'+s.replace(/"/g,'""')+'"';
}
function csvFindingsRows(rows){
  var cols = ['id','title','assessment','area','severity','status','weight','remediation','learnUrl','evidenceCount'];
  var lines = [cols.join(',')];
  rows.forEach(function(f){
    lines.push(cols.map(function(c){ return csvQuote(c==='id'?shortId(f.id):c==='learnUrl'?betterLearnUrl(f):f[c]); }).join(','));
  });
  return lines.join('\r\n');
}
function buildCsvFindings(){ return csvFindingsRows(allFindings); }
// Scoped to whichever assessment is currently open (state.section==='a-<slug>'), so the
// export menu's "Findings CSV" downloads just that register when a reader is deep in one
// assessment — mirrors the old per-assessment CSV filter, adapted to the v6 page model.
function buildCsvFindingsForCurrentAssessment(){
  var cols = ['id','title','assessment','area','severity','status','weight','remediation','learnUrl','evidenceCount'];
  var page = document.body.getAttribute('data-page') || '';
  if(page.indexOf('a-')!==0) return null;
  var rows = allFindings.filter(function(f){ return ('a-'+f.slug)===page; });
  if(!rows.length) return null;
  var lines = [cols.join(',')];
  rows.forEach(function(f){
    lines.push(cols.map(function(c){ return csvQuote(c==='id'?shortId(f.id):c==='learnUrl'?betterLearnUrl(f):f[c]); }).join(','));
  });
  return lines.join('\r\n');
}
function buildCsvEvidence(){
  var lines = [['FindingId','ResourceName','ResourceId','SubscriptionId','Detail'].join(',')];
  namedEvidence.forEach(function(e){
    lines.push([shortId(e.fid), e.resourceName, e.resourceId, e.subscriptionId, e.detail].map(csvQuote).join(','));
  });
  return lines.join('\r\n');
}

